bin/
obj/
*.user
/artifacts/

# Nyko's Bioshock1REMSDK, kept alongside as an independent reverse-engineering reference. It is
# someone else's project under its own licence, and 137 MB of it, so it is read here and not vendored.
/Bioshock1REMSDK-WIP--main/
/Bioshock1REMSDK-WIP--main.zip

# The Havok 2012.2.0-r1 SDK. It settled the first-person animation blocker — see
# docs/research/havok-compression.md — and it must never be committed: its own headers say
# "Confidential Information of Havok. Not for disclosure or distribution without Havok's prior
# written consent." Read in place, quoted in the notes, never vendored.
/hk2012_2_0_r1/

# UEViewer and UELib sources, kept as references for the Unreal side. Someone else's projects under
# their own licences.
/UModel-master/
/Unreal-Library-master/

# Downloaded FMOD helper binaries are used locally to interrogate the game's streamed-audio banks.
# They are not part of this project's source or redistribution set.
/tools/fmod-x86/

# Interpreter caches are local build by-products.
__pycache__/
*.py[cod]

# IDE / editor local state. Project settings that are worth sharing can be un-ignored explicitly.
.vs/
.vscode/
.idea/
*.suo
*.userprefs
*.DotSettings.user

# Test and tooling run output. Never the tests themselves, and never research evidence.
TestResults/
*.trx
*.coverage
*.binlog
coverage*.xml

# Local-agent orchestration run state (.agent-control/agent.ps1). The scripts and config are the
# infrastructure and stay tracked; per-dispatch task/result/log files and the GPU lock are transient
# and machine-specific. Promote anything worth keeping into .agent/reports/ by hand.
/.agent-control/tasks/
/.agent-control/results/
/.agent-control/logs/
/.agent-control/.gpu.lock

# Aider local session state, if the tool is used against this repo. The project config is the
# infrastructure and stays tracked, same convention as .agent-control/ above.
.aider*
!.aider.conf.yml

# tools/backup-agent's own run logs are machine-specific and transient; the task queue and wrapper
# script are the infrastructure and stay tracked.
/tools/backup-agent/logs/
