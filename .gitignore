bin/
obj/
*.user
/artifacts/

# Third-party reference projects, consolidated under external/ (28 Sept cleanup — previously loose
# at the repo root). Each is someone else's project under its own licence, read in place and cited
# in comments/docs, never vendored into this repo.
#
# external/Bioshock1REMSDK-WIP--main/ — Nyko's independent reverse-engineering reference (~137 MB).
# external/hk2012_2_0_r1/ — the Havok 2012.2.0-r1 SDK. Settled the first-person animation blocker,
#   see docs/research/havok-compression.md. Its own headers say "Confidential Information of Havok.
#   Not for disclosure or distribution without Havok's prior written consent" — never committed.
# external/UModel-master/ and external/Unreal-Library-master/ — UEViewer and UELib sources, kept as
#   references for the Unreal side. tools/uelib-bridge's csproj compiles Unreal-Library-master's
#   source directly against this repo's own target framework.
/external/

# tools/fmod-x86/ holds this project's own x86 FMOD bridge (FmodFsbDecoder.cpp + README) -- tracked.
# Only its build output is ignored. The source used to be ignored with the whole folder and was lost
# with the 1 Oct 2026 repo deletion; it was rebuilt from Codex's patch log (2 Oct 2026).
/tools/fmod-x86/*.exe
/tools/fmod-x86/*.obj
/tools/fmod-x86/*.wav

# Interpreter caches are local build by-products.
__pycache__/
*.py[cod]

# IDE / editor local state. Project settings that are worth sharing can be un-ignored explicitly.
.vs/
.vscode/
.idea/
*.suo
*.userprefs
*.DotSettings.user

# Test and tooling run output. Never the tests themselves, and never research evidence.
TestResults/
*.trx
*.coverage
*.binlog
coverage*.xml

# Local-agent orchestration run state (.agent-control/agent.ps1). The scripts and config are the
# infrastructure and stay tracked; per-dispatch task/result/log files and the GPU lock are transient
# and machine-specific. Promote anything worth keeping into .agent/reports/ by hand.
/.agent-control/tasks/
/.agent-control/results/
/.agent-control/logs/
/.agent-control/.gpu.lock

# Aider local session state, if the tool is used against this repo. The project config is the
# infrastructure and stays tracked, same convention as .agent-control/ above.
.aider*
!.aider.conf.yml

# tools/backup-agent's own run logs and lock file are machine-specific and transient; the task
# queue and wrapper script are the infrastructure and stay tracked. task-*.done markers ARE
# tracked deliberately -- they record which queued tasks have already been reviewed and committed,
# which matters across machines/sessions, not just on this one.
/tools/backup-agent/logs/
/tools/backup-agent/.run.lock

# tools/agents parallel worker orchestration: scripts, README and the tasks/ queue (incl. *.done
# markers) are tracked infrastructure; per-dispatch logs, patches and verify output under runs/ are
# transient and machine-specific, and the GPU lock is a runtime artefact. Agent worktrees live
# OUTSIDE the repo (../BioShockHavok-agent-*) so they need no rule here.
/tools/agents/runs/
/tools/agents/.local.lock

# UE5 Python audit/repair reports and PIE/editor screenshots — local evidence, not source.
/tools/ue5/_reports/
/tools/ue5/_shots/
tools/ue5/BioShockRuntime/Config/
native/dxgi_proxy/bin/
