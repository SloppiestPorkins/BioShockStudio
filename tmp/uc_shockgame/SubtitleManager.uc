class SubtitleManager extends SubtitleManagerBase
	native
	config(Subtitles);

struct native atomic Subtitle
{
	var localized string Text;
	var localized string Speaker;
	var name Name;
};

struct native atomic BinkMovieSubtitle
{
	var float StartTime;
	var float EndTime;
	var string Text;
	var int Location;
};

var private transient ShockGameDriver GameDriver;
var config localized array<localized Subtitle> Subtitles;
var array<BinkMovieSubtitle> BinkMovieSubtitles;
var int CurrentBinkSubtitleIndex;
var noexport TMap_Padding SubtitleMap;

function Construct(ShockGameDriver GameDriver)
{
	//native.GameDriver;	
	@NULL
}

function ShowSubtitle(name SubtitleName, string Speaker, name SubtitleType, float Duration)
{
	//native.SubtitleName;
	//native.Speaker;
	//native.SubtitleType;
	//native.Duration;	
	@NULL
	@NULL
	return default.@NULL;
}

function LoadBinkMovieSubtitles(string BinkFilename)
{
	//native.BinkFilename;	
	@NULL
}

defaultproperties
{
	Subtitles[0]=(Text="This was our home!",Speaker="Female Splicer",Name="vo_S_1_La_OurHome")
	Subtitles[1]=(Text="When mom and dad put me on that plane to visit my cousins in England, they told me, 'Son, you're special. You were born to do great things.' You know what? They were right.",Speaker="",Name="vo_S_1_Pl_PlayerIntro")
	Subtitles[2]=(Text="Stewardess: Excuse me sir, excuse me... Excuse me sir, your tray table, would you kindly-",Speaker="",Name="vo_S_1_Wd_TrayTable")
	Subtitles[3]=(Text="Captain: Ladies and gentlemen, this is Captain Cal Franklin, it seems we have a bit of a problem...",Speaker="",Name="vo_S_1_Wd_TrayTable")
	Subtitles[4]=(Text="Captain: We're losing altitude really fast... looks like oversped number one and three... there's smoke coming out of the panel and... I got it...PULL UP!!! PULL UP!!! I got it...PULL UP!!!",Speaker="",Name="vo_S_1_Wd_TrayTable")
	Subtitles[5]=(Text="I am Andrew Ryan and I'm here to ask you a question: Is a man not entitled to the sweat of his brow? No, says the man in Washington. It belongs to the poor. No, says the man in the Vatican. It belongs",Speaker="Andrew Ryan",Name="vo_S_1_Ry_BathySpeech")
	Subtitles[6]=(Text="to God. No, says the man in Moscow. It belongs to everyone. I rejected those answers. Instead, I chose something different. I chose the impossible. I chose... Rapture. A city where the artist would not",Speaker="Andrew Ryan",Name="vo_S_1_Ry_BathySpeech")
	Subtitles[7]=(Text="fear the censor. Where the scientist would not be bound by petty morality. Where the great would not be constrained by the small. And with the sweat of your brow, Rapture can become your city as well.",Speaker="Andrew Ryan",Name="vo_S_1_Ry_BathySpeech")
	Subtitles[8]=(Text="Atlas: ...but the lighthouse is all lit up like hellfire...looks like some kind of plane crash...",Speaker="",Name="vo_S_1_At_BathyConvoA")
	Subtitles[9]=(Text="Johnny: ...we're in the middle of the Atlantic Ocean... How could it-",Speaker="",Name="vo_S_1_At_BathyConvoA")
	Subtitles[10]=(Text="Atlas: ...Dunno, you best get over there, and be quick about it...The splicers are coming...",Speaker="",Name="vo_S_1_At_BathyConvoA")
	Subtitles[11]=(Text="Johnny: You've gotta be kidding- How do you know someone's even coming?",Speaker="",Name="vo_S_1_At_BathyConvoA")
	Subtitles[12]=(Text="Atlas: 'Cause we got a bathysphere on its way down... That means we've got company.",Speaker="",Name="vo_S_1_At_BathyConvoA")
	Subtitles[13]=(Text="Johnny: O-okay, just one more minute...The 'sphere- the 'sphere is coming up now...",Speaker="",Name="vo_S_1_Jy_BathyConvoB")
	Subtitles[14]=(Text="Atlas: Johnny, security's banging off all over...get a move on!",Speaker="",Name="vo_S_1_Jy_BathyConvoB")
	Subtitles[15]=(Text="Johnny: Please, lady... I didn't mean no trespass. Just don't hurt me...",Speaker="",Name="vo_S_1_Jy_PleaseMister")
	Subtitles[16]=(Text="Splicer - Female: (humming If I Didn't Care by the Inkspots)",Speaker="",Name="vo_S_1_Jy_Xxx")
	Subtitles[17]=(Text="Johnny: Just let me go...you can keep my gun. You can--",Speaker="",Name="vo_S_1_Jy_PleaseMister")
	Subtitles[18]=(Text="Johnny: (scream) (death gurgle)",Speaker="",Name="vo_S_1_Jy_PleaseMister")
	Subtitles[19]=(Text="Splicer - Female: (Breathing heavy)",Speaker="",Name="vo_S_1_Jy_PleaseMister")
	Subtitles[20]=(Text="Splicer - Female: Is it someone new?",Speaker="",Name="vo_S_1_Jy_PleaseMister")
	Subtitles[21]=(Text="Splicer - Female: (shriek of rage)",Speaker="",Name="vo_S_1_Jy_PleaseMister")
	Subtitles[22]=(Text="Splicer - Female: (climbing up side of sphere)",Speaker="",Name="vo_S_1_Jy_Xxx")
	Subtitles[23]=(Text="Splicer - Female: (sounds of exertion)",Speaker="",Name="vo_S_1_Jy_PleaseMister")
	Subtitles[24]=(Text="Splicer - Female: (shout of frustration)",Speaker="",Name="vo_S_1_Jy_PleaseMister")
	Subtitles[25]=(Text="Johnny! Johnny! No!",Speaker="Atlas",Name="vo_S_1_At_Johnny")
	Subtitles[26]=(Text="Would you kindly pick up that shortwave radio?",Speaker="Atlas",Name="vo_S_1_At_PickUpRadioTwo")
	Subtitles[27]=(Text="Grab that shortwave now. That splicer's out there, still.",Speaker="Atlas",Name="vo_S_1_At_BuckUp")
	Subtitles[28]=(Text="I don't know how you survived that plane crash, but I've never been one to question Providence. I'm Atlas, and I aim to keep you alive. Now keep on moving...we're gonna have to get you to higher ground.",Speaker="Atlas",Name="vo_R_1_At_PickUpRadio")
	Subtitles[29]=(Text="Take a deep breath and step out of the bathysphere. I won't leave you twisting in the wind.",Speaker="Atlas",Name="vo_R_1_At_LeaveSphere")
	Subtitles[30]=(Text="We're gonna need to draw her out of hiding. But you're gonna have to trust me.",Speaker="Atlas",Name="vo_R_1_At_KeepMoving")
	Subtitles[31]=(Text="I'll wrap you in a sheet...",Speaker="Female Splicer",Name="vo_S_1_Lf_WrapYou")
	Subtitles[32]=(Text="Just a bit further... how do you like that, sister?",Speaker="Atlas",Name="vo_R_1_At_SmileCamera")
	Subtitles[33]=(Text="Now would you kindly find a crowbar or something? Bloody splicers sealed Johnny in before they...goddamn splicers.",Speaker="Atlas",Name="vo_R_1_At_FindWeapon")
	Subtitles[34]=(Text="That'll turn a bolt or crack a skull. Not much else to do down here anymore. Jesus wept.",Speaker="Atlas",Name="vo_R_1_At_GotWrench")
	Subtitles[35]=(Text="The lady with the hooks and that flying machine must seem right out of some fairy tale. You'll get used to things to like that down here soon enough.",Speaker="Atlas",Name="vo_R_1_At_DoorLockBusted")
	Subtitles[36]=(Text="Imagine if you could be smarter, stronger, healthier. What if you could even have amazing powers, light fires with your mind...That's what Plasmids do for a man.",Speaker="Atlas",Name="vo_R_1_At_HesGotPlasmids")
	Subtitles[37]=(Text="Steady now! Your genetic code is being rewritten- just hold on and everything will be fine!",Speaker="Atlas",Name="vo_R_1_At_InstalledGeneticMod")
	Subtitles[38]=(Text="Splicer One: This little fish looks like he just had his cherry POPPED ...wonder if he's still got some Adam on him?",Speaker="",Name="vo_S_1_Lm_PoorDear")
	Subtitles[39]=(Text="Splicer Two: You hear that? Let's bug!",Speaker="",Name="vo_S_1_Lm_PoorDear")
	Subtitles[40]=(Text="Splicer One: Weak! You're a weak chopper!",Speaker="",Name="vo_S_1_Lm_PoorDear")
	Subtitles[41]=(Text="Splicer Two: This little fish ain't worth toeing it with no Big Daddy!",Speaker="",Name="vo_S_1_Lm_PoorDear")
	Subtitles[42]=(Text="Splicer - Male: Yellow! Always have been! You'll be no better off with the metal daddy, little fish. See you floating in the briney...",Speaker="",Name="vo_S_1_Lm_PoorDear")
	Subtitles[43]=(Text="Look Mr. Bubbles, it's an angel- I can see light coming from his belly... Wait a minute, he's still breathing. It's alright, I know he'll be an angel soon.",Speaker="Little Sister",Name="vo_S_1_Ga_LookAngel")
	Subtitles[44]=(Text="Gatherer: I can see light coming from his belly... Wait a minute, he's still breathing. It's alright, I know he'll be an angel soon.",Speaker="",Name="vo_S_1_Ga_Xxx")
	Subtitles[45]=(Text="You all right, boyo? First time plasmid's a real kick from a mule. But...there's nothing like a fistful of lightning, now, is there?",Speaker="Atlas",Name="vo_R_1_At_UseBolt")
	Subtitles[46]=(Text="Looks like you've run out of Eve, the juice that powers all your plasmids. I'll send you some backup in the pneumo tube.",Speaker="Atlas",Name="vo_R_1_At_OutOfEve")
	Subtitles[47]=(Text="You all tapped out again? All right, sending you some more Eve in the penumo.",Speaker="Atlas",Name="vo_R_1_At_OutOfEveAgain")
	Subtitles[48]=(Text="Splicer! Give 'em the combo- zap 'em then whack 'em. One-two punch! Remember, the one-two punch!",Speaker="Atlas",Name="vo_R_1_At_ElectroBoltWater")
	Subtitles[49]=(Text="Trouble ahead. Ryan's boys.",Speaker="Atlas",Name="vo_R_1_At_Trouble")
	Subtitles[50]=(Text="Tell Ryan I'm sorry, I won't do it again---no, please please, don't do that, the whole thing will go, no!",Speaker="Male Splicer",Name="vo_S_1_Eg_WontChange")
	Subtitles[51]=(Text="(burning screams)",Speaker="Male Splicer",Name="vo_S_1_Eg_BurningA")
	Subtitles[52]=(Text="(burning screams)",Speaker="Male Splicer",Name="vo_S_1_Eg_BurningB")
	Subtitles[53]=(Text="Hold on now...I'll see if I can do something to keep your head above water!",Speaker="Atlas",Name="vo_R_1_At_HigherGround")
	Subtitles[54]=(Text="Listen- I've got a family. I need to get them out of here. But the splicers have cut me off from them- If you can reach them in Neptune's Bounty, then maybe, just maybe- I know",Speaker="Atlas",Name="vo_R_1_At_WelcomeTwo")
	Subtitles[55]=(Text="you must feel like the unluckiest man in the world right now, but you're the only hope I'll ever see my wife and child again. Go to Neptune's Bounty... find my family... please.",Speaker="Atlas",Name="vo_R_1_At_WelcomeTwo")
	Subtitles[56]=(Text="When your daddy's in the ground, mommy's gonna sell you by the pound. When your mommy's up and gone, you're gonna be the lonely one. When you are the lonely one, no one will be there to sing this song. Hush now...Mommy's",Speaker="Female Splicer",Name="vo_S_1_Bc_Lullaby")
	Subtitles[57]=(Text="gone...and daddy too. Wait...this is happening before and not...why aren't you here? W-why is it today and not then when you were warm and sweet? Why can't mommy hold you to her breast and feel your teeth? Oh no, no no no no ...",Speaker="Female Splicer",Name="vo_S_1_Bc_Lullaby")
	Subtitles[58]=(Text="Plasmids changed everything. They destroyed our bodies, our minds. We couldn't handle it. Best friends butchering one another, babies strangled in cribs. The whole city went to hell.",Speaker="Atlas",Name="vo_R_1_At_TheKilling")
	Subtitles[59]=(Text="You've really done it this time, Brenda! I'm not some kind of sap!",Speaker="Charley",Name="vo_S_1_Ch_DoneIt")
	Subtitles[60]=(Text="I'll do what I want! It's my ADAM! I earned it!",Speaker="Brenda",Name="vo_S_1_Br_MyMoney")
	Subtitles[61]=(Text="You want this ugly? Or you want this nice? I can do it either way! OPEN THE DAMN DOOR!",Speaker="Charley",Name="vo_S_1_Ch_OpenDoor")
	Subtitles[62]=(Text="You open up!",Speaker="Charley",Name="vo_S_1_Ch_OpenUp")
	Subtitles[63]=(Text="Brenda!",Speaker="Charley",Name="vo_S_1_Ch_Brenda")
	Subtitles[64]=(Text="Brenda!",Speaker="Charley",Name="vo_S_1_Ch_Brenda2a")
	Subtitles[65]=(Text="Last time, I warns ya!",Speaker="Charley",Name="vo_S_1_Ch_LastTime")
	Subtitles[66]=(Text="What's the big idea, Charley?!",Speaker="Brenda",Name="vo_S_1_Br_BigIdea")
	Subtitles[67]=(Text="Charley?",Speaker="Brenda",Name="vo_S_1_Br_Charley")
	Subtitles[68]=(Text="Charley? Where you gone?",Speaker="Brenda",Name="vo_S_1_Br_WhereYouGone")
	Subtitles[69]=(Text="Hey, Brenda- You care to tell me why you've had a hole in the wall the size of Plymouth Rock coming out of your crapper going on three weeks now? Now, I ain't saying I'm Shakespeare, but I'm",Speaker="Steve Barker",Name="vo_L_1_Sb_BathroomWall")
	Subtitles[70]=(Text="trying to run a respectable theater. I got working folk coming in from Port Neptune trying to catch a little diversion...and all they can think about is the stink coming out your shitter. Get it fixed.",Speaker="Steve Barker",Name="vo_L_1_Sb_BathroomWall")
	Subtitles[71]=(Text="If you spot a splicer in the water, hit 'em with the Electro Bolt.",Speaker="Atlas",Name="vo_R_1_At_ShockWater")
	Subtitles[72]=(Text="You're gonna fit in just fine down here.",Speaker="Atlas",Name="vo_R_1_At_FitIn")
	Subtitles[73]=(Text="Another New Year's, another night alone. I'm out, and you're stuck in Hephaestus, working. Imagine my surprise. I guess I'll have another drink...here's a toast to Diane",Speaker="Diane McClintock",Name="vo_L_1_Cf_WishUWereHere")
	Subtitles[74]=(Text="McClintock, silliest girl in Rapture. Silly enough to fall in love with Andrew Ryan, silly enough to- What...what happened...I'm bleeding...oh, god...what's happening....",Speaker="Diane McClintock",Name="vo_L_1_Cf_WishUWereHere")
	Subtitles[75]=(Text="Careful now...would you kindly lower that weapon for a minute?",Speaker="Atlas",Name="vo_R_1_At_LowerWeapon")
	Subtitles[76]=(Text="You think that's a child down there? Don't be fooled. She's a Little Sister now. Somebody went and turned a sweet baby girl into a monster. Whatever you thought about right and wrong on the",Speaker="Atlas",Name="vo_R_1_At_LittleSisters")
	Subtitles[77]=(Text="surface, well that don't count for much down in Rapture. Those Little Sisters, they carry Adam- the genetic material that keeps the wheels of Rapture turning. Everybody wants it. Everybody needs it.",Speaker="Atlas",Name="vo_R_1_At_LittleSisters")
	Subtitles[78]=(Text="You remember what I said about right and wrong?",Speaker="Atlas",Name="vo_R_1_At_RuleBook")
	Subtitles[79]=(Text="There's nothing you can do for that Little Sister. But there's one who can.",Speaker="Atlas",Name="vo_R_1_At_GetGathererAdam")
	Subtitles[80]=(Text="That's the Big Daddy. She gathers Adam, he keeps her safe.",Speaker="Atlas",Name="vo_R_1_At_LockGone")
	Subtitles[81]=(Text="Hold on now. You stay away from that Big Daddy. You hear me? You're no match for him. You don't bother him, and he won't bother you.",Speaker="Atlas",Name="vo_R_1_At_KillBouncer")
	Subtitles[82]=(Text="But you're going to need the Adam the Sisters are carrying. More Adam, more plasmids. You think that old Electro Bolt is something? You ain't seen nothing yet.",Speaker="Atlas",Name="vo_R_1_At_FightBouncer")
	Subtitles[83]=(Text="Me wife, Moira- she's a right pain in the neck. But she's a beauty and she means the world to me. I can't help but feel God's",Speaker="Atlas",Name="vo_R_1_At_FindCover")
	Subtitles[84]=(Text="punishing me for bringing her and Patrick to this place. I thought this would be a better life for us. Can you imagine a bigger fool than that?",Speaker="Atlas",Name="vo_R_1_At_FindCover")
	Subtitles[85]=(Text="Security alert in progress.",Speaker="Announcer",Name="vo_S_1_Fa_QuarantineActiveF")
	Subtitles[86]=(Text="So tell me, friend...which one of the bitches sent you? The KGB wolf? Or the CIA jackal? Here's the news: Rapture isn't some sunken ship for you to",Speaker="Andrew Ryan",Name="vo_S_1_Ry_RyanTaunt")
	Subtitles[87]=(Text="plunder and Andrew Ryan isn't a giddy socialite who can be slapped around by government muscle. And with that, farewell, or Dasvadinya. Whichever you prefer.",Speaker="Andrew Ryan",Name="vo_S_1_Ry_RyanTaunt")
	Subtitles[88]=(Text="It's Ryan! Goddamn Andrew Ryan! He found us! Damnit! He's shut off access to Neptune...there's another way to get there...head to Medical! What are you waiting for? Go!",Speaker="Atlas",Name="vo_R_1_At_RyanIntro")
	Subtitles[89]=(Text="Use your Electro Bolt on those turrets!",Speaker="Atlas",Name="vo_R_1_At_BoltTurrets")
	Subtitles[90]=(Text="Ah, Christ! You're trapped...gonna try to override the exit from here!",Speaker="Atlas",Name="vo_R_1_At_MedDoorLocked")
	Subtitles[91]=(Text="I got it...get out of there...get out now!!!",Speaker="Atlas",Name="vo_R_1_At_MedDoorUnlocked")
	Subtitles[92]=(Text="Now you've met Andrew Ryan, the bloody King of Rapture. Now find your way to Emergency Access.",Speaker="Atlas",Name="vo_R_1_At_KeepALowProfile")
	Subtitles[93]=(Text="Security Alert is in progress. Access is limited for the time being. We appreciate your patience.",Speaker="Announcer",Name="vo_S_1_Fa_AccessLimited")
	Subtitles[94]=(Text="If you want to use the Emergency Access, you'll be needing Doctor Steinman's key. He's the one what runs this place. But I don't",Speaker="Atlas",Name="vo_R_1_At_SteinmanHasKey")
	Subtitles[95]=(Text="expect him to hand it to you out of the milk of human kindness. Steinman ain't that kind, and frankly, I'm not even sure he's still human.",Speaker="Atlas",Name="vo_R_1_At_SteinmanHasKey")
	Subtitles[96]=(Text="You're gonna have to hack this thing if you ever wanna see the inside of that Medical Pavilion.",Speaker="Atlas",Name="vo_R_1_At_HackThis")
	Subtitles[97]=(Text="Now you've rattled the monkey cage. Here they come.",Speaker="Atlas",Name="vo_R_1_At_HackWin")
	Subtitles[98]=(Text="You promised me pretty, Steinman, you promised me pretty...Now look at me...LOOK AT ME!!!",Speaker="Ghost Two",Name="vo_S_1_Gu_PromisedPretty")
	Subtitles[99]=(Text="Remember, all them machines will short out right and proper if you hit them with Electro Bolt!",Speaker="Atlas",Name="vo_R_1_At_ElectroBoltLesson")
	Subtitles[100]=(Text="Security cameras. I can hear the infernal things all around you. Ryan's eyes and ears.",Speaker="Atlas",Name="vo_R_1_At_SecurityCameraLesson")
	Subtitles[101]=(Text="All roads in Rapture lead to Ryan. The security, the splicers, the Big Daddies, the Little Sisters: he pumps some kind of chemical scent in the air, pheromones they call it, makes them all dance to his tune.",Speaker="Atlas",Name="vo_R_1_At_OutOfHere")
	Subtitles[102]=(Text="You keep an eye peeled for Steinman. The daft bastard's set up shop in the surgery wing. You wanna find him, just follow the blood.",Speaker="Atlas",Name="vo_R_1_At_SteinmanSurgery")
	Subtitles[103]=(Text="You'll have to find some way to get through to surgery...and Steinman. Chin up, now. The Lord hates a quitter.",Speaker="Atlas",Name="vo_R_1_At_GuyWithBombs")
	Subtitles[104]=(Text="I can hear that splicer sounding off like it's the 4th of July. Explosives are hard to come by down here, but if you get your hands on one of them",Speaker="Atlas",Name="vo_R_1_At_GrenadeCatchLesson")
	Subtitles[105]=(Text="telekinesis plasmids, you could catch the damn firebombs and toss it right back in his gob...or anything else that might be standing in your way.",Speaker="Atlas",Name="vo_R_1_At_GrenadeCatchLesson")
	Subtitles[106]=(Text="I can hear that splicer sounding off like it's the 4th of July. Explosives are hard to come by down here...if only you could get your hands on some of them bombs he's tossing... Things like that could help you turn the tables, or clear a path.",Speaker="Atlas",Name="vo_R_1_At_GrenadeCatchLessonB")
	Subtitles[107]=(Text="Look at him! Common!",Speaker="Female Splicer",Name="vo_S_1_La_LookCommon")
	Subtitles[108]=(Text="I can taste you...and it's disgusting!",Speaker="Female Splicer",Name="vo_S_1_La_TasteYou")
	Subtitles[109]=(Text="He's lean...I like that.",Speaker="Female Splicer",Name="vo_S_1_La_LikeLean")
	Subtitles[110]=(Text="Clean and scrub, wash and clean...",Speaker="Female Splicer",Name="vo_S_1_La_CleanScrub")
	Subtitles[111]=(Text="Yes, Dr. Steinman...no, Dr. Steinman, sorry Dr. Steinman",Speaker="Female Splicer",Name="vo_S_1_La_YesSteinman")
	Subtitles[112]=(Text="See what you did to me! See what you did!",Speaker="Female Splicer",Name="vo_S_1_La_SeeWhatYouDid")
	Subtitles[113]=(Text="Is it Steinman?",Speaker="Female Splicer",Name="vo_S_1_Bj_SteinmanA")
	Subtitles[114]=(Text="Is it Steinman?",Speaker="Female Splicer",Name="vo_S_1_Bj_SteinmanB")
	Subtitles[115]=(Text="No...but let's take it out on him anyway...",Speaker="Female Splicer",Name="vo_S_1_Bj_SteinmanC")
	Subtitles[116]=(Text="I'm too spliced up, too spliced up...now nobody's gonna want me...",Speaker="Ghost Two",Name="vo_S_1_Gu_TooSplicedUp")
	Subtitles[117]=(Text="With genetic modifications, beauty is no longer a goal, or even a virtue. It is a moral obligation. Do we force the healthy to",Speaker="Doctor Steinman",Name="vo_S_1_St_Obligation")
	Subtitles[118]=(Text="live with the contagious? Do we mix the criminal with the law-abiding? Then why are the plain allowed to mingle with the fair?",Speaker="Doctor Steinman",Name="vo_S_1_St_Obligation")
	Subtitles[119]=(Text="No, goddess, he'll ruin everything! Get him! Have your harpies tear him to bits!",Speaker="Doctor Steinman",Name="vo_S_1_St_SteinmanHarpies")
	Subtitles[120]=(Text="What can I do with this one, Aphrodite? She WON'T. STAY. STILL! I want to make them beautiful, but they always turn out wrong! That",Speaker="Doctor Steinman",Name="vo_S_1_St_UglyIntruder")
	Subtitles[121]=(Text="one...too fat! This one...too tall! This one...too symmetrical! And now- What's this, goddess? An intruder! He's ugly! Ugly ugly UGLY!",Speaker="Doctor Steinman",Name="vo_S_1_St_UglyIntruder")
	Subtitles[122]=(Text="You all right? It was time somebody took care of that sick bastard. Make sure you get the key off Steinman and head back to Emergency Access. I'm working my way to the back side of Port Neptune meself. We'll get there soon enough.",Speaker="Atlas",Name="vo_R_1_At_GotQuarKey")
	Subtitles[123]=(Text="It's a Little One... Here's your chance to get some Adam.",Speaker="Atlas",Name="vo_R_1_At_YourChance")
	Subtitles[124]=(Text="...it's just you, me, and all of the tasty Adam I can drink...",Speaker="Male Splicer",Name="vo_S_1_Fs_DaddyDown")
	Subtitles[125]=(Text="Tenenbaum: Stay away from her or it is you who will be shot next...",Speaker="",Name="vo_R_1_At_GathSaveSequence")
	Subtitles[126]=(Text="Atlas: Easy now, Doctor...He's just looking for a wee bit of Adam, just enough to get by...",Speaker="",Name="vo_R_1_At_GathSaveSequence")
	Subtitles[127]=(Text="Tenenbaum: I'll not have him hurt my Little Ones...",Speaker="",Name="vo_R_1_At_GathSaveSequence")
	Subtitles[128]=(Text="Atlas: It's okay, lad. That's not a child, not anymore it ain't. Dr. Tenenbaum saw to that.",Speaker="",Name="vo_R_1_At_GathSaveSequence")
	Subtitles[129]=(Text="(scream of terror)",Speaker="Little Sister",Name="vo_S_1_Ga_TerrorScream")
	Subtitles[130]=(Text="The path of the righteous is not always easy, yes? The reward will become clear in time ...be patient.",Speaker="Tenenbaum",Name="vo_R_1_Tn_RighteousPath")
	Subtitles[131]=(Text="Tenenbaum's playing you for a sap. Those things may look like wee little girls, but looks don't make it so. You'll need all the Adam you can get to survive.",Speaker="Atlas",Name="vo_R_1_At_SoftTouch")
	Subtitles[132]=(Text="How can you do this thing? To a child? But there are other Little Ones who have need of your help...will you be as cruel to them?",Speaker="Tenenbaum",Name="vo_R_1_Tn_KillGatherer")
	Subtitles[133]=(Text="That Adam should do the trick. You did the right thing. Just remember: them things aren't people no more. And it's Dr. Tenenbaum they've got to thank for it.",Speaker="Atlas",Name="vo_R_1_At_KilledGatherer")
	Subtitles[134]=(Text="If you cross paths with another of them Gatherer's Garden machines, make sure you pick up a new plasmid or two. That's if the price ain't too dear, of course...",Speaker="Atlas",Name="vo_R_1_At_AdamLesson")
	Subtitles[135]=(Text="A parasite wanders the halls. We rebuild our city, and the doubters send a fly to spoil our ointment. One thousand Adam to the man or woman who pins its wings.",Speaker="Andrew Ryan",Name="vo_PA_1_Ry_WandersHalls")
	Subtitles[136]=(Text="You're ready now...it's time to take on one of them Big Daddies. It won't be easy, but it's the only way to get to the Little Sisters...and the Adam they carry.",Speaker="Atlas",Name="vo_R_1_At_YoureReadyNow")
	Subtitles[137]=(Text="Are you almost back to Emergency Access? Come through as soon as you get there. You got Ryan's eye now. You won't hear him coming...but he'll be there before you know it.",Speaker="Atlas",Name="vo_R_1_At_Congrats")
	Subtitles[138]=(Text="Security alert deactivated. Thank you for your patience!",Speaker="Announcer",Name="vo_S_1_Fa_QuarDeactivatedF")
	Subtitles[139]=(Text="I don't know how you managed it, but you did. Come through to Port Neptune now. I'm looking forward to shaking your hand.",Speaker="Atlas",Name="vo_R_1_At_ComeToPortNeptune")
	Subtitles[140]=(Text="Ryan and Adam, Adam and Ryan...all those years of study, and was I ever truly a surgeon before I met them? How we plinked away with our scalpels and toy morality. Yes, we could lop a boil here, and shave down a beak there,",Speaker="Doctor Steinman",Name="vo_L_1_St_RantA")
	Subtitles[141]=(Text="but... but could we really change anything? No. But Adam gives us the means to do it. And Ryan frees us from the phony ethics that held us back. Change your look, change your sex, change your race. It's yours to change, nobody else's.",Speaker="Doctor Steinman",Name="vo_L_1_St_RantA")
	Subtitles[142]=(Text="Adam presents new problems for the professional. As your tools improve, so do your standards. There was a time, I was happy enough to take off a wart or two, or turn a real circus freak into something",Speaker="Doctor Steinman",Name="vo_L_1_St_RantB")
	Subtitles[143]=(Text="you can show in the daylight. But that was then, when we took what we got, but with Adam... the flesh becomes clay. What excuse do we have not to sculpt, and sculpt, and sculpt, until the job is done?",Speaker="Doctor Steinman",Name="vo_L_1_St_RantB")
	Subtitles[144]=(Text="I am beautiful, yes. Look at me, what could I do to make my features finer? With Adam and my scalpel, I have been transformed. But is there not something better? What if now it is not my skill that fails me... but my imagination?",Speaker="Doctor Steinman",Name="vo_L_1_St_RantC")
	Subtitles[145]=(Text="When Picasso became bored of painting people, he started representing them as cubes and other abstract forms. The world called him a genius! I've spent my entire surgical career creating",Speaker="Doctor Steinman",Name="vo_L_1_St_RantD")
	Subtitles[146]=(Text="the same tired shapes, over and over again: the upturned nose, the cleft chin, the ample bosom. Wouldn't it be wonderful if I could do with a knife what that old Spaniard did with a brush?",Speaker="Doctor Steinman",Name="vo_L_1_St_RantD")
	Subtitles[147]=(Text="Today I had lunch with the Goddess. 'Steinman,' she said... 'I'm here to free you from the tyranny of the commonplace. I'm here to show",Speaker="Doctor Steinman",Name="vo_L_1_St_Symmetry")
	Subtitles[148]=(Text="you a new kind of beauty.' I asked her, 'What do you mean, goddess?' 'Symmetry, dear Steinman. It's time we did something about symmetry...'",Speaker="Doctor Steinman",Name="vo_L_1_St_Symmetry")
	Subtitles[149]=(Text="Aphrodite is walking the halls - shimmering, like a scalpel... 'Steinman,' she calls, 'Steinman! I have what you're looking for! Just open your eyes!' And when I see her, she cuts me into a thousand beautiful pieces.",Speaker="Doctor Steinman",Name="vo_L_1_St_Aphrodite")
	Subtitles[150]=(Text="Steinman: Four-oh silk and ...done. Nurse: The nose looks terrific, Doctor Steinman ...Doctor? Steinman: You know, looking at it now...I didn't realize how much her face sags...Scalpel... Nurse: Excuse me? Steinman:",Speaker="Doctor Steinman",Name="vo_L_1_St_NotWhatSheWanted")
	Subtitles[151]=(Text="Scalpel! Nurse: Uh, doctor, she's not booked for a face lift... Steinman: Let's just come in here and... Nurse: Doctor... Stop cutting... Doctor, stop cutting... Get me the chief of surgery! Get me the chief of surgery NOW!!!",Speaker="Doctor Steinman",Name="vo_L_1_St_NotWhatSheWanted")
	Subtitles[152]=(Text="It has been brought to my attention that some citizens have discovered ways to...hack the vending machines. I should not need to remind each",Speaker="Andrew Ryan",Name="vo_L_1_Ry_Vandalism")
	Subtitles[153]=(Text="and every citizen of Rapture that free enterprise is the foundation upon which our society has been established. Parasites will be punished.",Speaker="Andrew Ryan",Name="vo_L_1_Ry_Vandalism")
	Subtitles[154]=(Text="On the surface, the Parasite expects the doctor to heal them for free, the farmer to feed them out of charity. How little they differ from the pervert, who prowls the streets, looking for a victim he can ravish for his grotesque amusement.",Speaker="Andrew Ryan",Name="vo_L_1_Ry_ProwlStreets")
	Subtitles[155]=(Text="Tenenbaum...sometimes I pity the little freak. Such a tiny imagination... Content to sit there with her tanks of Adam, tweaking and optimizing. I need to create... Adam is a canvas of genetic modification...but plasmids are the paint.",Speaker="Suchong",Name="vo_L_1_Sg_PityFreak")
	Subtitles[156]=(Text="Clinical Trial Lot 44 Dr. Suchong/Client Fontaine Futuristics. Subject is white male, one Roland Wallace. Can you hear me, Mr. Wallace? 'Yes sir, Mr.",Speaker="Suchong",Name="vo_L_1_Sg_ClinicalTrail")
	Subtitles[157]=(Text="Suchong, sir' Very well. Right, I'm introducing Lot 44 now...We've codenamed Lot 44 'Enrage' because of its tendency to... Nurse, hold him down...nurse! Nurse!!!",Speaker="Suchong",Name="vo_L_1_Sg_ClinicalTrail")
	Subtitles[158]=(Text="I was at German prison camp only of sixteen years old when I realize I have love for science. German doctor, he make experiment. Sometime, he make scientific error. I tell him of this error, and this make him angry.",Speaker="Tenenbaum",Name="vo_L_1_Tn_Properly")
	Subtitles[159]=(Text="But then he asks, 'how can a child know such a thing?' I tell him, 'Sometimes, I just know.' He screams at me, 'Then why tell me?' 'Well,' I said, 'if you're going to do such things, at least you should do them properly.'",Speaker="Tenenbaum",Name="vo_L_1_Tn_Properly")
	Subtitles[160]=(Text="At the German prison camp they put me to work on genetic experiments on other prisoners. They call me 'Das Wunderkind', the wonder child. Germans, all they can talk about is blue eyes, and shape of",Speaker="Tenenbaum",Name="vo_L_1_Tn_Wunderkind")
	Subtitles[161]=(Text="forehead. All I care about is why is this one born strong, and that one weak? This one smart, that one stupid? All that killing, you think the Germans could have been interested in something useful?",Speaker="Tenenbaum",Name="vo_L_1_Tn_Wunderkind")
	Subtitles[162]=(Text="Dr. Steinman said he'd release me today. Ryan didn't come to see me since the New Year's attack. Not once. But Dr. Steinman was very attentive. He told me that",Speaker="Diane McClintock",Name="vo_L_1_Cf_ReleasedToday")
	Subtitles[163]=(Text="once the scar tissue was gone, he was going to fix me right up. Make me prettier than any girl I've ever seen. He's sweet all right...and so interested in my case!",Speaker="Diane McClintock",Name="vo_L_1_Cf_ReleasedToday")
	Subtitles[164]=(Text="Steinman, I know Medical Pavilion is your manor, but you might want to cogitate on this: ocean water is colder than a witch's tit. You don't heat the pipes, the pipes freeze. Pipes freeze, pipes burst. Then Rapture leaks. Now,",Speaker="McDonagh",Name="vo_L_1_Md_FrozenPipes")
	Subtitles[165]=(Text="I realize you're a posh sort of geezer, and, frankly, I don't give a toss if you piss or go fishing. But once Rapture starts leaking, the old girl's never gonna stop. And then I'll be sure to tell Ryan he's got you to thank.",Speaker="McDonagh",Name="vo_L_1_Md_FrozenPipes")
	Subtitles[166]=(Text="Not only are those little girls veritable Adam factories, they're nearly indestructible. They regenerate any wounded flesh with stem versions of the dead cells. But their relationship with the",Speaker="Doctor Steinman",Name="vo_L_1_St_AdamFactories")
	Subtitles[167]=(Text="implanted slugs is symbiotic...if you harvest the slug, the host will die. 'So you see it's not like killing,' Tenenbaum said. 'It's more like removing a terminal patient from life support.'",Speaker="Doctor Steinman",Name="vo_L_1_St_AdamFactories")
	Subtitles[168]=(Text="Clinical Trial Lot 23 Dr. Suchong/Client Fontaine Futuristics. Work on telekinesis plasmid proceeding well. Lifting objects at distance present no problem. Moving objects through",Speaker="Suchong",Name="vo_L_1_Sg_TelekinesisProgress")
	Subtitles[169]=(Text="space, no problem. Cannot stop speeding bullet, but can catch and throw fast moving object. Problem not with plasmid. Problem with reaction time. ...Suchong just get new idea for plasmid.",Speaker="Suchong",Name="vo_L_1_Sg_TelekinesisProgress")
	Subtitles[170]=(Text="Christ, who do you think you are? Annie Oakley? I'm sending you a couple more rounds through the pneumo tube.",Speaker="Atlas",Name="vo_R_1_At_BackUpAmmo")
	Subtitles[171]=(Text="Now you've had the pleasure of Andrew Ryan's company. He's the one who built this place, and he's the one who run it into the ground. Nobody knows exactly what happened. Maybe he went mad. Maybe the",Speaker="Atlas",Name="vo_R_2_At_HiddenSubmarine")
	Subtitles[172]=(Text="power got to him. Maybe he just decided he didn't like people. Whichever way you slice it, good men died. Me family's in a submarine hidden in the foundation of Fontaine Fisheries. I'll meet you there.",Speaker="Atlas",Name="vo_R_2_At_HiddenSubmarine")
	Subtitles[173]=(Text="(humming Inkspots song 'If I didn't care')",Speaker="Female Splicer",Name="vo_S_2_Lf_InkHum")
	Subtitles[174]=(Text="What crawls in my garden?",Speaker="Female Splicer",Name="vo_S_2_Lf_MyGarden")
	Subtitles[175]=(Text="Who can blame a lady who craves variety?",Speaker="Female Splicer",Name="vo_S_2_Lf_CeilingCrawlerExB")
	Subtitles[176]=(Text="But the days go by like wind...",Speaker="Female Splicer",Name="vo_S_2_Lf_CeilingCrawlerExC")
	Subtitles[177]=(Text="Atlas radioed on ahead, says you were looking for an invite to the fisheries. Nuts, I say. But if'n you heads up to the wharf master's office and find ol' Peach a research camera, maybe I could manage an invite...",Speaker="Peach Wilkins",Name="vo_R_2_Pc_PeachFindCamera")
	Subtitles[178]=(Text="And one day the gentlemen stopped calling...",Speaker="Female Splicer",Name="vo_S_2_Lf_CeilingCrawlerExD")
	Subtitles[179]=(Text="What was that?",Speaker="Peach Wilkins",Name="vo_R_2_Pc_WhatWasThat")
	Subtitles[180]=(Text="(Lyrics) If I didn't care more than words can say If I didn't care would I feel this way? If this isn't love then why do I thrill? And what makes my head go 'round and 'round While my heart stands",Speaker="Female Splicer",Name="vo_S_2_Lf_InkLyricsDeck2a")
	Subtitles[181]=(Text="still? If I didn't care would it be the same? Would my ev'ry prayer begin and end with just your name? And would I be sure that this is love beyond compare? Would all this be true if I didn't care for you?",Speaker="Female Splicer",Name="vo_S_2_Lf_InkLyricsDeck2a")
	Subtitles[182]=(Text="My friend, you are fucked.",Speaker="Peach Wilkins",Name="vo_R_2_Pc_YouAreFucked")
	Subtitles[183]=(Text="My youth! My rose! I want it back! I want it back!! Yeargh!",Speaker="Female Splicer",Name="vo_S_2_Lf_CeilingCrawlerExF")
	Subtitles[184]=(Text="You hold tightly. I'm sending something fierce to watch your back.",Speaker="Peach Wilkins",Name="vo_R_2_Pc_HoldTight")
	Subtitles[185]=(Text="Friend, here's a present for that bitch. Put it between her eyes.",Speaker="Peach Wilkins",Name="vo_R_2_Pc_BetweenHerEyes")
	Subtitles[186]=(Text="That one's too tough for you. Look on the conveyer belt, you'll find something to keep you alive. Now go get that camera and then snapshots of on those that crawls on the ceiling... Then I'll let you in to the fisheries...",Speaker="Peach Wilkins",Name="vo_R_2_Pc_SoftTouch")
	Subtitles[187]=(Text="Seems like ol' Peach knows where to find a research camera. He seems a decent enough sort. No doubt he'll wait until after you've done his errands to stick a shiv in your belly.",Speaker="Atlas",Name="vo_R_2_At_WhereToGetCamera")
	Subtitles[188]=(Text="I took me wife on our first date to this place. You must think I'm a fool, taking a fine lady to a dump like this, but you don't know me Moira. Give",Speaker="Atlas",Name="vo_R_2_At_GoBuyFilm")
	Subtitles[189]=(Text="her a string of pearls and a silk gown, and she'll dance a waltz. Give her a sea shanty and a bottle of rum, and she'll drink a pirate under the table.",Speaker="Atlas",Name="vo_R_2_At_GoBuyFilm")
	Subtitles[190]=(Text="The research camera looks just like one you'd see topside. According to this magazine article I scrounged up, it can also 'analyze genetic information, parse biological structures' and lots of other five dollar words.",Speaker="Atlas",Name="vo_R_2_At_LookForCamera")
	Subtitles[191]=(Text="Good, you got the camera. Now get me some snap snaps on those spider splicers! And don't come back down here 'til you got my research!",Speaker="Peach Wilkins",Name="vo_R_2_Pc_GotCameraB")
	Subtitles[192]=(Text="You have the Research Camera? Good. Guess it's time to get to work for ol' Peachy. Take the man's pictures, and let's get the hell out of this place...",Speaker="Atlas",Name="vo_R_2_At_FoundCamera")
	Subtitles[193]=(Text="Pictures! I need me the dope on them splicers! I don't want to see you back here 'til you've got them, or you're in forty baby bits. Now hop it!",Speaker="Peach Wilkins",Name="vo_R_2_Pc_NeedPictures")
	Subtitles[194]=(Text="Just remember, sonny friend: I smell an ounce of Fontaine on you, and I'll have you in a box! Atlas gives you the vouch, but I ain't turning my eye just on his say so!",Speaker="Peach Wilkins",Name="vo_R_2_Pc_DontTrust")
	Subtitles[195]=(Text="Grown man, jumpin' at ghosts. Fontaine's dead and everybody knows it. In the ground for months, and half the place still jumping at his shadow...Christ, even Ryan. You never mind all that. We got work to do.",Speaker="Atlas",Name="vo_R_2_At_FontaineDead")
	Subtitles[196]=(Text="Now you ever bringing old Peach them snappies? Or are you just sight seein'?",Speaker="Peach Wilkins",Name="vo_R_2_Pc_BringPics")
	Subtitles[197]=(Text="Ain't you supposed to be taking the snappy snappies?",Speaker="Peach Wilkins",Name="vo_R_2_Pc_NoSnappies")
	Subtitles[198]=(Text="Sounds like that should about do it. Head on back to Fontaine Fisheries when you're ready, would you kindly?",Speaker="Atlas",Name="vo_R_2_At_HeadBackToFontaines")
	Subtitles[199]=(Text="They sure go down easy once you research them up right.. Come on in and show us those snappy snappies.",Speaker="Peach Wilkins",Name="vo_R_2_Pc_GoDownEasy")
	Subtitles[200]=(Text="Before you head into the Fisheries, a word to the wise. Ol' Peachy seems about as straight as a dog's hind leg. You keep your eyes open.",Speaker="Atlas",Name="vo_R_2_At_NiceWorkBackToFontaine")
	Subtitles[201]=(Text="The wharf rat didn't get himself et. You got something for me and my crew, or are you just looking to get criticized? You set here a spell, I needs to set on some coffee, maybe puts on silverware and the like.",Speaker="Peach Wilkins",Name="vo_R_2_Pc_GettingReady")
	Subtitles[202]=(Text="Nobody walks into my swampy carrying the heat. Put your weapons in the pneumo, and then I'll let you in.",Speaker="Peach Wilkins",Name="vo_R_2_Pc_CarryingHeatA")
	Subtitles[203]=(Text="If that's his price, you're gonna have to pay it. But he can't very well take your plasmids away, now can he?",Speaker="Atlas",Name="vo_R_2_At_PayIt")
	Subtitles[204]=(Text="Now, I bet when your boss weggled out of hell he done told the Devil he'd be right back and the Devil said, sure thing Mr. Fontaine,",Speaker="Peach Wilkins",Name="vo_R_2_Pc_DirtyWork")
	Subtitles[205]=(Text="I'll hold you a spot. Ryan promised Fontaine was dust, and now here you are, doing his dirty...I guess that makes Ryan a bum, and you a-",Speaker="Peach Wilkins",Name="vo_R_2_Pc_DirtyWork")
	Subtitles[206]=(Text="Sounds like trouble. I'll do what I can to help!",Speaker="Atlas",Name="vo_R_2_At_GetCover")
	Subtitles[207]=(Text="Atlas! He was ours! Ours!!!",Speaker="Peach Wilkins",Name="vo_S_2_Pc_HeWasOurs")
	Subtitles[208]=(Text="I think I can manage a 'bot for you, but that's about all I can do...",Speaker="Atlas",Name="vo_R_2_At_IncomingBot")
	Subtitles[209]=(Text="You got it! Should be smooth sailing from here. I'll meet you up ahead!",Speaker="Atlas",Name="vo_R_2_At_MeltIce")
	Subtitles[210]=(Text="The submarine bay was only used by smugglers and thieves. More than likely, the entrance will be hidden- better to keep the coppers off the scent.",Speaker="Atlas",Name="vo_R_2_At_MeetAtSubbay")
	Subtitles[211]=(Text="We all come down here, figured we'd all be part of Ryan's Great Chain. Turns out Ryan's chain is made of gold, and ours are the sort with the big iron ball around your",Speaker="Peach Wilkins",Name="vo_L_2_Pc_RyanLikeUs")
	Subtitles[212]=(Text="ankle. He's up in Fort Frolic banging fashion models... we're down in this dump yanking guts outta fish. Fontaine's promising something better. He's like one-a us, you",Speaker="Peach Wilkins",Name="vo_L_2_Pc_RyanLikeUs")
	Subtitles[213]=(Text="know, like he's worked a day in his life. He says meet him at his fish-packing joint at 11. I'll go, bring a couple of guys. Hey, it's not like things could get a lot worse.",Speaker="Peach Wilkins",Name="vo_L_2_Pc_RyanLikeUs")
	Subtitles[214]=(Text="This started out as simple. Take Fontaine's mini-sub back topside twice a week, pick up some choice goods- you know, beef, real sugar. But now Ryan and his type have up and called smuggling a",Speaker="Peach Wilkins",Name="vo_L_2_Pc_SmugglingACrime")
	Subtitles[215]=(Text="hanging crime. Hanging! Says any connection to the surface could destroy the city. 'Fore long, only difference between this place and topside is whether or not you can open the damn windows...",Speaker="Peach Wilkins",Name="vo_L_2_Pc_SmugglingACrime")
	Subtitles[216]=(Text="Fontaine's putting the screws on us, and double. He's squeezing us out of 80 points of our cut with the threat of turning us in to Ryan if we don't play ball. Son of a bitch. Sammy G. comes and tells me he's thinking of going to the",Speaker="Peach Wilkins",Name="vo_L_2_Pc_PuttingTheScrewsOn")
	Subtitles[217]=(Text="constable, and the next day, Sammy G. was found in a sack in the salt pond. We got no choice here. We stay on Fontaine's crew, we're gonna catch the gallows. We take a powder, and we end up like Sammy G. There's gotta be another way...",Speaker="Peach Wilkins",Name="vo_L_2_Pc_PuttingTheScrewsOn")
	Subtitles[218]=(Text="I'm closing in on the whole ring. I'd pat myself on the back, but let's face it...these aren't exactly bloodthirsty desperadoes we're talking about. Rapture's full of poets, artists, and tennis players, not",Speaker="Sullivan",Name="vo_L_2_Pd_SmugglingRing")
	Subtitles[219]=(Text="hired gorillas. But this leader of theirs, this Fontaine...he seems to know his way around a grift. He keeps his nose clean, but not so clean that the right people don't know he's not to be trifled with...",Speaker="Sullivan",Name="vo_L_2_Pd_SmugglingRing")
	Subtitles[220]=(Text="Hanging now, is it? That's what we've come to? Now look, I don't make the laws here, I just enforce them. But I didn't come to Rapture to string men up for running contraband. If Ryan and his crew have their law, then they can have my badge.",Speaker="Sullivan",Name="vo_L_2_Pd_HaveMyBadge")
	Subtitles[221]=(Text="The Irish porkpie offered me a deal. I flip 'em Fontaine, and I walk out of here. That simple. How do I know that fat fuck isn't Fontaine's guy? How do I know they're not all",Speaker="Peach Wilkins",Name="vo_L_2_Pc_OfferedADeal")
	Subtitles[222]=(Text="Fontaine's guy? Fontaine's got Adam and everybody wants it. Ryan's got a whole lot of talk and a nice suit. Even down here, any idiot can see which way the wind is blowing.",Speaker="Peach Wilkins",Name="vo_L_2_Pc_OfferedADeal")
	Subtitles[223]=(Text="This Fontaine fellow is somebody to watch. Once, he was just a menace, to be convicted and hung. But he always manages to be where the evidence isn't. He's the most dangerous type of hoodlum...the kind with vision.",Speaker="Andrew Ryan",Name="vo_L_2_Ry_MenaceFontaine")
	Subtitles[224]=(Text="The death penalty in Rapture! Council's in an uproar. Riots in the streets, they say! But this is the time for leadership. Action must be taken against the",Speaker="Andrew Ryan",Name="vo_L_2_Ry_CityInUproar")
	Subtitles[225]=(Text="smugglers. Any contact with the surface exposes Rapture to the very Parasites we fled from. A few stretched necks are a small price to pay for our ideals.",Speaker="Andrew Ryan",Name="vo_L_2_Ry_CityInUproar")
	Subtitles[226]=(Text="On my walk today I had my first encounter with a pair of them...he, a lumbering palooka in a foul smelling diving suit, and she, an unwashed moppet in a filthy pink smock. Her pallor was off, green and morbid, and",Speaker="Andrew Ryan",Name="vo_L_2_Ry_BouncerAndGatherer")
	Subtitles[227]=(Text="there was a rather unpleasant aspect to her demeanor, as if she were in an altogether different place than the rest of us ...I understand the need for such creatures. I just wish they could make them more presentable.",Speaker="Andrew Ryan",Name="vo_L_2_Ry_BouncerAndGatherer")
	Subtitles[228]=(Text="Diane, my dear I'm sorry but I'll be late again tonight.. Rosenberg is demanding to speak about this Fontaine business. I'm trying to build a proper financial market and this",Speaker="Andrew Ryan",Name="vo_L_2_Ry_WorkingLate")
	Subtitles[229]=(Text="idiot keeps going on about Adam this and genetic modification that. I'll go spend an hour pretending to pay attention to the poor fellow and be home as soon as I can. -Andrei",Speaker="Andrew Ryan",Name="vo_L_2_Ry_WorkingLate")
	Subtitles[230]=(Text="Something must be done about Fontaine. While I was buying buildings and fish futures, he was cornering the market on genotypes and",Speaker="Andrew Ryan",Name="vo_L_2_Ry_FontaineMustGo")
	Subtitles[231]=(Text="nucleotide sequences. Rapture is transforming before my eyes. The Great Chain is pulling away from me. Perhaps it's time to give it a tug.",Speaker="Andrew Ryan",Name="vo_L_2_Ry_FontaineMustGo")
	Subtitles[232]=(Text="I'm right outside the submarine bay, but I can't get in. I'll need you for that. My family can't be more than a hundred yards away.",Speaker="Atlas",Name="vo_R_2_At_ReachedFisheries")
	Subtitles[233]=(Text="The thought of my wife and child hiding in that filthy submarine makes me blood boil. Help me get them to safety and I'll be in your debt for life.",Speaker="Atlas",Name="vo_R_2_At_HopeFamily")
	Subtitles[234]=(Text="You've had your fun, but enough is enough... If you press that button, you'll learn what it means to truly be my enemy.",Speaker="Andrew Ryan",Name="vo_R_2_Ry_HadSomeFun")
	Subtitles[235]=(Text="Good news. I managed to track down one of Peach's hooligans. And wouldn't you know it, the man had your pistol on him...sending it to you at the nearest pneumo.",Speaker="Atlas",Name="vo_R_2_At_GoodNews")
	Subtitles[236]=(Text="Can't have you walkin' round naked as a jaybird. I'm sending you me very own firearm. You'll find it in the nearest pneumo.",Speaker="Atlas",Name="vo_R_2_At_CantWalkNaked")
	Subtitles[237]=(Text="Hit the switch up there in the control booth, and let me in. I think it's time to shake hands and get acquainted.",Speaker="Atlas",Name="vo_R_2_At_HitSwitch")
	Subtitles[238]=(Text="Can you hear me family in the sub? Are they making any noise at all?",Speaker="Atlas",Name="vo_R_2_At_HearFamily")
	Subtitles[239]=(Text="You blow a fuse up there? Can't see a damn thing in that booth. Give me a tick, and I'll get you out of there. Moira! Can you hear me in there, darling?",Speaker="Atlas",Name="vo_R_2_At_AllDark")
	Subtitles[240]=(Text="So dark in here...if only your friend could look up and see you...maybe you could warn him...if only you could do something...anything...except just stand here...and watch him die...",Speaker="Andrew Ryan",Name="vo_R_2_Ry_DarkAmbush")
	Subtitles[241]=(Text="Splicers!",Speaker="Atlas",Name="vo_R_2_At_AmbushEverywhere")
	Subtitles[242]=(Text="Get out if you can! Get out and we'll regroup!",Speaker="Atlas",Name="vo_R_2_At_GetOut")
	Subtitles[243]=(Text="They're everywhere! I can't hold 'em, got to fall back! Get me family out and we'll regroup as soon as we can!",Speaker="Atlas",Name="vo_R_2_At_HoldFamily")
	Subtitles[244]=(Text="The sub! Noooo!",Speaker="Atlas",Name="vo_R_2_At_PatrickNo")
	Subtitles[245]=(Text="Get out...Get out and get to Arcadia...Jesus Christ...",Speaker="Atlas",Name="vo_R_2_At_GetToArcadia")
	Subtitles[246]=(Text="You ooze in like an assassin and then you try to sneak out like a thief. You're no CIA spook. Who are you? Why have you come here? There's two ways to deal with a mystery...uncover it, or eliminate it.",Speaker="Andrew Ryan",Name="vo_R_2_Ry_LikeAnAssassin")
	Subtitles[247]=(Text="I met Ryan the day me and the lads were installing the bathroom plumbing up in his posh Park Avenue digs. 'Oi!' says he, 'what's with all the brass fittings? General contractor had me down for the",Speaker="McDonagh",Name="vo_L_2_Md_RyanPlumbing")
	Subtitles[248]=(Text="tin.' 'Well,' I says, 'I suppose it's the contractor then who'll be bailing out your loo once a fortnight, is it? If it's price you're worried about, I'll be picking up the brass, so not to worry,",Speaker="McDonagh",Name="vo_L_2_Md_RyanPlumbing")
	Subtitles[249]=(Text="squire.' 'And why would you be doing that,' says he? 'Well, Mr. Ryan, profit or not, no man bails water out of privies built by Bill McDonagh.' The next day I finds out, I'm Ryan's new general contractor.",Speaker="McDonagh",Name="vo_L_2_Md_RyanPlumbing")
	Subtitles[250]=(Text="If things weren't bad enough, it seems that even our water system's sprung a leak. Yep, that's right. The irrigation system in Arcadia is taking on sea water. I told Mr. Ryan when we",Speaker="McDonagh",Name="vo_L_2_Md_LeakyEden")
	Subtitles[251]=(Text="were building this place that either you build her like a bath tub, or she's gonna turn into a sewer. No, McDonagh, he said, we're not gonna build no bathtub...we're gonna build Eden.",Speaker="McDonagh",Name="vo_L_2_Md_LeakyEden")
	Subtitles[252]=(Text="Rapture's changing, but Ryan can't see the wolves in the woods. This Fontaine fellow...he's a crook and a proper tea leaf, but he's got the ADAM, and that makes him the guv'nor. He's sinking the profits back into",Speaker="McDonagh",Name="vo_L_2_Md_WoodWolves")
	Subtitles[253]=(Text="bigger and better plasmids, and building them Fontaine Poorhouses...more like Fontaine recruiting centers...'Fore we know it, bloke's gonna have an army of splicers, and we're gonna have ourselves a whole heap of miseries.",Speaker="McDonagh",Name="vo_L_2_Md_WoodWolves")
	Subtitles[254]=(Text="Mr. Ryan ... I believe in Rapture. But that doesn't mean we always win. Fontaine Futuristics is the biggest thing going in Rapture. So let me be plain: when we arrest that toerag Fontaine",Speaker="McDonagh",Name="vo_L_2_Md_FontaineFuturisticsLog")
	Subtitles[255]=(Text="for his thieving and smuggling, we must make it clear that we won't touch his business interests. We sit on the council because these poor sods trust us...not because God gave us a chair.",Speaker="McDonagh",Name="vo_L_2_Md_FontaineFuturisticsLog")
	Subtitles[256]=(Text="Fontaine knew our blokes were coming. We were done over. Them splicers come screaming out the woodwork. Burping fire, spitting ice...demons out of the Bible they were. Never seen nothing like it. It wasn't a business he was building, it was an army.",Speaker="McDonagh",Name="vo_L_4_Md_DoneOver")
	Subtitles[257]=(Text="The good people of Rapture didn't sign up to see us government-types shutting down shops, killing their owners ...even with a ponce like Fontaine. But he brung it upon",Speaker="McDonagh",Name="vo_L_4_Md_GunsBlazing")
	Subtitles[258]=(Text="himself. 'Stead of copping it on the chin, bugger gets it into his 'ead that he's gonna go down guns blazing. Who does he think he is? John bloody Wayne? We can get on top",Speaker="McDonagh",Name="vo_L_4_Md_GunsBlazing")
	Subtitles[259]=(Text="of this. We can. Here's what we do: we find Fontaine's will and make what was his go to where it was intended - and not into the pockets of us that put 'im into the ground.",Speaker="McDonagh",Name="vo_L_4_Md_GunsBlazing")
	Subtitles[260]=(Text="As the respectable labs have all turned me away, I have turned to Fontaine's smugglers in Port Neptune for supplies. Fontaine's men are pigs. They spit, they stink. But they deliver",Speaker="Tenenbaum",Name="vo_L_2_Tn_TenPigMen")
	Subtitles[261]=(Text="and they don't ask questions. They're all terrified of Fontaine...he reminds me a bit of the Germans-so efficient. It wouldn't surprise me if he were soon running things down here.",Speaker="Tenenbaum",Name="vo_L_2_Tn_TenPigMen")
	Subtitles[262]=(Text="I saw one of the smugglers having a game of catching on the docks today. And this surprised me, because his hands were crippled during the war. He was unloading the barge the other day when he was",Speaker="Tenenbaum",Name="vo_L_2_Tn_TenSawSmugglers")
	Subtitles[263]=(Text="bitten from this sea slug. He woke up the next morning and he found he could move his fingers for the first time in years. I asked him if he still had that sea slug. As luck would have it, he did...",Speaker="Tenenbaum",Name="vo_L_2_Tn_TenSawSmugglers")
	Subtitles[264]=(Text="This little sea slug has come along and glued together all the crazy ideas I've had since the war... it doesn't just heal damaged cells, it...resurrects them...I",Speaker="Tenenbaum",Name="vo_L_2_Tn_TenCrazySlug")
	Subtitles[265]=(Text="can bend the double helix... Black can be reborn white, tall short. Weak, strong...But the slugs alone are not enough...I'll need money...and one other thing...",Speaker="Tenenbaum",Name="vo_L_2_Tn_TenCrazySlug")
	Subtitles[266]=(Text="Spent the morning jawing with that Kraut scientist. She's damaged goods, all right. Just like all those chumps they scraped out of them prison camps. But she's no",Speaker="Frank Fontaine",Name="vo_L_2_Ft_FonMadScience")
	Subtitles[267]=(Text="crackpot...she's gonna make me the kinda scratch that'll have Ryan look like he's runnin' a paper route. She just needs some supplies to get the ball rolling...and a friend to watch her back.",Speaker="Frank Fontaine",Name="vo_L_2_Ft_FonMadScience")
	Subtitles[268]=(Text="Darling Masha- We don't know what has happened to you...Ryan's men have taken you away and said you are needed to save Rapture. Who needs a child to save a city? But I see these little girls crawling out of these vents, and I",Speaker="Mariska Lutz",Name="vo_L_2_Ml_ComeTo")
	Subtitles[269]=(Text="only wonder if you might one day crawl out of this vent and find this note. We look for you, but if you find this, come to us at the Fighting McDonaghs in room #7. The code to our room is 7533. We miss you, our darling child.",Speaker="Mariska Lutz",Name="vo_L_2_Ml_ComeTo")
	Subtitles[270]=(Text="We saw our Masha today. We barely recognized her. That's her, Sam said. You're crazy, I told him. That thing? That, that is our Masha? But he was right.",Speaker="Mariska Lutz",Name="vo_L_2_Ml_BarelyRecognized")
	Subtitles[271]=(Text="She was drawing blood out of a corpse by Fontaine Fisheries, and then when she was done, she walked off hand in hand with one of those awful golems. Masha!",Speaker="Mariska Lutz",Name="vo_L_2_Ml_BarelyRecognized")
	Subtitles[272]=(Text="Now the eggs are in the scramble. We picked up Timmy H. right after midnight. Either Ryan'll be taking down Fontaine, or Fontaine'll",Speaker="Sullivan",Name="vo_L_2_Pd_SuvsInteroLog")
	Subtitles[273]=(Text="be taking down Ryan. We'll be 'interviewing' poor Timmy 'neath Fontaine Fisheries...if you're up for entertainment, the code's 5380.",Speaker="Sullivan",Name="vo_L_2_Pd_SuvsInteroLog")
	Subtitles[274]=(Text="Mr. Ryan asked me personally to make this clear to you. You give us Fontaine, and this whole filthy ring of his, and you'll be knocking back pints up at the Fighting McDonaghs. But if you prefer to play the mule...we'll treat you like",Speaker="Sullivan",Name="vo_L_2_Pd_RyanDoesWorse")
	Subtitles[275]=(Text="a mule.. Give him a taste, Patrick...   Sullivan: Oh, what's that? Change of heart, Timmy? Timmy? Ready to talk now?   Timmy H: Go on, Sullivan...go on and do your dirty!...whatever Ryan thinks he can do to me, Fontaine can do double!",Speaker="Sullivan",Name="vo_L_2_Pd_RyanDoesWorse")
	Subtitles[276]=(Text="We're putting all the bathyspheres in lockdown until further notice. Ryan had us install some kinda genetic device into the things so only Ryan and his inner circle will be able to",Speaker="Sullivan",Name="vo_L_2_Pd_BathyLockdown")
	Subtitles[277]=(Text="use 'em without dispensation. But the boys tell me the keys are pretty unreliable. Sisters, cousins-anybody in the ballpark genetically will be able to come and go as they see fit.",Speaker="Sullivan",Name="vo_L_2_Pd_BathyLockdown")
	Subtitles[278]=(Text="Ghost 1: You can't quit...Fontaine will find you... Ghost 2: Hey, fuck Fontaine! Ghost 1: You don't fuck Fontaine. Fontaine fucks you.",Speaker="",Name="vo_S_2_Gd_CantQuit")
	Subtitles[279]=(Text="Hey, fuck Fontaine!",Speaker="Ghost Two",Name="vo_S_2_Ge_Xxx")
	Subtitles[280]=(Text="All right, here's the code: 9332. You use it on your cell if you want, but remember this. Once you walk out of that cell, you belong to",Speaker="Peach Wilkins",Name="vo_L_2_Pc_PeachPrisonCode")
	Subtitles[281]=(Text="Fontaine. You're walking out of one jail and into another. Hey, do whatcha want. Just don't kid yourself by thinking you won any kinda freedom.",Speaker="Peach Wilkins",Name="vo_L_2_Pc_PeachPrisonCode")
	Subtitles[282]=(Text="Moira... Patrick... Ain't that just like Ryan, waits until we're almost out, and then he pulls the string. We'll find the bastard, we'll find him and we'll tear his heart out.",Speaker="Atlas",Name="vo_R_3_At_EnterArcadia")
	Subtitles[283]=(Text="You get to the Bathysphere in the Rolling Hills. That'll take you straight to the devil himself. And then all debts will be paid in full.",Speaker="Atlas",Name="vo_R_3_At_GoToBathy")
	Subtitles[284]=(Text="I came to this place to build the impossible. You came to rob what you could never build, a Hun gaping at the gates of Rome. Even the air you breathe is sponged from my account. Well, breathe deep...so later you might remember the taste.",Speaker="Andrew Ryan",Name="vo_R_3_Ry_EnterArcadia")
	Subtitles[285]=(Text="You might hear things about me, see my name about. Think what you will. There was a time I cared about politics... But it's just an excuse men use to kill one another. I'm done with all that. I just want to see the sunlight again.",Speaker="Atlas",Name="vo_R_3_At_HearingThings")
	Subtitles[286]=(Text="What a night I got lined up. Everything's ready. Flowers, bottle of wine, even two tickets to the Tea Garden. Nothing gets the betties in the mood like",Speaker="Dieter Sonnekalb",Name="vo_L_3_Gm_Tryst")
	Subtitles[287]=(Text="nighttime in Arcadia. Now I just gotta stop by the Thrifty Care to pick up a med hypo, just to be safe. Word is this ain't Angelina's first visit to the Tea Garden...",Speaker="Dieter Sonnekalb",Name="vo_L_3_Gm_Tryst")
	Subtitles[288]=(Text="What are you waiting for, silly? It's beautiful!!!",Speaker="Ghost Female",Name="vo_S_3_Gf_TrystPath")
	Subtitles[289]=(Text="Female Ghost: 'Oh, sugar...I'm spliced up in ways you never dreamed of...'   Dieter Sonnekalb: 'Get over here...'   Female Ghost: (giggle)",Speaker="Ghost Female",Name="vo_S_3_Gf_TrystSequence")
	Subtitles[290]=(Text="Christ, is somebody there?",Speaker="Male Splicer",Name="vo_S_3_Lm_AssIntroA")
	Subtitles[291]=(Text="The splicers, they're everywhere!",Speaker="Male Splicer",Name="vo_S_3_Lm_AssIntroB")
	Subtitles[292]=(Text="Can you help me? Can you help?!",Speaker="Male Splicer",Name="vo_S_3_Lm_AssIntroC")
	Subtitles[293]=(Text="Wait! This way!",Speaker="Male Splicer",Name="vo_S_3_Lm_AssIntroD")
	Subtitles[294]=(Text="Over here!",Speaker="Male Splicer",Name="vo_S_3_Lm_AssIntroF")
	Subtitles[295]=(Text="Jesus, God, somebody help!",Speaker="Male Splicer",Name="vo_S_3_Lm_AssIntroG")
	Subtitles[296]=(Text="Hello, beautiful...",Speaker="Male Splicer",Name="vo_S_3_Lm_AssIntroE")
	Subtitles[297]=(Text="On the surface, I once bought a forest. The Parasites claimed that the land belonged to God, and demanded that I establish a public park there. Why? So the rabble could stand",Speaker="Andrew Ryan",Name="vo_R_3_Ry_ArcadiaIntro")
	Subtitles[298]=(Text="slack-jawed under the canopy, and pretend that it was Paradise earned. When Congress moved to nationalize my forest, I burnt it to the ground. God did not plant the seeds of this Arcadia. I did.",Speaker="Andrew Ryan",Name="vo_R_3_Ry_ArcadiaIntro")
	Subtitles[299]=(Text="Why do they wear those masks? Maybe there's a part of them that remembers how they used to be, how they used to look. And they're ashamed.",Speaker="Atlas",Name="vo_R_3_At_Masks")
	Subtitles[300]=(Text="They dress up in leaves and call themselves the Saturnine. Please. They drink human blood, and chant- 'Harness the flame, Harness the mist!'",Speaker="Julie Langford",Name="vo_L_3_Pf_Cultists")
	Subtitles[301]=(Text="and believe they are touched by the ancient gods. Hah. An aging bunch of frat boys, tilting back goblets of plasmids and calling it ambrosia.",Speaker="Julie Langford",Name="vo_L_3_Pf_Cultists")
	Subtitles[302]=(Text="Today Arcadia was closed off to all but paying customers. The man hires me to build a forest at the bottom of the ocean, and then turns a walk in the woods into a luxury. Ryan asked 'Should a farmer not be",Speaker="Julie Langford",Name="vo_L_3_Pf_LanBioA")
	Subtitles[303]=(Text="able to sell his food?' 'Is a potter not entitled to a profit from his pots?' I started to argue with the man and then I remembered who signed my checks. Only thing worse than a hypocrite is an unemployed one.",Speaker="Julie Langford",Name="vo_L_3_Pf_LanBioA")
	Subtitles[304]=(Text="Who says you can't teach an old hound new tricks? This batty plant woman spends four years coming up with ways to defoliate trees in the Pacific to scare out the Japs and now here I am down at the",Speaker="Julie Langford",Name="vo_L_3_Pf_LanBioC")
	Subtitles[305]=(Text="bottom of the Atlantic trying to figure out how to do the same thing in reverse. Adam, Adam, Adam... It's bathtub gin, times the atom bomb, times Eve with the serpent. Let's go see what it can do.",Speaker="Julie Langford",Name="vo_L_3_Pf_LanBioC")
	Subtitles[306]=(Text="Now I'm a woman of science, but I'm also a woman who's not afraid of turning a buck or two. Ryan said if I could boost profits in Arcadia, part of the up would ride on my hip. So I get to thinking, we're paying for",Speaker="Julie Langford",Name="vo_L_3_Pf_LanBioB")
	Subtitles[307]=(Text="oxygen when we got photosynthesizing trees...Hell, we can even sell the extra to the rest of the city and undercut the other guys. Ryan will like that for sure- Fontaine's people have moved into the O2 biz tooth and claw.",Speaker="Julie Langford",Name="vo_L_3_Pf_LanBioB")
	Subtitles[308]=(Text="You got the chlorophyll, what else do you Saturnines want! Leave me alone, or I'll sick my turrets on the whole damn lot of you!",Speaker="Julie Langford",Name="vo_S_3_Pf_NotYet")
	Subtitles[309]=(Text="Rolling Hills is over yonder.... And the bathypshere station is as well. And then straight on to Ryan.",Speaker="Atlas",Name="vo_R_3_At_FoundHills")
	Subtitles[310]=(Text="The minute we came here, Masha started screaming, 'Mama! Mama! What is that!? What is that!?' I thought she was having some kind of seizure and",Speaker="Mariska Lutz",Name="vo_L_3_Ml_FlavorF")
	Subtitles[311]=(Text="then I realized...trees...trees! Never saw one before, thought they were monsters. Oh, Sammy, maybe we never should have come to this place...",Speaker="Mariska Lutz",Name="vo_L_3_Ml_FlavorF")
	Subtitles[312]=(Text="You'll ruin everything! Everything!",Speaker="Female Splicer",Name="vo_S_3_La_SatRuin")
	Subtitles[313]=(Text="Saturnine! Run, run!",Speaker="Female Splicer",Name="vo_S_3_La_RunSatB")
	Subtitles[314]=(Text="They're coming!",Speaker="Female Splicer",Name="vo_S_3_La_RunSatShit")
	Subtitles[315]=(Text="It's those damn cultists!",Speaker="Female Splicer",Name="vo_S_3_La_RunSatFanatics")
	Subtitles[316]=(Text="We Saturnine don't like strangers.",Speaker="Female Splicer",Name="vo_S_3_La_SatStrangers")
	Subtitles[317]=(Text="Toxic! Toxic! Unclean!",Speaker="Doctor Grossman",Name="vo_S_3_Dg_Toxic")
	Subtitles[318]=(Text="This is our place. Ours!",Speaker="Doctor Grossman",Name="vo_S_3_Dg_OurPlace")
	Subtitles[319]=(Text="Oh friend, you've tangled with the wrong people.",Speaker="Doctor Grossman",Name="vo_S_3_Dg_Tangled")
	Subtitles[320]=(Text="You defile this place.",Speaker="Doctor Grossman",Name="vo_S_3_Dg_Defile")
	Subtitles[321]=(Text="You trifle with the Saturnine?!",Speaker="Doctor Grossman",Name="vo_S_3_Dg_Trifle")
	Subtitles[322]=(Text="Saturnine! Run, run!",Speaker="Doctor Grossman",Name="vo_S_3_Dg_RunSatB")
	Subtitles[323]=(Text="You're dirty! Filthy!",Speaker="Doctor Grossman",Name="vo_S_3_Dg_SatFilthy")
	Subtitles[324]=(Text="This isn't right...I'm gonna need you to listen to me. I'm no sort of, botanist, but I think Ryan has just killed Arcadia...the man's put",Speaker="Atlas",Name="vo_R_3_At_DieOff")
	Subtitles[325]=(Text="something foul into the air. Bottom of the ocean, boyo. All the oxygen comes from the trees. No trees, no oxygen. Give me a spell to think.",Speaker="Atlas",Name="vo_R_3_At_DieOff")
	Subtitles[326]=(Text="Oxygen levels critical. Lockdown initiated. All bulkhead doors are now sealed. Thank you!",Speaker="Announcer",Name="vo_S_3_Fa_CantLeaveF")
	Subtitles[327]=(Text="Damn city's built to not let anyone out in the event of this kind of emergency...either we get those trees back...or you're a permanent resident.",Speaker="Atlas",Name="vo_R_3_At_CantLeave")
	Subtitles[328]=(Text="Ryan's woman in Arcadia is an old betty named Langford. An okay sort, but not above doing a dirty job for a dollar. If she's still kicking around, I'm sure she's gonna want to save her trees. After all, she planted the damn things.",Speaker="Atlas",Name="vo_R_3_At_FindLang")
	Subtitles[329]=(Text="I've been killing trees for twenty-five years. At Berkeley, back in the 20's. On the Japs at Iwo Jima. But I never brought one back from the grave before. I did, Becky.",Speaker="Julie Langford",Name="vo_L_3_Pf_LVIntroA")
	Subtitles[330]=(Text="Momma's gonna build her first damn Frankentree. I'm gonna call my little creation 'The Lazarus Vector.' Maybe it'll bring the old gal's career back from the dead as well...",Speaker="Julie Langford",Name="vo_L_3_Pf_LVIntroA")
	Subtitles[331]=(Text="My trees! It wasn't you, was it? No...Ryan!......I think I've got a way to save the trees, it's a genetic vector that...oh, look who",Speaker="Julie Langford",Name="vo_S_3_Pf_BringRoseA")
	Subtitles[332]=(Text="I'm talking to...Could you find a sample of Rosa Gallica for me?...look in the Grotto...I've got to keep working while there's time...",Speaker="Julie Langford",Name="vo_S_3_Pf_BringRoseA")
	Subtitles[333]=(Text="Yes yes yes. I KNOW about the lockdown. It's absurd. Just give me a minute! The early Lazarus tests are very promising. If the Rosa Gallica bloom, then by God I'll know we're",Speaker="Julie Langford",Name="vo_L_3_Pf_Roses")
	Subtitles[334]=(Text="in business...   'Hurry! The lockdown!!'   Hm? Oh all right! I'm leaving! But somebody has to find a way to come back to check on these samples. They're very important!",Speaker="Julie Langford",Name="vo_L_3_Pf_Roses")
	Subtitles[335]=(Text="Would you kindly find that specimen? And you best be quick about it...unless you're planning on growing gills.",Speaker="Atlas",Name="vo_R_3_At_HurryBringRose")
	Subtitles[336]=(Text="You've brought the Rosa Gallica? Well, what are you waiting for? An engraved invitation? Send it through the pneumo!",Speaker="Julie Langford",Name="vo_S_3_Pf_SendRose")
	Subtitles[337]=(Text="Yes, this is perfect...perfect...Come on up to my office...I'm letting you in now.... I think I've got just the thing to put the green back in this forest.",Speaker="Julie Langford",Name="vo_S_3_Pf_BroughtRose")
	Subtitles[338]=(Text="I've got the security system In this joint hacked, so those turrets won't bite. Come on up to my office.",Speaker="Julie Langford",Name="vo_S_3_Pf_ComeSeeMe")
	Subtitles[339]=(Text="Isn't there anything in this damn place those pagans won't steal? Paper towels, ink pots, witch hazel, chlorophyll solution,",Speaker="Julie Langford",Name="vo_L_3_Pf_RecipeHintA")
	Subtitles[340]=(Text="even my back issues of National Geographic. They're feathering their disgusting little shrines with it, I suppose. Sick bastards.",Speaker="Julie Langford",Name="vo_L_3_Pf_RecipeHintA")
	Subtitles[341]=(Text="Andrew Ryan: Julie, we made a business deal, you and I, did we not? Money changed hands. Let me read to you from the agreement... Section 3, Subsection 4",Speaker="",Name="vo_S_3_Ry_LangDieSequence")
	Subtitles[342]=(Text="Langford: Mr. Ryan?",Speaker="",Name="vo_S_3_Ry_LangDieSequence")
	Subtitles[343]=(Text="Every time we get a yard ahead, Ryan goes and moves the goal line down to the other side of the field.",Speaker="Atlas",Name="vo_R_3_At_FindRecipe")
	Subtitles[344]=(Text="What's the point of being a damn genius if the only ones around to appreciate it are bunch of spliced up morons? I've cracked the Vector, or at least I'm 99% certain I have. I",Speaker="Julie Langford",Name="vo_L_3_Pf_Recipe")
	Subtitles[345]=(Text="just need a bud of Rosa Gallica to confirm my analysis. Distilled water, a bit of chlorophyll, and enyzmes extracted from Apis Mellifera. That's right, sweethearts: honey bee spit.",Speaker="Julie Langford",Name="vo_L_3_Pf_Recipe")
	Subtitles[346]=(Text="Don't fight the inevitable. You'll run out of oxygen soon, and then you'll just go to sleep.",Speaker="Andrew Ryan",Name="vo_R_3_Ry_TauntA")
	Subtitles[347]=(Text="You're about halfway there. Keep your hand on the throttle. Ryan's skin jobs aren't the type to get complacent.",Speaker="Atlas",Name="vo_R_3_At_LVProgress")
	Subtitles[348]=(Text="Arcadia's a big place, but mostly rural. If you're looking for something in particular, I'd start at the Farmer's Market.",Speaker="Atlas",Name="vo_R_3_At_GoMarket")
	Subtitles[349]=(Text="You are the poison!",Speaker="Female Splicer",Name="vo_S_3_La_YouArePoison")
	Subtitles[350]=(Text="You have poisoned our earth.",Speaker="Female Splicer",Name="vo_S_3_La_PoisonedEarth")
	Subtitles[351]=(Text="He is the poison! Kill him!",Speaker="Female Splicer",Name="vo_S_3_La_IsThePoison")
	Subtitles[352]=(Text="This onehe brought the poison!",Speaker="Female Splicer",Name="vo_S_3_La_BroughtPoison")
	Subtitles[353]=(Text="This was our home!",Speaker="Doctor Grossman",Name="vo_S_3_Dg_OurHome")
	Subtitles[354]=(Text="The poison! Kill the poison!",Speaker="Doctor Grossman",Name="vo_S_3_Dg_KillPoison")
	Subtitles[355]=(Text="Cut out the poison!",Speaker="Doctor Grossman",Name="vo_S_3_Dg_CutOutPoison")
	Subtitles[356]=(Text="This one- He brought the poison!",Speaker="Doctor Grossman",Name="vo_S_3_Dg_BroughtPoison")
	Subtitles[357]=(Text="This ground is sacred.",Speaker="Male Splicer",Name="vo_S_3_Bw_Sacred")
	Subtitles[358]=(Text="You smell the blood of Saturnine.",Speaker="Male Splicer",Name="vo_S_3_Bw_SmellBlood")
	Subtitles[359]=(Text="Saturnine! We're dead men!",Speaker="Male Splicer",Name="vo_S_3_Bw_RunSatShit")
	Subtitles[360]=(Text="It's those goddamn fanatics!",Speaker="Male Splicer",Name="vo_S_3_Bw_RunSatFanatics")
	Subtitles[361]=(Text="The poison! Kill the poison!",Speaker="Male Splicer",Name="vo_S_3_Bw_KillPoison")
	Subtitles[362]=(Text="You are the poison!",Speaker="Male Splicer",Name="vo_S_3_Bw_YouArePoison")
	Subtitles[363]=(Text="You bring poison, you DIE!",Speaker="Male Splicer",Name="vo_S_3_Bw_PoisonDie")
	Subtitles[364]=(Text="He's the poison! Kill him!",Speaker="Male Splicer",Name="vo_S_3_Bw_IsThePoison")
	Subtitles[365]=(Text="Kill him! He poisoned the trees!",Speaker="Male Splicer",Name="vo_S_3_Bw_PoisonedTrees")
	Subtitles[366]=(Text="Julie, my dear, I am trying to run a business here. You wanna spend time with my honey bees, well, I'm gonna have to start charging you for the pleasure. If I come out one more time and find you lolling",Speaker="Tasha Denu",Name="vo_L_3_Td_RecipeHintB")
	Subtitles[367]=(Text="out there amongst my hives, I'm grabbing my shotgun. As to your question, yes, my days in beekeeping school are a blur, but I do seem to remember something about that enzyme you keep blabbing on about.",Speaker="Tasha Denu",Name="vo_L_3_Td_RecipeHintB")
	Subtitles[368]=(Text="In ten years in this dump, I've come to accept a very low standard of life. But even at the bottom of this fish tank, a man must have standards. The pathetic trou du cul down at Worley Winery has started",Speaker="Pierre Gobbi",Name="vo_L_3_Pb_RecipeHintC")
	Subtitles[369]=(Text="putting water to his terrible wine...water!!! When I confronted him with this fact, he tells me, 'Pierre, this is not to worry, the water, she is distilled. It could be worse...I could take it right from the ocean...'",Speaker="Pierre Gobbi",Name="vo_L_3_Pb_RecipeHintC")
	Subtitles[370]=(Text="Do you have all the components for the Lazarus Vector yet? If you do, best head to a crafting station. Then, head back to Langford's lab and put the whole witch's brew in the mister. That should clear this fog right up.",Speaker="Atlas",Name="vo_R_3_At_ComponentsDone")
	Subtitles[371]=(Text="Would you kindly get this thing crafted already? Air's only getting thinner down here.",Speaker="Atlas",Name="vo_R_3_At_CraftLV")
	Subtitles[372]=(Text="From the sounds of that U-Invent, I'm guessing you're the proud papa of a brand new Lazarus Vector. Now drop the Vector into a gadget called the Central Misting Control. Then we'll be cooking with gas.",Speaker="Atlas",Name="vo_R_3_At_GoUseMPR")
	Subtitles[373]=(Text="Ah, listen to that damn thing gurgle and crank. How long is it going to take?",Speaker="Atlas",Name="vo_R_3_At_UsedMPR")
	Subtitles[374]=(Text="It seems Julie's death didn't provide a clear enough lesson to you. Perhaps this will suffice.",Speaker="Andrew Ryan",Name="vo_R_3_Ry_StartAmbush")
	Subtitles[375]=(Text="Ryan's got your number. No doubt he'll be sending company. Best to head back to the lab entrance and seal her up...might be the only way to keep the splicers out.",Speaker="Atlas",Name="vo_R_3_At_StartAmbush")
	Subtitles[376]=(Text="What are you waiting for boyo? Ryan's lads are on their way...get the lab entrance sealed!",Speaker="Atlas",Name="vo_R_3_At_HurrySealDoor")
	Subtitles[377]=(Text="Oh, Christ. Here they come.",Speaker="Atlas",Name="vo_R_3_At_FailedSealDoor")
	Subtitles[378]=(Text="Did you get that door closed? Good. That should buy some time.",Speaker="Atlas",Name="vo_R_3_At_SealedDoor")
	Subtitles[379]=(Text="I've sent you a wee package through the pneumo. It's not much, but every little bit counts.",Speaker="Atlas",Name="vo_R_3_At_PrepAmbush")
	Subtitles[380]=(Text="C'mon! C'mon already!",Speaker="Male Splicer",Name="vo_S_3_Bw_CmonAlready")
	Subtitles[381]=(Text="What's taking so long?",Speaker="Male Splicer",Name="vo_S_3_Bw_TakingSoLong")
	Subtitles[382]=(Text="Let's do it! Let's do it!",Speaker="Male Splicer",Name="vo_S_3_Bw_Dolt")
	Subtitles[383]=(Text="Ready...Ready...",Speaker="Female Splicer",Name="vo_S_3_La_Ready")
	Subtitles[384]=(Text="Now!",Speaker="Female Splicer",Name="vo_S_3_La_Now")
	Subtitles[385]=(Text="Now!",Speaker="Doctor Grossman",Name="vo_S_3_Dg_Now")
	Subtitles[386]=(Text="Kill the parasite!",Speaker="Male Splicer",Name="vo_S_3_Bw_Crush")
	Subtitles[387]=(Text="Fix em! Fix 'em good!",Speaker="Male Splicer",Name="vo_S_3_Bw_FixEmGood")
	Subtitles[388]=(Text="You die here and now, Parasite!",Speaker="Doctor Grossman",Name="vo_S_3_Dg_DieHere")
	Subtitles[389]=(Text="Crush the Parasite!",Speaker="Doctor Grossman",Name="vo_S_3_Dg_Crush")
	Subtitles[390]=(Text="For Christ's sake, how long is that damn vector gonna take to cook?",Speaker="Atlas",Name="vo_R_3_At_AmbushProgress")
	Subtitles[391]=(Text="What was that? Is the vector ready? What are you waiting for? Hit the damn switch!",Speaker="Atlas",Name="vo_R_3_At_FinishedMPR")
	Subtitles[392]=(Text="The switch! Hit the damn switch!",Speaker="Atlas",Name="vo_R_3_At_HurryFinishMPR")
	Subtitles[393]=(Text="Langford's office is top to tail with skin jobs. Getting back there's gonna be one hell of a mess now...",Speaker="Atlas",Name="vo_R_3_At_AmbushDied")
	Subtitles[394]=(Text="Oxygen levels normalized. All bulkhead doors now accessible.",Speaker="Announcer",Name="vo_S_3_Fa_CanLeaveF")
	Subtitles[395]=(Text="Well done, lad. Take a deep breath and enjoy it- and then head over to Rolling Hills and get the baythsphere. Next stop is Ryan's house. It's time for blood.",Speaker="Atlas",Name="vo_R_3_At_AmbushVictory")
	Subtitles[396]=(Text="Why are you so resistant to the traditional methods of separating a man from his soul? You're not CIA, are you...you belong to Atlas. The one roach I can't seem to exterminate. Don't worry. I just need time to find the proper poison.",Speaker="Andrew Ryan",Name="vo_R_3_Ry_AmbushVictory")
	Subtitles[397]=(Text="I couldn't believe how much things had changed since I left Dr. Steinman's office. It's like I don't even recognize Rapture no more. I hear they've been rounding up people in 'pollo Square... I asked Ryan how could",Speaker="Diane McClintock",Name="vo_L_3_Cf_FlavorA")
	Subtitles[398]=(Text="he do such things to innocents. He said, 'Innocents? If they haven't chosen to defend Rapture, they've chosen to side with Atlas and his bandits. So there are no innocents. There are heroes, and there are criminals.'",Speaker="Diane McClintock",Name="vo_L_3_Cf_FlavorA")
	Subtitles[399]=(Text="Seems like some poor blighters have started seeing ghosts. Ghosts! Ryan tells me it's a side effect of this plasmid business. One poor sod's",Speaker="McDonagh",Name="vo_L_3_Md_SeeingGhosts")
	Subtitles[400]=(Text="memories getting passed on to another through genetic sampling. Leaks. Lunatics. Rebellion. And now bleeding ghosts. Ain't life in Rapture grand?",Speaker="McDonagh",Name="vo_L_3_Md_SeeingGhosts")
	Subtitles[401]=(Text="There has been tremendous pressure to regulate this plasmid business. There have been side effects: blindness, insanity, death. But what use is our",Speaker="Andrew Ryan",Name="vo_L_3_Ry_FlavorB")
	Subtitles[402]=(Text="ideology if it is not tested? The market does not respond like an infant, shrieking at the first sign of displeasure. The market is patient, and we must be too.",Speaker="Andrew Ryan",Name="vo_L_3_Ry_FlavorB")
	Subtitles[403]=(Text="I believe in no God, no invisible man in the sky. But there is something more powerful than each of us, a combination of our efforts, a Great Chain of industry that unites us. But it is only when we struggle in our own",Speaker="Andrew Ryan",Name="vo_L_3_Ry_FlavorC")
	Subtitles[404]=(Text="interest that the chain pulls society in the right direction. The chain is too powerful and too mysterious for any government to guide. Any man who tells you different either has his hand in your pocket, or a pistol to your neck.",Speaker="Andrew Ryan",Name="vo_L_3_Ry_FlavorC")
	Subtitles[405]=(Text="The children with their very long needles, their tuneless songs, their ghastly errands. Their ghoulish, Frankenstein fathers. But, we've all placed our hand on the Great Chain of endeavor. My hand is on it,",Speaker="Andrew Ryan",Name="vo_L_3_Ry_FlavorD")
	Subtitles[406]=(Text="Fontaine's is on it- We all pull it and are pulled by it. Yes, these children are an abomination. But it is not my hand alone on the chain that created them. No. Their little fingers were right there, next to mine.",Speaker="Andrew Ryan",Name="vo_L_3_Ry_FlavorD")
	Subtitles[407]=(Text="Doctor Suchong, frankly, I'm shocked by your proposal. If we were to modify the structure of our commercial plasmid line as you propose, to have them make the user vulnerable to mental suggestion",Speaker="Andrew Ryan",Name="vo_L_3_Ry_MindControlBadGood")
	Subtitles[408]=(Text="through pheromones, would we not be able to effectively control the actions of the citizens of Rapture? Free will is the cornerstone of this city. The thought of sacrificing it is abhorrent.",Speaker="Andrew Ryan",Name="vo_L_3_Ry_MindControlBadGood")
	Subtitles[409]=(Text="However...we are indeed in a time of war. If Atlas and his bandits have their way, will they not turn us into slaves? And what will become of free will then? Desperate times call for desperate measures.",Speaker="Andrew Ryan",Name="vo_L_3_Ry_MindControlBadGood")
	Subtitles[410]=(Text="Gregory, don't come whining to me about market forces. And don't expect me to punish citizens for showing a little initiative. If you don't like what Fontaine is doing, well, I suggest you find a way to offer a better product.",Speaker="Andrew Ryan",Name="vo_L_3_Ry_FlavorE")
	Subtitles[411]=(Text="All citizens are reminded that public gatherings of more than four people now require a permit. Gathering Permits can be obtained from 9-10 AM at the Permitting counter in Central Administration.",Speaker="Andrew Ryan",Name="vo_PA_3_Ry_FlavorG")
	Subtitles[412]=(Text="The augmentation procedure is a success. The slugs alone could not provide enough Adam for serious work. But combined with the host...now we have something. The slug is embedded in the lining of the host's stomach and after the host feeds we",Speaker="Tenenbaum",Name="vo_L_3_Tn_TenStoryA")
	Subtitles[413]=(Text="induce regurgitation, and then we have twenty, thirty times yield of usable Adam. The problem now is the shortage of hosts. Fontaine says, 'Patience, Tenenbaum. Soon the first home for Little Sisters will open, and that problem will be solved...",Speaker="Tenenbaum",Name="vo_L_3_Tn_TenStoryA")
	Subtitles[414]=(Text="What makes something like me? I look at genes all day long, and never do I see the blueprint of sin. I could blame the Germans, but in truth, I did not find tormentors in the",Speaker="Tenenbaum",Name="vo_L_3_Tn_TenStoryB")
	Subtitles[415]=(Text="Prison Camp, but kindred spirits. These children I brutalized have awoken something inside that for most is beautiful and natural, but in me, is an abomination...my maternal instinct.",Speaker="Tenenbaum",Name="vo_L_3_Tn_TenStoryB")
	Subtitles[416]=(Text="One of the children came and sat in my lap. I push her off, I shout, 'Get away from me!' I can see the Adam oozing out of the corner of her mouth, thick and green. Her filthy hair hanging in her face,",Speaker="Tenenbaum",Name="vo_L_3_Tn_TenStoryC")
	Subtitles[417]=(Text="dirty clothes, and that dead glow in her eye... I feel ...hatred, like I never felt before, in my chest. Bitter, burning, fury. I can barely breathe. And suddenly, I know, it is not this child I hate.",Speaker="Tenenbaum",Name="vo_L_3_Tn_TenStoryC")
	Subtitles[418]=(Text="The children must remain functional to be effective producers of Adam. I had hoped we place them into vegetative state, so they would be more pliable. I find being around them very",Speaker="Tenenbaum",Name="vo_L_3_Tn_TenStoryD")
	Subtitles[419]=(Text="uncomfortable. Even with those things implanted in their bellies, they are still children. They play, and sing. Sometimes they look at me, and they don't stop. Sometimes they smile.",Speaker="Tenenbaum",Name="vo_L_3_Tn_TenStoryD")
	Subtitles[420]=(Text="Adam acts like a benign cancer, destroying native cells and replacing them with unstable stem versions. While this very instability is what gives it its amazing properties, it is also what causes the",Speaker="Tenenbaum",Name="vo_L_3_Tn_AdamExplanation")
	Subtitles[421]=(Text="cosmetic and mental damage. You need more and more Adam just to keep back the tide. From a medical standpoint, this is catastrophic. From a business standpoint, well...Fontaine sees the possibilities...",Speaker="Tenenbaum",Name="vo_L_3_Tn_AdamExplanation")
	Subtitles[422]=(Text="You're almost there. The sphere to Ryan is up on ahead.",Speaker="Atlas",Name="vo_R_4_At_GoToEng")
	Subtitles[423]=(Text="Ryan's handed the keys to Fort Frolic over to a guy named Sander Cohen. Cohen's an artist, says some. He's a Section Eight, says I.",Speaker="Atlas",Name="vo_R_4_At_FortFrolic")
	Subtitles[424]=(Text="I've seen all kinds of cutthroats, freaks, and hard cases in my life...but Cohen, he's a real lunatic, a dyed in the wool psychopath...",Speaker="Atlas",Name="vo_R_4_At_FortFrolic")
	Subtitles[425]=(Text="Ah, that's better...Atlas, Ryan, Atlas, Ryan, duh duh duh, duh duh dudg... Time was you could get something decent on the radio. The",Speaker="Sander Cohen",Name="vo_R_4_Co_ThatsBetter")
	Subtitles[426]=(Text="artist has a duty to seduce the ear and delight the spirit ...so say goodbye to those two blowhards and hello, to an evening with Sander Cohen!",Speaker="Sander Cohen",Name="vo_R_4_Co_ThatsBetter")
	Subtitles[427]=(Text="Now, I haven't seen a sign of real life down here in months. Let's see if you're just another Johnny come lately...or maybe something more delicious...",Speaker="Sander Cohen",Name="vo_R_4_Co_NewBlood")
	Subtitles[428]=(Text="Nicely done. Where did you study?",Speaker="Sander Cohen",Name="vo_R_4_Co_FirstAmbush")
	Subtitles[429]=(Text="Ohhh, I can smell the malt vinegar in this one. I've waited so long for something tasty to come to this little burg, but all that pass are yokels and rubes...Where are my manners? Come in! Come in!!! Sander Cohen awaits you...at the Fleet Hall!!!",Speaker="Sander Cohen",Name="vo_R_4_Co_ComeIn")
	Subtitles[430]=(Text="WELCOME - to - Fort - Frolic!",Speaker="Sander Cohen",Name="vo_R_4_Co_Welcome")
	Subtitles[431]=(Text="Nobody allowed backstage prior to showtime, little moth. Fidgety, fidgety, fidgety, fidgety...",Speaker="Sander Cohen",Name="vo_R_4_Co_BeforeShowtime")
	Subtitles[432]=(Text="No need to thank me for jamming the transmissions of those boors Atlas and Ryan. Let them have their squabble. The artist, yes, the artist knows there is richer earth to till...",Speaker="Sander Cohen",Name="vo_R_4_Co_NoDistractions")
	Subtitles[433]=(Text="For example, I test you, little moth, but for a reason. I test all my disciples. Some shine like galaxies..and some...some burn like a moth at the flame! Come now...into my home.",Speaker="Sander Cohen",Name="vo_R_4_Co_TheaterAmbush")
	Subtitles[434]=(Text="The artist swims in a lake of pain. Sometimes he evolves into something magnificent, sometimes he drowns.",Speaker="Sander Cohen",Name="vo_R_4_Co_PathIsPain")
	Subtitles[435]=(Text="For example.",Speaker="Sander Cohen",Name="vo_R_4_Co_ForExample")
	Subtitles[436]=(Text="What an outstanding display of athleticism!",Speaker="Sander Cohen",Name="vo_R_4_Co_NiceJump")
	Subtitles[437]=(Text="No! No! No!",Speaker="Sander Cohen",Name="vo_R_4_Co_PianoFupOne")
	Subtitles[438]=(Text="Mr. Cohen, please...",Speaker="Fitzpatrick",Name="vo_S_4_Pg_BegOne")
	Subtitles[439]=(Text="SILENCE!!!",Speaker="Sander Cohen",Name="vo_S_4_Co_Silence")
	Subtitles[440]=(Text="Allegro...Allegro!",Speaker="Sander Cohen",Name="vo_R_4_Co_PianoFupTwo")
	Subtitles[441]=(Text="Da, Da, Da, Da Da DA, Presto...Presto!!! NO!!! No!!!",Speaker="Sander Cohen",Name="vo_R_4_Co_PianoFupThree")
	Subtitles[442]=(Text="I'm trying...Please....!",Speaker="Fitzpatrick",Name="vo_S_4_Pg_BegThree")
	Subtitles[443]=(Text="Once again, young Fitzpatrick.",Speaker="Sander Cohen",Name="vo_S_4_Co_PlayFitz")
	Subtitles[444]=(Text="Dum, DUM, DAH DAH! NO NO!!!",Speaker="Sander Cohen",Name="vo_S_4_Co_PianoFupFour")
	Subtitles[445]=(Text="Oh Cohen, you sick fuck!!! Let me out of this...",Speaker="Fitzpatrick",Name="vo_S_4_Pg_BegTwo")
	Subtitles[446]=(Text="Oh, that was quicker than I hoped...",Speaker="Sander Cohen",Name="vo_R_4_Co_Quicker")
	Subtitles[447]=(Text="Come down now, little moth. Life, death...the burden of the artist is to... capture!",Speaker="Sander Cohen",Name="vo_R_4_Co_BurdenToCapture")
	Subtitles[448]=(Text="See young Fitzpatrick here on the stage... Use your camera...take him as he is now...so I may remember him...",Speaker="Sander Cohen",Name="vo_R_4_Co_TakePicFitzOne")
	Subtitles[449]=(Text="What are you waiting for? Fitzpatrick can't hold that pose forever!",Speaker="Sander Cohen",Name="vo_R_4_Co_TakePicFitzTwo")
	Subtitles[450]=(Text="And now you've got Fitzpatrick, caught in his moment of glory. It seems you've got the eye of the shutterbug, little moth! Now head to the atrium and place his photograph in my masterpiece...and so our collaboration commences.",Speaker="Sander Cohen",Name="vo_R_4_Co_CaughtInGlory")
	Subtitles[451]=(Text="I know why you've come, little moth. You've your own canvas, one you'll paint with the blood of a man I once loved...Yes, I'll send you to",Speaker="Sander Cohen",Name="vo_R_4_Co_FindFriends")
	Subtitles[452]=(Text="Ryan, but first you must be part of my masterpiece. Go to the atrium. Hurry now...my muse is a fickle bitch with a very short attention span...",Speaker="Sander Cohen",Name="vo_R_4_Co_FindFriends")
	Subtitles[453]=(Text="Watch yourself, you clumsy sow...that's...my...work!",Speaker="Sander Cohen",Name="vo_S_4_Co_WhatYourself")
	Subtitles[454]=(Text="Do you see it? When I am dust, this is what they'll point to! My quadtych! My masterpiece. Go ahead, don't be afraid, touch it...",Speaker="Sander Cohen",Name="vo_R_4_Co_UploadPicFitz")
	Subtitles[455]=(Text="Yes, and there's Fitzpatrick, freed of his own kinks and defects. And here's the glorious news... this is just the moment of conception... out in this place, there are three men, all former disciples of",Speaker="Sander Cohen",Name="vo_R_4_Co_FindThem")
	Subtitles[456]=(Text="mine, all connected by a common thread... betrayal. Find them, little moth, and immortalize their mortality in my quadtych. Go. Once they've been sent to their reward, you shall go to yours... and to Ryan...",Speaker="Sander Cohen",Name="vo_R_4_Co_FindThem")
	Subtitles[457]=(Text="The door to Poseidon Plaza is now open for you, my moth.",Speaker="Sander Cohen",Name="vo_R_4_Co_DoorOpenA")
	Subtitles[458]=(Text="Could you possibly think I would meet with my public now? When I'm preparing? Unbelievable!",Speaker="Sander Cohen",Name="vo_R_4_Co_RejectFans")
	Subtitles[459]=(Text="You'll find Finnegan in cold storage. I discovered him in Marseilles in 1937. He admired my painting. I admired his...carriage. He was",Speaker="Sander Cohen",Name="vo_R_4_Co_LocOfFinnegan")
	Subtitles[460]=(Text="the first of my disciples to bite the hand. Kill him any way you fancy, but I'd prefer it if you could involve burning in some fashion.",Speaker="Sander Cohen",Name="vo_R_4_Co_LocOfFinnegan")
	Subtitles[461]=(Text="Rapture's going to hell, and why? Because of them...always behind the scenes. At the Lyceum, at the galleries in SoHo, even down here, in this so-called-Utopia. The Doubters. But Ryan understands. We're",Speaker="Sander Cohen",Name="vo_L_4_Co_GoingToHell")
	Subtitles[462]=(Text="simpatico... Yes, there's blood in the streets. Yes, people sometimes...disappear. And those awful little girls...Well, I suppose the Doubters think you can paint a picture without soiling your smock...",Speaker="Sander Cohen",Name="vo_L_4_Co_GoingToHell")
	Subtitles[463]=(Text="Vandalism is a serious crime. Remember: vandals are Parasites.",Speaker="Announcer",Name="vo_S_4_Fa_Vandalism")
	Subtitles[464]=(Text="Well, if it isn't the long lost Andrew Ryan. Come here, tiger...",Speaker="Jasmine Jolene",Name="vo_S_4_Jj_HereTiger")
	Subtitles[465]=(Text="I thought you had forgotten about poor Jasmine. But I'm so glad you didn't.",Speaker="Jasmine Jolene",Name="vo_S_4_Jj_ForgotJasmine")
	Subtitles[466]=(Text="I'm sorry, Mr. Ryan, I didn't know...I didn't know Fontaine had something to do with it...I...wha- What are you doing? No, no don't, please! I loved you don't, don't please... No! No!!",Speaker="Jasmine Jolene",Name="vo_S_4_Jj_DidntKnow")
	Subtitles[467]=(Text="That creepy Dr. Tenenbaum promised me it wasn't gonna be a real pregnancy, they'd just take the egg out once Mr. Ryan and I had...I needed the",Speaker="Jasmine Jolene",Name="vo_L_4_Jj_Pregnancy")
	Subtitles[468]=(Text="money so bad...But I know Mr. Ryan's gonna suss it out, gonna know I wasn't being careful...gonna know I sold the...Mr. Ryan's gonna be so mad at me...",Speaker="Jasmine Jolene",Name="vo_L_4_Jj_Pregnancy")
	Subtitles[469]=(Text="You know what? Art...music...poetry...It's all grift. Cohen's got Ryan wrapped around his lil' pinky...and why? Because he tells him what he wants to hear.",Speaker="Rodriguez",Name="vo_L_4_Pq_Art")
	Subtitles[470]=(Text="'Rise, Rapture, Rise!' Nuts! That stuff was stale before it came out Cohen's pen. I'm through with the whole pinata. Let's see that old fruit try an' keep me here...",Speaker="Rodriguez",Name="vo_L_4_Pq_Art")
	Subtitles[471]=(Text="How about some fucking SERVICE around here?!?!",Speaker="Rodriguez",Name="vo_S_4_Pq_Service")
	Subtitles[472]=(Text="The things that man had me do...fuck you.",Speaker="Rodriguez",Name="vo_S_4_Pq_HadToDo")
	Subtitles[473]=(Text="Who does he think he is?",Speaker="Rodriguez",Name="vo_S_4_Pq_Who")
	Subtitles[474]=(Text="Maybe I'll just, y'know, do something?",Speaker="Rodriguez",Name="vo_S_4_Pq_Something")
	Subtitles[475]=(Text="He was a lout. But he was vigorous. Get the photo before he completely dries up.",Speaker="Sander Cohen",Name="vo_R_4_Co_DoneB")
	Subtitles[476]=(Text="That was bracing. Take a photo of him, and place it in the quadtych. I'm feeling full, like an expectant mama.",Speaker="Sander Cohen",Name="vo_R_4_Co_TakePicRod")
	Subtitles[477]=(Text="You think you gonna finish me in here, you old fruit? The other saps you tossed in this meat locker all panicked like rabbits. I just watched and waited. And when they started to kick, I started",Speaker="Martin Finnegan",Name="vo_L_4_Po_Hallucination")
	Subtitles[478]=(Text="to scavenge. Made myself a little splicer cocktail I did. If you can't come in from the cold, then you gotta grow ice over your heart. And the iceman cometh, Sander baby. The iceman fucking cometh.",Speaker="Martin Finnegan",Name="vo_L_4_Po_Hallucination")
	Subtitles[479]=(Text="Guess the old grape finally sent someone!",Speaker="Martin Finnegan",Name="vo_S_4_Po_StayAway")
	Subtitles[480]=(Text="Son of a bitch left me to freeze...",Speaker="Martin Finnegan",Name="vo_S_4_Po_WelcomeRapture")
	Subtitles[481]=(Text="Take a good look, friend...you're looking at your future.",Speaker="Martin Finnegan",Name="vo_S_4_Po_GoAfterCohen")
	Subtitles[482]=(Text="I can see your breath!",Speaker="Martin Finnegan",Name="vo_S_4_Po_WrongIdea")
	Subtitles[483]=(Text="I've got a pose all picked out for you...",Speaker="Martin Finnegan",Name="vo_S_4_Po_NiceGuy")
	Subtitles[484]=(Text="He was a nasty one...and my favorite. But I think I like him better this way. Take his damn photo, chop chop.",Speaker="Sander Cohen",Name="vo_R_4_Co_DoneA")
	Subtitles[485]=(Text="You wanna lock us in, old man? Oh, that's fine with Cobbsie. I used to love you. I used you to think you were a musical genius. You know",Speaker="Cobb",Name="vo_L_4_Pr_GoRecordStore")
	Subtitles[486]=(Text="why? Because you paid my rent, you ancient hack! Come on to the record store, I'll show you what I think of your plinkity, plink, plink!",Speaker="Cobb",Name="vo_L_4_Pr_GoRecordStore")
	Subtitles[487]=(Text="My collection's almost complete. Then we'll see who the REAL artist is down here.",Speaker="Cobb",Name="vo_S_4_Pr_Collection")
	Subtitles[488]=(Text="It's all a game, errand boy! Cohen, Ryan! Two old birds pulling on each others milk sticks!",Speaker="Cobb",Name="vo_S_4_Pr_FuckingHack")
	Subtitles[489]=(Text="If the fruitcake wants me on the slab, why didn't he send someone with teeth?",Speaker="Cobb",Name="vo_S_4_Pr_NotKillingMe")
	Subtitles[490]=(Text="My kittens! You murdered my kittens!",Speaker="Cobb",Name="vo_S_4_Pr_Revolucion")
	Subtitles[491]=(Text="Spend a little time with my kittens, sugar!",Speaker="Cobb",Name="vo_S_4_Pr_VitaBrevis")
	Subtitles[492]=(Text="Yaaaarrgghh!",Speaker="Cobb",Name="vo_S_4_Pr_Yarg")
	Subtitles[493]=(Text="You Cohen's messenger boy? I've got something for that crow!",Speaker="Cobb",Name="vo_S_4_Pr_GoToHell")
	Subtitles[494]=(Text="Tell the old crow his music cooks better than it sounds!",Speaker="Cobb",Name="vo_S_4_Pr_LikeThat")
	Subtitles[495]=(Text="You flutter all around the Fort, taking life as you go. You're not a moth...you're an angel. I've never painted an angel...maybe I should....",Speaker="Sander Cohen",Name="vo_R_4_Co_TakingLives")
	Subtitles[496]=(Text="Yes! Now put the picture in the frame! Let's see what we've got here!",Speaker="Sander Cohen",Name="vo_R_4_Co_UploadFin")
	Subtitles[497]=(Text="It's coming together...yes...but there will always be Doubters. You don't doubt me, do you? I could never stomach Doubters.",Speaker="Sander Cohen",Name="vo_R_4_Co_Doubters")
	Subtitles[498]=(Text="That's three of four...what's that look- you don't like it, do you? I don't need to be judged by you...by anyone...screw you! Screw all you fucking Doubters!!! Here's what I say to all of you!!!!",Speaker="Sander Cohen",Name="vo_R_4_Co_ThreeOfFour")
	Subtitles[499]=(Text="Smile! SMILE!",Speaker="Sander Cohen",Name="vo_R_4_Co_Smile")
	Subtitles[500]=(Text="Ha ha ha!",Speaker="Sander Cohen",Name="vo_R_4_Co_Laughing")
	Subtitles[501]=(Text="Prepare the plaster cast, he'll make a fine addition to the collection...",Speaker="Sander Cohen",Name="vo_R_4_Co_Plastercast")
	Subtitles[502]=(Text="Go on, RUN!",Speaker="Sander Cohen",Name="vo_R_4_Co_GoOnRun")
	Subtitles[503]=(Text="Fly away, little moth! Fly!",Speaker="Sander Cohen",Name="vo_R_4_Co_FlyLittleMoth")
	Subtitles[504]=(Text="I'm sorry for that outburst. You'll have to forgive an old fool his artistic temperament. The birth is so close now... the labor pains can blur the judgement, and drive the passions of even the finest spirits...",Speaker="Sander Cohen",Name="vo_R_4_Co_SorryForOutburst")
	Subtitles[505]=(Text="It...is...accomplished...",Speaker="Sander Cohen",Name="vo_S_4_Co_Done")
	Subtitles[506]=(Text="Let me see it...",Speaker="Sander Cohen",Name="vo_S_4_Co_LetMeSee")
	Subtitles[507]=(Text="My god, my god, my god, my god, my god, my god...It's...",Speaker="Sander Cohen",Name="vo_S_4_Co_MyGod")
	Subtitles[508]=(Text="You'll find your path to Ryan is now clear. Tell him Sander said hello. Oh yes, you may avail yourself upon one of my lesser works as a token of our time together. If you",Speaker="Sander Cohen",Name="vo_S_4_Co_PathClear")
	Subtitles[509]=(Text="had become my one and true disciple, you might have been worthy of seeing inside the box of my most private muse...but who knows if that man is yet even born? Now...go!",Speaker="Sander Cohen",Name="vo_S_4_Co_PathClear")
	Subtitles[510]=(Text="Go.",Speaker="Sander Cohen",Name="vo_S_4_Co_Go")
	Subtitles[511]=(Text="What happened to you? I've been trying to raise you for a dog's age. Never mind. Would you kindly leg it over to the 'sphere and get on down to Hephaestus? It's time to settle up with Ryan.",Speaker="Atlas",Name="vo_R_4_At_AtlasRun")
	Subtitles[512]=(Text="Stood up! Again...Second time this week. Ever since my face was...Steinman worked on me, but it was never the same since the blast... Being alone so much gives a girl time to think.",Speaker="Diane McClintock",Name="vo_L_4_Cf_StoodUp")
	Subtitles[513]=(Text="Who could hate me so much they'd ruin me like this? What did I do to them? I keep thinking of all them bandits and terrorists Ryan's got locked up in 'pollo Square and I get so",Speaker="Diane McClintock",Name="vo_L_4_Cf_StoodUp")
	Subtitles[514]=(Text="mad...sometimes I can hardly breathe...If I could only confront them, tell them what they did to me, how they're ruining everything for me, for Rapture...maybe I'd...well, maybe I'd feel better.",Speaker="Diane McClintock",Name="vo_L_4_Cf_StoodUp")
	Subtitles[515]=(Text="I could have been the toast of Broadway, the talk of Hollywood. But, instead, I followed you to this soggy bucket. When you needed my star light,",Speaker="Sander Cohen",Name="vo_L_4_Co_CohenToastBroadway")
	Subtitles[516]=(Text="I illuminated you. But now I rot, waiting for an audience that doesn't...ever...come...I'm writing something for you, Andrew Ryan...it's a requiem.",Speaker="Sander Cohen",Name="vo_L_4_Co_CohenToastBroadway")
	Subtitles[517]=(Text="I worked the meatball beat in Little Italy, and even I'm shocked at the cold blood that oozes out of these artistic types. This broad Culpepper and that fruitjob Cohen are in some",Speaker="Sullivan",Name="vo_L_4_Pd_MeatballBeat")
	Subtitles[518]=(Text="kind of feud, and Cohen's lookin' for MY security detail to pick sides. The next thing I know I get called into Ryan's office to talk about the whole mess. Goddamn nutjob artist.",Speaker="Sullivan",Name="vo_L_4_Pd_MeatballBeat")
	Subtitles[519]=(Text="I just got the word to put the bump on Anna Culpepper. This isn't some gangster or hard-nosed political operative. We're talking about a dizzy twist what wrote a song or two that got under Ryan's wig.",Speaker="Sullivan",Name="vo_L_4_Pd_BumpCulpepper")
	Subtitles[520]=(Text="Regarding your review of Anna Culpepper's latest musical insult: Of all of the worthy artists in Rapture, why you continue to devote column inches to this",Speaker="Sander Cohen",Name="vo_L_4_Co_MusicalInsult")
	Subtitles[521]=(Text="musical gremlin is beyond my imagination. Where she is not derivative, she's boring. Where she's not boring, she's obvious. Where she's not obvious, she's dangerous.",Speaker="Sander Cohen",Name="vo_L_4_Co_MusicalInsult")
	Subtitles[522]=(Text="Some hired Betty tried to sell me on those fancy Oxford Club ciggies. Mmm- no thanks. I told her, I'm a Nico Time man, always will be. Why? They smoke good, and don't cost half a damn. Who cares if the things are made out of sea shells and fish eggs?",Speaker="Albert Milonakis",Name="vo_L_4_Al_FancyCiggies")
	Subtitles[523]=(Text="Cohen's not a musician. He's Ryan's stable boy. Ryan's corrupt policies crap all over the place, and Cohen flutters around clearing it up. But instead of using a shovel, like",Speaker="Anna Culpepper",Name="vo_L_4_Ac_StableBoy")
	Subtitles[524]=(Text="you would with a proper mule, Cohen tidies with a catchy melody and a clever turn of phrase. But no matter how nicely it sounds, he can't really do anything about the smell...",Speaker="Anna Culpepper",Name="vo_L_4_Ac_StableBoy")
	Subtitles[525]=(Text="The Wild Bunny by Sander Cohen: I want to take the ears off, but I can't. I hop, and when I hop, I never get off the ground. It's my curse, my",Speaker="Sander Cohen",Name="vo_L_4_Co_TakeTheEarsOff")
	Subtitles[526]=(Text="eternal curse! I want to take the ears off but I can't! It's my curse! It's my fucking curse! I want to take the ears off! Please! Take them off! Please!",Speaker="Sander Cohen",Name="vo_L_4_Co_TakeTheEarsOff")
	Subtitles[527]=(Text="Watch yourself. Ryan's stirring. We best keep to our knitting.",Speaker="Atlas",Name="vo_R_5_At_EnterDeckA")
	Subtitles[528]=(Text="I see Cohen's lost his touch. If you knew him when...when he used to believe in the work... in the struggle. And now, he rots in that never-land, waiting for someone to come and tell him he's still got it. I suppose that's why he let you live.",Speaker="Andrew Ryan",Name="vo_R_5_Ry_EnterDeckA")
	Subtitles[529]=(Text="Is there anything you won't trade for another breath, parasite? Dignity? Honor? Your own identity? You've come to rob my city, but in",Speaker="Andrew Ryan",Name="vo_R_5_Ry_EnterDeckB")
	Subtitles[530]=(Text="your absence, I've studied up on you. And I wondered if there was something I could take from you. And now I know just what it is...",Speaker="Andrew Ryan",Name="vo_R_5_Ry_EnterDeckB")
	Subtitles[531]=(Text="It's time to either run the table or go home empty. Ryan's got the genetic key to Rapture, we get that from him and we get out of this hellhole. We don't, then you and I are ghosts.",Speaker="Atlas",Name="vo_R_5_At_EnterDeckB")
	Subtitles[532]=(Text="Now would you kindly head to Ryan's office and kill the son of a bitch...it's time to finish this.",Speaker="Atlas",Name="vo_R_5_At_EnterDeckC")
	Subtitles[533]=(Text="I spent the afternoon trying to get as close to Ryan's gate as possible without making a spectacle of myself...He's got it shielded six ways till Easter. There's no way into that",Speaker="Kyburz",Name="vo_L_5_Pv_ScopeGate")
	Subtitles[534]=(Text="place. All I got for my trouble was the hairy eyeball from Ryan's splicer mates. That's the reward you get for trying to outsmart the best electrical engineer of our generation.",Speaker="Kyburz",Name="vo_L_5_Pv_ScopeGate")
	Subtitles[535]=(Text="You can taste it, can't you? Andrew Ryan!",Speaker="Andrew Ryan",Name="vo_R_5_Ry_AtTheGates_partA")
	Subtitles[536]=(Text="A worm looks up and sees the face of God! But look around...it's a regular convention of worms in here. They all had mothers, fathers, people who loved them. They",Speaker="Andrew Ryan",Name="vo_R_5_Ry_AtTheGates_PartB")
	Subtitles[537]=(Text="got married, fucked their wives. What makes you think you're any different? I haven't chosen a spot for you on the wall yet...let me know if you have a preference.",Speaker="Andrew Ryan",Name="vo_R_5_Ry_AtTheGates_PartB")
	Subtitles[538]=(Text="Oh do fire away! That's bound to succeed this time. To think of the effort that was put into creating you...how little they got for their money!",Speaker="Andrew Ryan",Name="vo_R_5_Ry_FireAway")
	Subtitles[539]=(Text="Rapture is coming back to life. Even now, can't you hear the breath returning to her lungs? The shops re-opening, the schools humming with",Speaker="Andrew Ryan",Name="vo_R_5_Ry_AtTheCore")
	Subtitles[540]=(Text="the thoughts of young minds? My city will live, my city will thrive. And when that day comes, we'll use your tombstone for paving tiles.",Speaker="Andrew Ryan",Name="vo_R_5_Ry_AtTheCore")
	Subtitles[541]=(Text="I had to go jungle-style with that filthy ape for three weeks, but he finally spilled the beans on how to get to Andrew Ryan. Generate a sympathetic overload in Harmonic Core #3. That's simple. Now all I gotta do is figure out what the hell a",Speaker="Anya Andersdotter",Name="vo_L_5_Pt_GoToHeatLoss")
	Subtitles[542]=(Text="sympathetic overload is, and for that matter, a Harmonic Core #3! Piece of cake for an electrical engineer. Too bad I design lady's shoes. Gonna go see the grease monkeys left alive in Heat Loss monitoring, see what I can shake out of their trees.",Speaker="Anya Andersdotter",Name="vo_L_5_Pt_GoToHeatLoss")
	Subtitles[543]=(Text="Me. An assassin...that's rich. I could have gone along, I suppose. Spliced up, forgot. I believed in this place. I believed in Ryan. But when it got hard, Ryan didn't believe in Rapture, didn't",Speaker="Anya Andersdotter",Name="vo_L_5_Pt_Assassin")
	Subtitles[544]=(Text="believe in the Great Chain. He believed in power. And now this place is busto. And my girl is...gone...worse than gone...one of those ...things. So am I an assassin? ...Well, only one way to find out.",Speaker="Anya Andersdotter",Name="vo_L_5_Pt_Assassin")
	Subtitles[545]=(Text="Is there blood in the streets? Of course. Have some chosen to destroy themselves with careless splicing? Undeniable. But I will make no proclamations, I will dictate no laws. The Great",Speaker="Andrew Ryan",Name="vo_L_5_Ry_OnRaptureA")
	Subtitles[546]=(Text="Chain moves slowly, but with wisdom. It is our impatience that invites in the Parasite of big government. And once you've invited it in, it will never stop feeding on the body of the city.",Speaker="Andrew Ryan",Name="vo_L_5_Ry_OnRaptureA")
	Subtitles[547]=(Text="How like all Parasites who ever tried to walk in stolen shoes. I'd explain the science that renders what you're trying to do impossible. But that would be like playing Mozart for a tree frog.",Speaker="Andrew Ryan",Name="vo_R_5_Ry_NearGeoQuest")
	Subtitles[548]=(Text="What is the difference between a man and a parasite? A man builds. A parasite asks 'Where is my share?' A man creates. A",Speaker="Andrew Ryan",Name="vo_L_5_Ry_Difference")
	Subtitles[549]=(Text="parasite says, 'What will the neighbors think?' A man invents. A parasite says, 'Watch out, or you might tread on the toes of God...'",Speaker="Andrew Ryan",Name="vo_L_5_Ry_Difference")
	Subtitles[550]=(Text="Imagine the will it took to create a place like this. And what have you built? Nothing, you can only loot, and break. You're not a man...you're just a termite at Versailles.",Speaker="Andrew Ryan",Name="vo_R_5_Ry_OnRaptureB")
	Subtitles[551]=(Text="To build a city at the bottom of the sea! Insanity. But where else could we be free from the clutching hand of the Parasites? Where else could we build an economy that they",Speaker="Andrew Ryan",Name="vo_L_5_Ry_WhereElse")
	Subtitles[552]=(Text="would not try to control, a society that they would not try to destroy? It was not impossible to build Rapture at the bottom of the sea. It was impossible to build it anywhere else.",Speaker="Andrew Ryan",Name="vo_L_5_Ry_WhereElse")
	Subtitles[553]=(Text="Before the final rat has eaten the last gram of you, Rapture will have returned. I will lead a parade. Who was that, they'll say, as they point to the sad shape hanging on my wall. Who was that?",Speaker="Andrew Ryan",Name="vo_R_5_Ry_OnRaptureC")
	Subtitles[554]=(Text="So far away from your family, from your friends, from everything you ever loved. But for some reason, you like it here...you",Speaker="Andrew Ryan",Name="vo_R_5_Ry_OnRaptureD")
	Subtitles[555]=(Text="feel something, you can't quite put your finger on...think about it for a second, and maybe the word will come to you: nostalgia...",Speaker="Andrew Ryan",Name="vo_R_5_Ry_OnRaptureD")
	Subtitles[556]=(Text="A man builds a city at the bottom of the sea. That's a marvel. Another man happens to be on a plane that crash lands on the same city in the middle of the ocean. Why...that sounds more like...a miracle.",Speaker="Andrew Ryan",Name="vo_R_5_Ry_OnRaptureE")
	Subtitles[557]=(Text="What did Atlas offer you? A piece of my plundered city? Mark my words- your only reward will be a knife in the back.",Speaker="Andrew Ryan",Name="vo_R_5_Ry_OnRaptureG")
	Subtitles[558]=(Text="Though my physical defenses fall, you'll not defeat me. My strength is not in steel and fire, but in my intellect and will. You hear me, Atlas!? Andrew Ryan offers you nothing but ashes!",Speaker="Andrew Ryan",Name="vo_R_5_Ry_OnRaptureH")
	Subtitles[559]=(Text="In the end, all that matters to me - is me. And all that matters to you - is you. It is the nature of things.",Speaker="Andrew Ryan",Name="vo_R_5_Ry_OnRaptureF")
	Subtitles[560]=(Text="I didn't recognize the twist that come into the shop today... Stacked like Sally and dressed to the nines. She's play her cards pretty close to the vest, but you ain't gotta be no college yob to see that she's into some bad china. She was",Speaker="Pablo Navarro",Name="vo_L_5_Pu_BombLocation")
	Subtitles[561]=(Text="asking about magnetic locks, and some such. I played it coy, but she took wise. After she showed me 'round her backyard, I gave her directions to Kyburz' tool shop. Rapture's gone to hell, but sometimes the Great Chain still cuts you a break.",Speaker="Pablo Navarro",Name="vo_L_5_Pu_BombLocation")
	Subtitles[562]=(Text="Ryan's splicers are dragging the young woman off right now. I'm certain she's one of Ryan's spies, sent to feel me out...I think she is...If I'm wrong, an",Speaker="Kyburz",Name="vo_L_5_Pv_AlmostFinished")
	Subtitles[563]=(Text="innocent girl'll end up on Ryan's bloody trophy wall. If I'm right...well, I best be right. The device is almost finished. I can't get soft now, I can't!",Speaker="Kyburz",Name="vo_L_5_Pv_AlmostFinished")
	Subtitles[564]=(Text="What a barmy dream...some kind of fruit tree, spinning like a top, and it was pouring juice down Ryan's throat, choking the bastard. But it wasn't a tree, really, when I looked closer, it was the core",Speaker="Kyburz",Name="vo_L_5_Pv_Dream")
	Subtitles[565]=(Text="control, the gizmo that feeds the mag locks on Ryan's gate. You can't cut off the power, comes right from the volcanic vents...Ryan always gets his juice. But I suppose you could drown the son of a bitch in it...",Speaker="Kyburz",Name="vo_L_5_Pv_Dream")
	Subtitles[566]=(Text="The basic casing is ready. I've got one charge of nitroglycerin in my office, that will serve as a catalyst. Now I need four R-34 lead shield wire stubs to pass the circuit. Then a half-can of Ionic Gel - that's the pretty Betty",Speaker="Kyburz",Name="vo_L_5_Pv_BombRecipe")
	Subtitles[567]=(Text="of the mix. Should send the core into compensation mode, push power down the line and trigger the circuit breaker on Ryan's gate. That's the theory. It'll either work like a charm, or blow up half of Rapture. Nothing ventured...",Speaker="Kyburz",Name="vo_L_5_Pv_BombRecipe")
	Subtitles[568]=(Text="Let me tell you something about Kyburz and all them university types... they're so smart, except when they ain't. I put a couple of drinks in him last week, and before I",Speaker="Pablo Navarro",Name="vo_L_5_Pu_KyburzCodeHint")
	Subtitles[569]=(Text="could say 'boo' he's telling me he's got the code to his office keyed to the date of Australia Day. Nows every weeks, I slip in real gentle and nick a buck or two from",Speaker="Pablo Navarro",Name="vo_L_5_Pu_KyburzCodeHint")
	Subtitles[570]=(Text="the till. The Aussie never notices, and I ain't about to tell him. Seems like there's all kind of crazy stuff back there. Maybe... maybe one day I'll get more ambitious.",Speaker="Pablo Navarro",Name="vo_L_5_Pu_KyburzCodeHint")
	Subtitles[571]=(Text="Do you guys have any idea there's a war on? If you don't follow proper maintenance on those Big Daddys, they burn through those R-34s like them Eve's apple betties go through",Speaker="Pablo Navarro",Name="vo_L_5_Pu_RecipeHint")
	Subtitles[572]=(Text="penicillin. I've got Atlas' goons hitting us non-stop, and two dead mechanics just this week, we need to control costs. If I wanted to deal with amateurs, I would have stayed on dry land.",Speaker="Pablo Navarro",Name="vo_L_5_Pu_RecipeHint")
	Subtitles[573]=(Text="Looks like the ocean's got an itch to retake this corner of Rapture...this happened right after the start of the war, read about it in the papers...head on in, I'll see what I can dig up to help...",Speaker="Atlas",Name="vo_R_5_At_HeadToGeo")
	Subtitles[574]=(Text="Does it look like it's a real bomb? It better. You got to put it on the core past Geothermal Control, and we'll see if these needlenoses knew what the hell they were talking about.",Speaker="Atlas",Name="vo_R_5_At_GoToGeo")
	Subtitles[575]=(Text="I'm no engineer, but if I read these plans right, you can channel that magma flow using the Redirect Valve. It'll boil off that water",Speaker="Atlas",Name="vo_R_5_At_NearGeoQuest")
	Subtitles[576]=(Text="right quick, and you'll be able to reach the Core. But Ryan's sure to take notice- might want to set up a perimeter, just to be certain.",Speaker="Atlas",Name="vo_R_5_At_NearGeoQuest")
	Subtitles[577]=(Text="Will these creatures kill you? Even I don't know. As you drag me closer to the abyss, you pull yourself right along with me. I offer you a quick death, parasite. It will be preferable to what you will learn if you win.",Speaker="Andrew Ryan",Name="vo_R_5_Ry_GeoAmbush")
	Subtitles[578]=(Text="Are they all dead? Hope so. Best be heading on to the Core.",Speaker="Atlas",Name="vo_R_5_At_GeoVictory")
	Subtitles[579]=(Text="I'm guessing you just opened the path to Ryan. Head on back to his place, now. But you better be loaded for bear.",Speaker="Atlas",Name="vo_R_5_At_GetToRyan")
	Subtitles[580]=(Text="Christ, what a racket you're making down there. If you've surged the core, then there's only one more task to be done. Head on back to Ryan's gate and throw the circuit breaker. That'll let you right into his place.",Speaker="Atlas",Name="vo_R_5_At_DoorHint")
	Subtitles[581]=(Text="I tracked the problem that was blocking the tubes here, and you'll never believe where I ended up...the damn Farmer's Market, clear on the other end of",Speaker="Pablo Navarro",Name="vo_L_5_Pu_MarketCode")
	Subtitles[582]=(Text="Rapture. I fixed it right up and installed some new gaskets...oof, what a mess. Anyway, the code is 0512 if you ever need to get back in there to do maintenance.",Speaker="Pablo Navarro",Name="vo_L_5_Pu_MarketCode")
	Subtitles[583]=(Text="Ryan nationalized Fontaine Futuristics- he owns it now, lock, stock and barrel. For the good of the city, he says. He'll break it up in due time, he says. I've",Speaker="McDonagh",Name="vo_L_5_Md_FlavourA")
	Subtitles[584]=(Text="resigned from the council and lodged me letter of protest, but that's just pissing in the wind. It'll be war, I say...unless somebody stops Ryan and right fast.",Speaker="McDonagh",Name="vo_L_5_Md_FlavourA")
	Subtitles[585]=(Text="Strikes me that Fontaine wasn't overly inconvenienced by his own demise. On New Year's Eve, his wretched splicers came streaming out of the poor houses and stormed",Speaker="McDonagh",Name="vo_L_5_Md_FlavourB")
	Subtitles[586]=(Text="the proverbial barricades! The dead rot in the streets, and Johnny and Janey Citizen are lined up round the block for plasmids...anything to help fend off the rabble.",Speaker="McDonagh",Name="vo_L_5_Md_FlavourB")
	Subtitles[587]=(Text="I begged Mr. Ryan to hand Fontaine Futuristics over to Atlas' boys as a peace offering, but the stupid sod won't listen to reason. 'Stead he's just splicing his mob up, giving them more and",Speaker="McDonagh",Name="vo_L_5_Md_FlavourC")
	Subtitles[588]=(Text="tougher plasmids. There's an arms race on here in Rapture, but it's not about who can build the best guns and the biggest bombs. It's about who can become less of a man and more of a monster..",Speaker="McDonagh",Name="vo_L_5_Md_FlavourC")
	Subtitles[589]=(Text="I never killed a man, let alone a mate. But this is what things come to. I don't know if killing Mr. Ryan will stop the war, but I",Speaker="McDonagh",Name="vo_L_5_Md_FlavourD")
	Subtitles[590]=(Text="know it won't stop while that man breathes. I love Mr. Ryan. But I love Rapture. If I have to kill one to save the other, so be it.",Speaker="McDonagh",Name="vo_L_5_Md_FlavourD")
	Subtitles[591]=(Text="Advanced Deployment, Lot 111 Dr. Suchong/Client Fontaine Futuristics. Baby is now a year old, weighs 58 pounds, and possesses gross musculature of a fit, 19 year old. The results are disappointing, but within expected tolerances.",Speaker="Suchong",Name="vo_L_5_Sg_FlavourBaby")
	Subtitles[592]=(Text="Initial Deployment, Vita Chamber/Client Ryan Industries Stage one is complete. Sinclair and Alexander tried to explain the science to me, but Suchong does not believe them. They keep saying plasmid",Speaker="Suchong",Name="vo_L_5_Sg_VitaChamber")
	Subtitles[593]=(Text="reconstruction this and quantum entanglement that, and then poof, dead people come back to life. Bullshit! Of course, Ryan will only allow it to be tuned to his genetic frequencies for the testing...",Speaker="Suchong",Name="vo_L_5_Sg_VitaChamber")
	Subtitles[594]=(Text="Kill him, then string him up like the others!",Speaker="Male Splicer",Name="vo_S_5_Dk_StringUp")
	Subtitles[595]=(Text="(disembodied, whispered) Ahh, a present.. You like, yes?",Speaker="Female Splicer",Name="vo_S_5_Rb_Present")
	Subtitles[596]=(Text="That's right, boyos...try now to mess with me gizmos...I'll show you sticks and stones...",Speaker="Male Splicer",Name="vo_S_5_Sw_MessWithGizmos")
	Subtitles[597]=(Text="Ghost 1: The circuit breaker's over there, yeah...   Ghost 2: Why can't Ryan take care of this crap himself?   Ghost 1: Because Mr. Ryan's got more important",Speaker="Ghost Two",Name="vo_S_5_Zk_ZapSequence")
	Subtitles[598]=(Text="things to do than to enforce loyalty in the ranks...   Ghost 2: What... hey, no, don't- (screams)   Ghost 1: Say hello to Fontaine, you backstabbing son of a bitch...",Speaker="Ghost Two",Name="vo_S_5_Zk_ZapSequence")
	Subtitles[599]=(Text="Even in the book of lies, sometimes you find truth...there is indeed a season for all things. And now that I see you flesh to flesh and blood to blood, I know I cannot raise my hand against",Speaker="Andrew Ryan",Name="vo_R_5_Ry_ComeToDaddy")
	Subtitles[600]=(Text="you. But know this: you are my greatest disappointment. Does your master hear me? Atlas!? You can kill me, but you will never have my city! My strength is not in steel and fire! That is what",Speaker="Andrew Ryan",Name="vo_R_5_Ry_ComeToDaddy")
	Subtitles[601]=(Text="the parasites will never understand. A season for all things: A time to live, and a time to die. A time to build, and a time to destroy. Come now, my child. There is one final thing to discuss.",Speaker="Andrew Ryan",Name="vo_R_5_Ry_ComeToDaddy")
	Subtitles[602]=(Text="The city is experiencing a self-destruct scenario. Please standby.",Speaker="Announcer",Name="vo_S_5_Fa_SelfDestruct")
	Subtitles[603]=(Text="What?! Ryan's set the core to self destruct! This is different than what you did...He's got a mind to take down the whole damn city! Get in there and whack the chump before the whole joint blows!",Speaker="Atlas",Name="vo_R_5_At_GetInThere")
	Subtitles[604]=(Text="The assassin has overcome my final defense, and now he's come to murder me. In the end, what separates a man from a slave? Money, Power? No. A man chooses. A slave obeys. You think you have memories.",Speaker="Andrew Ryan",Name="vo_5_scripted_ryan_1A_One")
	Subtitles[605]=(Text="A farm. A family. An airplane. A crash. And then this place. Was there really a family? Did that airplane crash, or was it hijacked? Forced down. Forced down by something less than a man. Something",Speaker="Andrew Ryan",Name="vo_5_scripted_ryan_1A_One")
	Subtitles[606]=(Text="bred to sleepwalk through life until they are activated by a simple phrase, spoken by their kindly master. Was a man sent to kill? Or a slave? A man chooses, a slave obeys. Come in.",Speaker="Andrew Ryan",Name="vo_5_scripted_ryan_1A_One")
	Subtitles[607]=(Text="Stop, would you kindly? Would you kindly. Powerful phrase. Familiar phrase? Sit, would you kindly. Stand, would you kindly. Run. Stop! Turn. A man chooses. A slave obeys. Kill. A man chooses. A slave obeys. OBEY.",Speaker="Andrew Ryan",Name="vo_5_scripted_ryan_2A_One")
	Subtitles[608]=(Text="Hurry now...grab Ryan's genetic key! Now would you kindly put it in that goddamn machine?",Speaker="Atlas",Name="vo_R_5_At_OutroA")
	Subtitles[609]=(Text="Self-Destruct scenario canceled. Thank you.",Speaker="Announcer",Name="vo_S_5_Fa_DestructCancel")
	Subtitles[610]=(Text="Nice work, boyo! (laughter) It's time to end this little masquerade. There ain't no Atlas, kid. Never was. Fella in my line a work takes on a",Speaker="Atlas",Name="vo_R_5_At_OutroB")
	Subtitles[611]=(Text="variety of aliases. Hell, once I was even a china-man for six months. But you've been a sport, so I guess I owe you a little honesty. The name's Frank Fontaine.",Speaker="Atlas",Name="vo_R_5_At_OutroB")
	Subtitles[612]=(Text="I gotta say, I had a lot of business partners in my life, but you... 'Course the fact that you were genetically conditioned to bark like a cocker spaniel when I said 'Would",Speaker="Frank Fontaine",Name="vo_R_5_Ft_OutroHitPanel")
	Subtitles[613]=(Text="you kindly' might have had something to do with it, but still... Now as soon as that machine finishes processing the genetic key you just fished off Ryan, I'm gonna run",Speaker="Frank Fontaine",Name="vo_R_5_Ft_OutroHitPanel")
	Subtitles[614]=(Text="Rapture, tits to toes. You been a pal, but you know what they say... Never mix business with friendship. Thanks for everything, kid... Don't forget to say hi to Ryan for me.",Speaker="Frank Fontaine",Name="vo_R_5_Ft_OutroHitPanel")
	Subtitles[615]=(Text="Welcome back, child. Welcome to the city where you were born.",Speaker="Tenenbaum",Name="vo_R_6_Tn_IntroA")
	Subtitles[616]=(Text="You are angry at Fontaine, yes? Now you know the truth. You are his tool. Brought back to Rapture to save him.",Speaker="Tenenbaum",Name="vo_R_6_Tn_IntroB")
	Subtitles[617]=(Text="They say to save one life is to save the world entire. I made a place for the children here, but it is you who are their savior. Will you stop here, or will you deliver them from this terrible city at long last?",Speaker="Tenenbaum",Name="vo_R_6_Tn_IntroCGood")
	Subtitles[618]=(Text="So many innocents, and their blood is on your hands. I too know this shame. How will we ever account for our sins? But we must now set all of this aside, there is work to be done.",Speaker="Tenenbaum",Name="vo_R_6_Tn_IntroCEvil")
	Subtitles[619]=(Text="While you sleep, I undo some of Fontaine's mental conditioning. His control is no longer complete, but he can still pull some very unpleasant strings.",Speaker="Tenenbaum",Name="vo_R_6_Tn_IntroD")
	Subtitles[620]=(Text="You have saved many of my Little Ones. I owe you a debt.",Speaker="Tenenbaum",Name="vo_R_6_Tn_IntroEGood")
	Subtitles[621]=(Text="You've committed many sins. But perhaps you can redeem yourself.",Speaker="Tenenbaum",Name="vo_R_6_Tn_IntroEEvil")
	Subtitles[622]=(Text="There's a land called LILLIPOPPI  And living there is the LILLIPOP  I'll go there soon with MISTER BUBBLES  And we'll search the place from",Speaker="Little Sister",Name="vo_S_6_Ga_Lillipop")
	Subtitles[623]=(Text="TAIL TO TOP    And if we find no TATTLELAMBY  And if I eye no PORQUINAUT  Perhaps we'll dine on HAM AND JAMMY  If we can't find the LILLIPOP",Speaker="Little Sister",Name="vo_S_6_Ga_Lillipop")
	Subtitles[624]=(Text="And now you've got hooked up with Tenenbaum, huh, kid? She's a regular Mother Goose. All right, fun's fun, kid, but now...go get stepped on by a Big Daddy, would you kindly?",Speaker="Frank Fontaine",Name="vo_R_6_Ft_IntroE1a")
	Subtitles[625]=(Text="Huh? I says, would you kindly go get stepped on by a Big Daddy?",Speaker="Frank Fontaine",Name="vo_R_6_Ft_IntroE2a")
	Subtitles[626]=(Text="Ah. Seems like Mother Goose has been playing around in your egg salad. If you won't dance to that tune, I got others. 'Code Yellow'.",Speaker="Frank Fontaine",Name="vo_R_6_Ft_IntroE3a")
	Subtitles[627]=(Text="I just told your brain to tell your heart to stop beating. Not right off the bat, mind you. The heart's a stubborn muscle. But it ain't that stubborn.",Speaker="Frank Fontaine",Name="vo_R_6_Ft_IntroF")
	Subtitles[628]=(Text="We made your mind with many locks and keys. Fontaine has most of those keys, but not all. Suchong designed your mind, taught Fontaine to control you. You might find answers in Suchong's flat in Mercury Suites.",Speaker="Tenenbaum",Name="vo_R_6_Tn_FirstQuest")
	Subtitles[629]=(Text="Once you are free of Fontaine's control, then you can have your revenge...and we can keep my Little Ones out of his filthy hands.",Speaker="Tenenbaum",Name="vo_R_6_Tn_FirstQuestB")
	Subtitles[630]=(Text="It is too dangerous to re-engineer your plasmids in the state Fontaine has put you in. You'll just have to make do with what you have.",Speaker="Tenenbaum",Name="vo_R_6_Tn_MakeDo")
	Subtitles[631]=(Text="That Tenenbaum ain't what you think. Florence Nightengale, huh? That'll all come crashing down 'fore you can say canned tomatoes. I've seen good bunco,",Speaker="Frank Fontaine",Name="vo_R_6_Ft_Reveal")
	Subtitles[632]=(Text="and I've seen great bunco, but when you waltz through Rapture and World War Two without even a scratch? You got more than leprachauns watching over you.",Speaker="Frank Fontaine",Name="vo_R_6_Ft_Reveal")
	Subtitles[633]=(Text="Not so quick, kid. I still got enough of a leash on that brain of yours to keep you from getting any closer to my roost.",Speaker="Frank Fontaine",Name="vo_R_6_Ft_NotSoQuick")
	Subtitles[634]=(Text="I hear your wings flapping in my home...flip flap flip flap flip flap. Come into the light, little moth, come in...",Speaker="Sander Cohen",Name="vo_R_6_Co_InMyHome")
	Subtitles[635]=(Text="I see you're still testing your wings, little moth. Stay and enjoy the dance, if you wish...but don't dare rattle their rhythm.",Speaker="Sander Cohen",Name="vo_R_6_Co_StayIfYouWish")
	Subtitles[636]=(Text="When will you ever learn to take instruction? I'm coming down there, little moth...coming down to teach you to dance.",Speaker="Sander Cohen",Name="vo_R_6_Co_ComingDown")
	Subtitles[637]=(Text="All those years we thought we were making progress: with our Skinner boxes and our electric shocks... what a waste of time. Until Adam, you could no more domesticate a child than a",Speaker="Suchong",Name="vo_L_6_Sg_AboutChild")
	Subtitles[638]=(Text="boa constrictor... Fontaine gives Suchong history for child that he wants to imprint into child head. Kid not a person, he jukebox, ready to play whatever tune Fontaine wants to hear.",Speaker="Suchong",Name="vo_L_6_Sg_AboutChild")
	Subtitles[639]=(Text="Fontaine's become some kind of boogeyman in Rapture, that myth gives him power. But peel back flim-flam and the humbug, he's just another con man. And like all con men, he worries he'll end up on the wrong",Speaker="Suchong",Name="vo_L_6_Sg_FirstQuestTarget")
	Subtitles[640]=(Text="side of grift. That's why he commissioned Lot 192 - the antidote to the mental control plasmid. Fontaine said I better not tell anybody about the antidote, not even Tenenbaum. And Suchong is inclined to listen.",Speaker="Suchong",Name="vo_L_6_Sg_FirstQuestTarget")
	Subtitles[641]=(Text="Now hold there for a moment...there is that drug again. Did we not see that at Fontaine's flat? We'll find some at Suchong's lab as well.",Speaker="Tenenbaum",Name="vo_R_6_Tn_FindSome")
	Subtitles[642]=(Text="Time for some tasty, boys!",Speaker="Male Splicer",Name="vo_S_6_Sw_TimeForTasty")
	Subtitles[643]=(Text="Looks like things have gone busto between Fontaine and his little German beanpole. Why a guy like Fontaine would waste his time with that spooky Kraut when he could be gettin' the",Speaker="Paparazzi",Name="vo_L_6_Zi_FontCode")
	Subtitles[644]=(Text="gravy from any dish he chooses is beyond the understanding of this paparazzi. Even reset the door code to 5744, maybe to be double-sure that beanpole don't sprout up in his yard again...",Speaker="Paparazzi",Name="vo_L_6_Zi_FontCode")
	Subtitles[645]=(Text="I knew there was something to that. Always secrets with Suchong, always secrets. He must have this Lot 192 in his labs near Apollo Square. But, I once in secret stole a",Speaker="Tenenbaum",Name="vo_R_6_Tn_SecondQuest")
	Subtitles[646]=(Text="dose and brought it to my flat on the second floor. I never knew what it was for, but I figured if that bastard was doing something in the shadows, on this I keep my eye.",Speaker="Tenenbaum",Name="vo_R_6_Tn_SecondQuest")
	Subtitles[647]=(Text="Always secrets when with Suchong, always secrets. He must have this Lot 192 in his labs near Apollo Square. I once stole a dose and brought it to my flat on the second floor,",Speaker="Tenenbaum",Name="vo_R_6_Tn_SecondQuestB")
	Subtitles[648]=(Text="but those apes would have taken it back to Fontaine's penthouse upstairs. I never knew what Lot 192 was for, but if Suchong was doing something in secret, on this I keep my eye.",Speaker="Tenenbaum",Name="vo_R_6_Tn_SecondQuestB")
	Subtitles[649]=(Text="Look at my home, torn apart by Fontaine and his pigs. Why? Who knows, but I am sure there is answer in Suchong's flat. You will not believe me, but there was a time when this was all so beautiful..",Speaker="Tenenbaum",Name="vo_R_6_Tn_TenenbaumHome")
	Subtitles[650]=(Text="Look at my home, torn apart by Fontaine and his pigs. No doubt he had the samples of Lot 192 taken to his penthouse. Entrance is",Speaker="Tenenbaum",Name="vo_R_6_Tn_ThirdQuest")
	Subtitles[651]=(Text="in lobby, but the damn thing is always locked. You will not believe me, but there was a time when this place was all so beautiful..",Speaker="Tenenbaum",Name="vo_R_6_Tn_ThirdQuest")
	Subtitles[652]=(Text="What you take me for, some kind of mental incompetent? We tossed Mother Goose's roost the moment she decided to grow a conscience. You won't find nothing here, kid, 'cept maybe her memories. And trust me on this: you don't want 'em.",Speaker="Frank Fontaine",Name="vo_R_6_Ft_Ransack")
	Subtitles[653]=(Text="That's quite a little monster Fontaine's dug up. When she does speak, which is almost never, her accent is thick and grating. Her hair is filthy and she seems to wear the same mustard-stained jumper day",Speaker="Suchong",Name="vo_L_6_Sg_AboutTenenbaum")
	Subtitles[654]=(Text="after day. But I've got to hand it to Frank: Tenenbaum is the all-time diamond in the rough. No formal training, no experience... but put her in front of a gene sequence, and she's Mozart at the harpsichord.",Speaker="Suchong",Name="vo_L_6_Sg_AboutTenenbaum")
	Subtitles[655]=(Text="Yes! The compound is taking hold. The effects of the mental suggestion are now gone, but there will certainly be side effects.",Speaker="Tenenbaum",Name="vo_R_6_Tn_FindPlasmiQuik")
	Subtitles[656]=(Text="Lot 192 has reorganized your entire plasmid structure. I should have known you would need a larger dosage. You'll have to locate another dosage to fully remove the effects.",Speaker="Tenenbaum",Name="vo_R_6_Tn_ThirdQuestHalf")
	Subtitles[657]=(Text="Gut. Now go and find Suchong's lab in Artemis Suites. In there no doubt there will be more of this Lot 192.",Speaker="Tenenbaum",Name="vo_R_6_Tn_ThirdQuestHalfB")
	Subtitles[658]=(Text="Gut. Now go and pick up the trail in Mercury Suites. No doubt there we will find more of this Lot 192.",Speaker="Tenenbaum",Name="vo_R_6_Tn_MoreLot192a")
	Subtitles[659]=(Text="Good! Now you can use the gene bank again. It is time to, oh how do you say? To take the fight to that son of ze bitch.",Speaker="Tenenbaum",Name="vo_R_6_Tn_TakeTheFight")
	Subtitles[660]=(Text="When it was done with Culpepper, I left her as she was in the bathroom. I seen she had a blanket half-knitted by her bed. It was nice, you know, black and red, real pretty.",Speaker="Sullivan",Name="vo_L_6_Pd_ArtistWoman")
	Subtitles[661]=(Text="So I took it, so I could, you know, have somebody finish it. So it could be of use to someone. It just didn't seem right to leave it lying there, lying there all by itself.",Speaker="Sullivan",Name="vo_L_6_Pd_ArtistWoman")
	Subtitles[662]=(Text="Clinical Trial Protector System Plasmid Lot 255 Dr. Suchong/Client Ryan Industries. Very frustrating day. I can't seem to get the damn Big Daddies to imprint on the little brats.",Speaker="Suchong",Name="vo_L_6_Sg_ProtectionBond")
	Subtitles[663]=(Text="The protection bond is just not forming...   Gatherer: Papa Suchong!   Suchong: Get away...maybe if I modify the genetic sequence to...   Gatherer: Papa Suchong!",Speaker="Suchong",Name="vo_L_6_Sg_ProtectionBond")
	Subtitles[664]=(Text="Shoo...sequence to allow for...   Gatherer: Papa Suchong! Papa Suchong!   Suchong: Get away, you filthy little shit! ...What? What are you doing? Get back...get back!!! Argh!",Speaker="Suchong",Name="vo_L_6_Sg_ProtectionBond")
	Subtitles[665]=(Text="You think Ryan's gonna be there for you when you're down and out? No! Fontaine! Fontaine's the man with the helping hand!!!",Speaker="Ghost",Name="vo_S_6_Rr_RabbleRouser")
	Subtitles[666]=(Text="Attention: Any public congregation of more than 4 persons is considered an actionable offense.",Speaker="Announcer",Name="vo_PA_6_Fa_Congregation")
	Subtitles[667]=(Text="Attention: Splicers must display identification armbands at all times. Remember: segregation keeps everybody safe.",Speaker="Announcer",Name="vo_PA_6_Fa_Armbands")
	Subtitles[668]=(Text="Attention: A new curfew will be enacted on Thursday. Citizens found in violation will be relocated to Apollo Square.",Speaker="Announcer",Name="vo_PA_6_Fa_Curfew")
	Subtitles[669]=(Text="The Little Sisters orphanage: in troubled times, give your little girl the life that she deserves. Boarding and education free of charge. After all, children are the future of Rapture.",Speaker="Announcer",Name="vo_PA_6_Fa_Orphanage")
	Subtitles[670]=(Text="Suchong you bastard! ! Look what you've done to me!",Speaker="Male Splicer",Name="vo_S_6_To_Customer")
	Subtitles[671]=(Text="Squatter...parasite...get out my house!",Speaker="Female Splicer",Name="vo_S_6_La_Squatter")
	Subtitles[672]=(Text="Look at this dump...Nothing left but nothing!",Speaker="Male Splicer",Name="vo_S_6_Bw_Squatter")
	Subtitles[673]=(Text="I was so angry when I came down here, but...my god...I had no idea...there's armed men all over the place...I saw a woman climb",Speaker="Diane McClintock",Name="vo_L_6_Cf_SoAngry")
	Subtitles[674]=(Text="over the fence trying to escape...one of Ryan's guards pointed at her, and she lit on fire...just like that. What's happening here?",Speaker="Diane McClintock",Name="vo_L_6_Cf_SoAngry")
	Subtitles[675]=(Text="I bribed one of the gorillas at the gate to let me in. It's awful in here...to my right, I can see a dead woman lying in the street...everybody's just walking by her,",Speaker="Diane McClintock",Name="vo_L_6_Cf_Lives")
	Subtitles[676]=(Text="like she isn't there. But I noticed something, spray-painted everywhere...'Atlas lives.' I don't know what it means, but something tells me it's important to these people...",Speaker="Diane McClintock",Name="vo_L_6_Cf_Lives")
	Subtitles[677]=(Text="The people here have grown to trust me...Ryan's mistress, and still they take me in! They finally brought me to Atlas. Without him, the people of 'pollo Square would give up. I asked him if he was going to lead",Speaker="Diane McClintock",Name="vo_L_6_Cf_TheyTrustMe")
	Subtitles[678]=(Text="the people in some kind of uprising against Ryan. He sighed and said, 'I am not a liberator. Liberators do not exist. These people will liberate themselves.' I thought Andrew Ryan was a great man. I was a fool.",Speaker="Diane McClintock",Name="vo_L_6_Cf_TheyTrustMe")
	Subtitles[679]=(Text="We went on a raid outside the wire today. We snagged 31 rounds of buckshot, 4 frag grenades, a shotgun, and 34 Adam. We lost McGee, Epstein and Vallette. We got one of those goddamn Big Daddies",Speaker="Diane McClintock",Name="vo_L_6_Cf_Raid")
	Subtitles[680]=(Text="in the bargain, though. It was something awful what they had to do to that little girl to get the Adam, but we didn't start this thing. Ryan did. I can't wait to tell Atlas. He'll be so pleased...",Speaker="Diane McClintock",Name="vo_L_6_Cf_Raid")
	Subtitles[681]=(Text="You think you're some kind of hero? I ordered you up from Suchong like a Chinese dinner, a little from column A, a little from column B. What do",Speaker="Frank Fontaine",Name="vo_R_6_Ft_HammerA")
	Subtitles[682]=(Text="you plan on going back to? Your fake family? Your phony dreams? Putting you out of your misery will be the nicest thing anyone's ever done for you.",Speaker="Frank Fontaine",Name="vo_R_6_Ft_HammerA")
	Subtitles[683]=(Text="I don't like this any more than you do, kid. But you gotta understand where I'm coming from... I've got twelve years down here...big investment. Man can't walk away from a long con like that...",Speaker="Frank Fontaine",Name="vo_R_6_Ft_HammerB")
	Subtitles[684]=(Text="Kills me to turn my fist to you, but business is business. Don't let it get you down...won't make a difference when this whole place is fish food.",Speaker="Frank Fontaine",Name="vo_R_6_Ft_HammerC")
	Subtitles[685]=(Text="Hate to see you this way, kid. Hell, I was there when you were born. You ever have a dog you gotta put down? Breaks your heart.",Speaker="Frank Fontaine",Name="vo_R_6_Ft_HammerD")
	Subtitles[686]=(Text="I'm gonna miss this place. Rapture was a candy store for a guy like me. Guys who thought they knew it all. Dames who thought they'd SEEN it all. Give me a smart mark over a dumb one every time.",Speaker="Frank Fontaine",Name="vo_R_6_Ft_ExplainA")
	Subtitles[687]=(Text="Made Ryan good and mad when I started playing the charity angle. Fontaine's Home for the Poor. 'Fore I knew it, I was calling myself Atlas and leading",Speaker="Frank Fontaine",Name="vo_R_6_Ft_Charity")
	Subtitles[688]=(Text="an army. Ryan and his precious Rapture. You don't have to build a city to make people worship you...just make the chumps believe they're worth a nickel.",Speaker="Frank Fontaine",Name="vo_R_6_Ft_Charity")
	Subtitles[689]=(Text="Ryan's flesh and blood. Why'd I go to the trouble? Otherwise, you'd have been cut in two by the first security bot you crossed paths with. But not Ryan...he made it",Speaker="Frank Fontaine",Name="vo_R_6_Ft_HammerF")
	Subtitles[690]=(Text="so his security would recognize his genetic structure. With half his genes, you ain't immune, but you got just enough to throw them metallic mooks off their game.",Speaker="Frank Fontaine",Name="vo_R_6_Ft_HammerF")
	Subtitles[691]=(Text="Adam's the ultimate score, kid. No more grifts. No more scams. A monopoly on Adam makes Standard Oil look like the Piggly",Speaker="Frank Fontaine",Name="vo_R_6_Ft_HammerG")
	Subtitles[692]=(Text="Wiggly. All that's left is burying the bodies...and when they're already six miles under the Atlantic, you got one helluva head start!",Speaker="Frank Fontaine",Name="vo_R_6_Ft_HammerG")
	Subtitles[693]=(Text="That's it, kid. You're busto. My new friends will catch up with you soon... ah, kid... I hope they make it quick...",Speaker="Frank Fontaine",Name="vo_R_6_Ft_HammerH")
	Subtitles[694]=(Text="Now you are having freedom. Suchong's drugs should have no hold on you. Take the bathysphere to Point Prometheus. It is time for this matter to be settled.",Speaker="Tenenbaum",Name="vo_R_6_Tn_ThirdQuestDone")
	Subtitles[695]=(Text="You broke the spell?! But layin' all your chips on Mother Goose- it's not like you never been double-crossed before, you know what I'm",Speaker="Frank Fontaine",Name="vo_R_6_Ft_NowWhat")
	Subtitles[696]=(Text="sayin'? Hoof it to Point Prometheus. We'll discuss this like men. You, me, a submarine topside, and more Adam than you could possibly imagine...",Speaker="Frank Fontaine",Name="vo_R_6_Ft_NowWhat")
	Subtitles[697]=(Text="Suchong: Is that your puppy? She's very pretty...   Little Boy: Thank you, Papa Suchong   Suchong: Break her neck for me.   Little Boy: What?   Suchong:",Speaker="Suchong",Name="vo_L_6_Sg_Xxx")
	Subtitles[698]=(Text="Break that sweet puppy's neck.   Little Boy: No...please...   Suchong: Break that puppy's neck- would you kindly...   Little Boy: No...no...   Suchong: Very good",Speaker="Suchong",Name="vo_L_6_Sg_Xxx")
	Subtitles[699]=(Text="These sad saps. They come to Rapture, thinking they're gonna be captains of industry. But they all forget that somebody's gotta scrub the toilets. What an",Speaker="Frank Fontaine",Name="vo_L_6_Ft_SadSaps")
	Subtitles[700]=(Text="angle they gave me- I hand these mugs a cot and a bowl of soup, and they give me their lives. Who needs an army when I got Fontaine's Home for the Poor?",Speaker="Frank Fontaine",Name="vo_L_6_Ft_SadSaps")
	Subtitles[701]=(Text="Frank Fontaine: Never play a man for the short con when you can play 'em for the long one. Atlas is the longest con of all. Ryan wanted Frank Fontaine dead, I just gave him what he wanted. As Atlas, I got a new face, a clean record, and a",Speaker="Frank Fontaine",Name="vo_L_6_Ft_LongCon")
	Subtitles[702]=(Text="fresh start. Now it's time to take back Rapture and-   Diane McClintock: ...Ryan did. I can't wait to tell Atlas. He'll be so pleased...   Frank Fontaine: Uhh, Miss McClintock...what are you doing here? Let me just turn this off...",Speaker="Frank Fontaine",Name="vo_L_6_Ft_LongCon")
	Subtitles[703]=(Text="Get him, Mr. B!",Speaker="Little Sister",Name="vo_S_7_Ga_TossStuff1a")
	Subtitles[704]=(Text="Unzip him, Mr. B! Unzip him!",Speaker="Little Sister",Name="vo_S_7_Ga_TossStuff2a")
	Subtitles[705]=(Text="Kill him! Kill him!",Speaker="Little Sister",Name="vo_S_7_Ga_TossStuff3a")
	Subtitles[706]=(Text="You're playing a bad hand, kid! You're just too spliced to smell it! Roll on back to Mother Goose now, or everything's gonna go busto!",Speaker="Frank Fontaine",Name="vo_R_7_Ft_flee0a")
	Subtitles[707]=(Text="What is this you wait for? Go and get this idiot...",Speaker="Tenenbaum",Name="vo_R_7_Tn_Chase")
	Subtitles[708]=(Text="The mug's right behind me! I don't even want to see him walking!",Speaker="Frank Fontaine",Name="vo_S_7_Ft_flee1a")
	Subtitles[709]=(Text="Last chance, kid. You pack it in now, and I'll leave this dump to you and Frau Kraut. You keep on coming, and Rapture's a fish tank.",Speaker="Frank Fontaine",Name="vo_S_7_Ft_flee2a")
	Subtitles[710]=(Text="Scheisse! You let him get away! I need a moment for thinking. Ah! Ach, of course! This will be no problem. Find a Big Daddy and search his body. I would suggest you to be finding a dead one.",Speaker="Tenenbaum",Name="vo_R_7_Tn_LockedGathererDoor")
	Subtitles[711]=(Text="You see the Suit Control System? Sehr Gut. Get it. That is step one of turning you into one of those disgusting Big Daddys. The only way to get through that door",Speaker="Tenenbaum",Name="vo_R_7_Tn_BecomeAProtector")
	Subtitles[712]=(Text="Fontaine went through is to have a Little One open it for you. And they'll only trust you if you look like, sound like, and even smell like one of those big stinking brutes...",Speaker="Tenenbaum",Name="vo_R_7_Tn_BecomeAProtector")
	Subtitles[713]=(Text="Where do you think you're going? You need to become a Big Daddy before you are able to draw out the Little Ones...",Speaker="Tenenbaum",Name="vo_R_7_Tn_QuestNotDone")
	Subtitles[714]=(Text="We bred Little Ones to imprint to certain smells, the pheromones. But this is not like putting on aftershave...you'll need three industrial applications of this",Speaker="Tenenbaum",Name="vo_R_7_Tn_EnteringGathererLabs")
	Subtitles[715]=(Text="stuff...and then the Little Ones will be drawn to you like a bee to honey... You will have to gather three pheromones here, so that you smell disgusting, just like a Big Daddy.",Speaker="Tenenbaum",Name="vo_R_7_Tn_EnteringGathererLabs")
	Subtitles[716]=(Text="I can only be glad I am nowhere near you and that awful stink...why the Little Ones are drawn to the smell of those pheromones is beyond anything I can understand.",Speaker="Tenenbaum",Name="vo_R_7_Tn_FirstPheromoneSplash")
	Subtitles[717]=(Text="Is good start. Now you need only to find the bodysuit and the voicebox from the other labs and you will be a proper brute. Get moving.",Speaker="Tenenbaum",Name="vo_R_7_Tn_NeedSuitAndVoice")
	Subtitles[718]=(Text="Here is where you be finding the voicebox to have sound like one of those Big Daddies. Repulsive creatures...",Speaker="Tenenbaum",Name="vo_R_7_Tn_EnteringPlasmidLabs")
	Subtitles[719]=(Text="One down, two steps to go. Now you need only to be finding the bodysuit and the pheromones from the other labs. What you wait for, engraved invitation?",Speaker="Tenenbaum",Name="vo_R_7_Tn_NeedSuitAndSmell")
	Subtitles[720]=(Text="After Ryan takes this place, here is where they build their filthy golems, their Frankensteins. Find the pieces of the suit. Guide the Little Ones.",Speaker="Tenenbaum",Name="vo_R_7_Tn_EnteringProtectorLabs")
	Subtitles[721]=(Text="Better for the girls to be with you, better with you than alone, alone in the crawling darkness.",Speaker="Tenenbaum",Name="vo_R_7_Tn_GathererFlavorText")
	Subtitles[722]=(Text="The boots! I was sure the boots would be here! Schiesse!",Speaker="Tenenbaum",Name="vo_R_7_Tn_BootsMissing")
	Subtitles[723]=(Text="Ach. Forget these boots. Just find the bodysuit und the helmet.",Speaker="Tenenbaum",Name="vo_R_7_Tn_IgnoreBoots")
	Subtitles[724]=(Text="This is where you find bodysuit...",Speaker="Tenenbaum",Name="vo_R_7_Tn_TorsosHere")
	Subtitles[725]=(Text="Das ist gut! We will make disgusting Frankenstein out of you yet. There is helmet and pair of boots and we will be, how you say, in business?",Speaker="Tenenbaum",Name="vo_R_7_Tn_NeedHelmetAndBoots")
	Subtitles[726]=(Text="Ah, Look at you. You look just the same as those...Ah...What things we have done...what things... Now the boots...",Speaker="Tenenbaum",Name="vo_R_7_Tn_NeedBoots")
	Subtitles[727]=(Text="Good. I hear the squawk of the voice box, and I can only imagine how you must smell with those awful pheromones. Once you find those Frankenstein boots, you will be ready.",Speaker="Tenenbaum",Name="vo_R_7_Tn_AlmostReady")
	Subtitles[728]=(Text="Wunderbar. All you need now is helmet.",Speaker="Tenenbaum",Name="vo_R_7_Tn_NeedHelmet")
	Subtitles[729]=(Text="I'd turn tail if I were you, kid. Ain't nothin' here for you but tears.",Speaker="Frank Fontaine",Name="vo_R_7_Ft_HelmetsHere")
	Subtitles[730]=(Text="Ja. It makes a good start! Now you go to find a bodysuit und a pair of boots.",Speaker="Tenenbaum",Name="vo_R_7_Tn_NeedTorsoAndBoots")
	Subtitles[731]=(Text="Und so, all we need now is bodysuit.",Speaker="Tenenbaum",Name="vo_R_7_Tn_NeedTorso")
	Subtitles[732]=(Text="Was ist los? Why are these boots here? They should be in Failsafe Armored Escorts. Ach, no matter. Take them, take them.",Speaker="Tenenbaum",Name="vo_R_7_Tn_MysteryBoots")
	Subtitles[733]=(Text="Gut. Now it is time to locate some pheromones to change your smell...and you also will need to locate those boots.",Speaker="Tenenbaum",Name="vo_R_7_Tn_NeedBootsAndSmell")
	Subtitles[734]=(Text="You have enough of those now.",Speaker="Tenenbaum",Name="vo_R_7_Tn_MoreThanEnoughSamples")
	Subtitles[735]=(Text="Gut. Now you'll need to modify your voice and find a pair of boots for yourself.",Speaker="Tenenbaum",Name="vo_R_7_Tn_NeedBootsAndVoice")
	Subtitles[736]=(Text="Ach! You'll make terrible racket, but it's start... now you will have need of bodysuit und helmet.",Speaker="Tenenbaum",Name="vo_R_7_Tn_NeedTorsoAndHelmet")
	Subtitles[737]=(Text="Boots and bodysuit. You must go back to Failsafe Armored Escorts und find helmet. Now. Schnell, there is no time to waste.",Speaker="Tenenbaum",Name="vo_R_7_Tn_NeedHelmet2a")
	Subtitles[738]=(Text="Boots und helmet. You must go back to Failsafe Armored Escorts and find bodysuit now. Schnell. There is no time to waste.",Speaker="Tenenbaum",Name="vo_R_7_Tn_NeedTorso2a")
	Subtitles[739]=(Text="We are getting somewhere. Now we will find some pheromones for you und a voicebox. Let us go now...we have got the work to do.",Speaker="Tenenbaum",Name="vo_R_7_Tn_NeedSmellAndVoice")
	Subtitles[740]=(Text="Look at you! We will make Big Daddy out of you yet, I think. There is only one piece missing: the Voicebox Modification Machine in Optimized Eugenics.",Speaker="Tenenbaum",Name="vo_R_7_Tn_NeedVoice")
	Subtitles[741]=(Text="Ah! Look at you! We will make Big Daddy out of you yet, I think. There is only one piece missing: the bodysuit. Go to Failsafe Armored Escorts.",Speaker="Tenenbaum",Name="vo_R_7_Tn_NeedSuit")
	Subtitles[742]=(Text="Look at you! We will make Big Daddy out of you yet, I think. There is only one piece missing: the pheromones. Go to the Little Wonders Educational Facility.",Speaker="Tenenbaum",Name="vo_R_7_Tn_NeedSmell")
	Subtitles[743]=(Text="Yes, now this is a Big Daddy. Are you ready? Now go to the Little Sister vent by the Proving Grounds.",Speaker="Tenenbaum",Name="vo_R_7_Tn_ReturnToDoor")
	Subtitles[744]=(Text="You need to bring them out of hiding, and then they'll let you in the door. Go on, hit the vent with your wrench.",Speaker="Tenenbaum",Name="vo_R_7_Tn_GetAGatherer")
	Subtitles[745]=(Text="Was ist this you wait for? Go on, hit the vent with your wrench.",Speaker="Tenenbaum",Name="vo_R_7_Tn_GetAGatherer2a")
	Subtitles[746]=(Text="Und bitte. It would mean very much to me if you will be gentle with the girls. Mein kleines maedchen.",Speaker="Tenenbaum",Name="vo_R_7_Tn_GathererFlavorText2a")
	Subtitles[747]=(Text="Tick, Tock, Rabbit Clock, Bunny's out of time...",Speaker="Ghost",Name="vo_S_7_Gg_ScienceGhostGirl")
	Subtitles[748]=(Text="Please Papa Suchong...I don't want to go on the table...",Speaker="Ghost",Name="vo_S_7_Gg_GhostTable")
	Subtitles[749]=(Text="Shame things turned out this way, kid. You and me coulda run the table in this place. Now there's nothing left for you but a long cold nothing.",Speaker="Frank Fontaine",Name="vo_R_7_Ft_Taunt1a")
	Subtitles[750]=(Text="Look around you, kid. You think two-bit heroics count for a fig in this pit? You're staring down the puke stain of Ryan's busted dream. You think there's something worth saving down here? Then you deserve to gargle with the rest of these scrubs.",Speaker="Frank Fontaine",Name="vo_R_7_Ft_Taunt2a")
	Subtitles[751]=(Text="Has Mother Goose really got her hooks into you. You can knock Ryan all you want, but the old man was bingo on one point of fact: you won't even walk till somebody says 'go'!",Speaker="Frank Fontaine",Name="vo_R_7_Ft_Taunt3a")
	Subtitles[752]=(Text="You think turning yourself into one of those tin men is a two-way street? The Kraut's holding auditions for the Frankenstein parade and you're first in line!",Speaker="Frank Fontaine",Name="vo_R_7_Ft_Taunt4a")
	Subtitles[753]=(Text="I've got Rapture now! I've got the Adam now! You think that tin suit's even half enough to put the scare in me?",Speaker="Frank Fontaine",Name="vo_R_7_Ft_Taunt6a")
	Subtitles[754]=(Text="Where you gonna go? Your life? Your family? They're a fairy-tale, kid. No more real than something you read about in the Saturday Evening Post. Poor bastard...a motherless freak whipped up in a half-baked science experiment.",Speaker="Frank Fontaine",Name="vo_R_7_Ft_Taunt7a")
	Subtitles[755]=(Text="You pushed me too far, kid. When you're cold and stiff, I'm going over to Mother Goose's house, and I'm going to take it apart piece by piece, and brat by brat. Consider it your legacy.",Speaker="Frank Fontaine",Name="vo_R_7_Ft_Taunt8a")
	Subtitles[756]=(Text="Look around you! There's nothing to save! Rapture's a mausoleum, a god damn cemetery funhouse. And you and the Kraut is just ghosts...just a matter time till you realize it.",Speaker="Frank Fontaine",Name="vo_R_7_Ft_Taunt9a")
	Subtitles[757]=(Text="You know, you should be THANKING me! I brought you here! I showed you who you are! Nobody never told you nothing but lies till I come along!",Speaker="Frank Fontaine",Name="vo_R_7_Ft_Taunt10a")
	Subtitles[758]=(Text="I really wound you up with that wife and child bit...Oh, me poor Moira...Ay, me wee baby Patrick. Maybe one day I'll get me a real family...they play well with the suckers.",Speaker="Frank Fontaine",Name="vo_R_7_Ft_BetterOrWorse")
	Subtitles[759]=(Text="Could I have made mistakes? One does not build cities if one is guided by doubt. But can one govern in absolute certainty? I know that my beliefs have elevated me, just as I know that the things I have rejected would have destroyed me. But the",Speaker="Andrew Ryan",Name="vo_L_7_Ry_Mistakes")
	Subtitles[760]=(Text="city...it is collapsing before my...have I become so convinced by my own beliefs that I have stopped seeing the truth? Perhaps. But Atlas is out there, and he aims to destroy me, and destroy my city. To question is to surrender. I will not question.",Speaker="Andrew Ryan",Name="vo_L_7_Ry_Mistakes")
	Subtitles[761]=(Text="I'll admit Fontaine showed some foresight when he built up the plasmid business, but the man really never understood sales. Hiding those little girls beneath a bushel. I've",Speaker="Andrew Ryan",Name="vo_L_7_Ry_LittleGirls")
	Subtitles[762]=(Text="just seen the preliminary design work on the new plasmid machines, and they're exactly what I wanted. Mark my words- presented properly, those little sisters are marketing gold.",Speaker="Andrew Ryan",Name="vo_L_7_Ry_LittleGirls")
	Subtitles[763]=(Text="Fontaine scary son of a bitch, but Ryan cheap son of a bitch. You can no reuse protector suit. Take a man, graft skin and organs straight into suit, otherwise suit not work. Ryan say Big Daddy too expensive. Ryan can go suck egg.",Speaker="Suchong",Name="vo_L_7_Sg_OneUseSuits")
	Subtitles[764]=(Text="Ryan sent over extra munitions. He must've suspected trouble. I've locked them up near the Protector Labs and set the code to 1921. I don't expect we'll ever be needing them though. Once Big Daddy is ready, nobody cross the Big Daddy.",Speaker="Suchong",Name="vo_L_7_Sg_ExtraMunitions")
	Subtitles[765]=(Text="Fontaine is dead. Hmmm. Bad for Fontaine. Good for Suchong. Play hard to get for a bit, then Mr. Ryan get hungry for me. Tenenbaum gone, Fontaine gone, Suchong only one who know all about Little Sisters. Like I said, this very good for Suchong.",Speaker="Suchong",Name="vo_L_7_Sg_GoodForSuchong")
	Subtitles[766]=(Text="Goddamnit! The Big Daddy boots need to be shipped here, not to damn library! What kind of idiots is Ryan hiring nowadays? This kind of bullshit never happen under Fontaine.",Speaker="Suchong",Name="vo_L_7_Sg_BootsMissingLog")
	Subtitles[767]=(Text="War a terrible thing. Japanese kill every man in my city, except for Suchong. Suchong have opium. Very good opium. This war, terrible thing, too, but not for Suchong. Everyone scared now. Everyone need",Speaker="Suchong",Name="vo_L_7_Sg_Opium")
	Subtitles[768]=(Text="Adam. More than Little Sisters can make. Good news is war makes lots of corpses. Suchong knows way to recycle Adam from corpse. But can't send Little Sister out to street unprotected. Suchong must think on this.",Speaker="Suchong",Name="vo_L_7_Sg_Opium")
	Subtitles[769]=(Text="Big Daddy make a terrible stink, very smelly. Maybe something can be done, but Little Sisters seem to like odor. Now we have to find",Speaker="Suchong",Name="vo_L_7_Sg_Stink")
	Subtitles[770]=(Text="recruits...you become Big Daddy, it's a one way street. But Ryan says, don't worry, recruits will be no problem. That Ryan- he's a good guy.",Speaker="Suchong",Name="vo_L_7_Sg_Stink")
	Subtitles[771]=(Text="I know why it has to be children, but why just girls? This I cannot determine why, but I know it is so. Fontaine says 'ah, one less bathroom to build in the orphanage'. It is amazing to watch the effect of Adam on their small bodies.",Speaker="Tenenbaum",Name="vo_L_7_Tn_WhyGirls")
	Subtitles[772]=(Text="Their own cells, replaced by the new stems the instant they are damaged. These children are practically invulnerable. It is a shame you could not do the same thing to an adult. There would be quite a market for a man you could not kill.",Speaker="Tenenbaum",Name="vo_L_7_Tn_WhyGirls")
	Subtitles[773]=(Text="That's it, kid. It's been a long road. You don't even remember most of it. Put you on a sub when you were just a sprout.",Speaker="Frank Fontaine",Name="vo_R_7_Ft_LongRoad")
	Subtitles[774]=(Text="Ach, look at them...even though they are physically free of the need to gather, Suchong's mental conditioning still holds them to their terrible task. For sins such as this, we can never atone...",Speaker="Tenenbaum",Name="vo_R_7_Tn_StillGathering")
	Subtitles[775]=(Text="The Little Ones will lead you to Fontaine...but you must protect them.",Speaker="Tenenbaum",Name="vo_R_7_Tn_GauntProtect")
	Subtitles[776]=(Text="Only the Little Ones can open these doors. You must protect them.",Speaker="Tenenbaum",Name="vo_R_7_Tn_GauntDoor")
	Subtitles[777]=(Text="If a Little One falls, you can call for another at a vent. But to lose even one is a sin.",Speaker="Tenenbaum",Name="vo_R_7_Tn_GauntLose")
	Subtitles[778]=(Text="Fontaine is nearby. You are reaching close now.",Speaker="Tenenbaum",Name="vo_R_7_Tn_GauntFontaine")
	Subtitles[779]=(Text="Watch out! For certain their harvesting will draw the attention of the splicers!",Speaker="Tenenbaum",Name="vo_R_7_Tn_GauntHarvest1a")
	Subtitles[780]=(Text="Keep an eye opening for the splicers!",Speaker="Tenenbaum",Name="vo_R_7_Tn_GauntHarvest2a")
	Subtitles[781]=(Text="Hurry! The harvesting will draw the attention of the splicers!",Speaker="Tenenbaum",Name="vo_R_7_Tn_GauntHarvest3a")
	Subtitles[782]=(Text="Watch out! For certain more splicers will come now!",Speaker="Tenenbaum",Name="vo_R_7_Tn_GauntHarvest4a")
	Subtitles[783]=(Text="She stops again?! More splicers will attack for certain!",Speaker="Tenenbaum",Name="vo_R_7_Tn_GauntHarvest5a")
	Subtitles[784]=(Text="Splicers, here they come!",Speaker="Tenenbaum",Name="vo_R_7_Tn_GauntHarvest6a")
	Subtitles[785]=(Text="Splicers!",Speaker="Tenenbaum",Name="vo_R_7_Tn_GauntHarvest7a")
	Subtitles[786]=(Text="Watch out! The Little One is hurt!",Speaker="Tenenbaum",Name="vo_R_7_Tn_GauntHurt1a")
	Subtitles[787]=(Text="Careful! The Little One is in trouble!",Speaker="Tenenbaum",Name="vo_R_7_Tn_GauntHurt2a")
	Subtitles[788]=(Text="The Little One, watch out!",Speaker="Tenenbaum",Name="vo_R_7_Tn_GauntHurt3a")
	Subtitles[789]=(Text="You must protect the Little Ones! They're not longer infused with Adam. They are as vulnerable as any child!",Speaker="Tenenbaum",Name="vo_R_7_Tn_KeepAlive")
	Subtitles[790]=(Text="No! You have lost her!",Speaker="Tenenbaum",Name="vo_R_7_Tn_GauntKilled1a")
	Subtitles[791]=(Text="What have you done? The Little One has fallen!",Speaker="Tenenbaum",Name="vo_R_7_Tn_GauntKilled2a")
	Subtitles[792]=(Text="No! You have let them take the Little One!",Speaker="Tenenbaum",Name="vo_R_7_Tn_GauntKilled3a")
	Subtitles[793]=(Text="Find a vent, and summon another Little One.",Speaker="Tenenbaum",Name="vo_R_7_Tn_GauntVent")
	Subtitles[794]=(Text="Now you must find a vent and bring forth another Little One!",Speaker="Tenenbaum",Name="vo_R_7_Tn_GauntNewGath")
	Subtitles[795]=(Text="The Little Ones have prepared a present to thank you for your kindness to them. You will find it at any Gatherer's Garden machine.",Speaker="Tenenbaum",Name="vo_R_7_Tn_GauntPresent")
	Subtitles[796]=(Text="All right, all right, you looking to slug it out? I'm game. But I've got all the Adam in the city, pal. And now, I'm jake to take her out for a spin...",Speaker="Frank Fontaine",Name="vo_R_7_Ft_GauntletTaunt1a")
	Subtitles[797]=(Text="(exhilarated) Don't know what I was thinking...never spliced up once the whole time I was down here in this aquarium...figured it was bad to mix",Speaker="Frank Fontaine",Name="vo_R_7_Ft_GauntletTaunt2a")
	Subtitles[798]=(Text="business with pleasure, but, whew!!! Forget all the nose candy and floor polish I've been wasting time with- This stuff is the mother's milk...",Speaker="Frank Fontaine",Name="vo_R_7_Ft_GauntletTaunt2a")
	Subtitles[799]=(Text="-Hah! That might be plenty for the working scrubs and the pencil-pushers, but I need more, more...I want to splice 'til there ain't nothing left to splice with!",Speaker="Frank Fontaine",Name="vo_R_7_Ft_GauntletTaunt3a")
	Subtitles[800]=(Text="Here...take this...stick it in the bad man!",Speaker="Little Sister",Name="vo_S_7_Ga_Giveneedle1a")
	Subtitles[801]=(Text="There, you must use the needle of the Little Sister to drain Fontaine of his Adam...it is the only way to defeat him.",Speaker="Tenenbaum",Name="vo_R_7_Tn_DrainFontaine")
	Subtitles[802]=(Text="What are you waiting for? Pick up the needle!",Speaker="Little Sister",Name="vo_S_7_Ga_GiveNeedle2a")
	Subtitles[803]=(Text="Fontaine waits above. There will no going back from here. Make sure you are ready to face him before moving on.",Speaker="Tenenbaum",Name="vo_R_7_Tn_WaitsAbove")
	Subtitles[804]=(Text="I remember when me and the Kraut put you in that sub. You were no more than two. You were my ace in the hole, but you were also the closest thing I ever had to a son. And that's why this hurts. Betrayal, kid. Life ain't strictly business.",Speaker="Frank Fontaine",Name="vo_R_7_Ft_Final1a")
	Subtitles[805]=(Text="but you were also the closest thing I ever had to a son. And that's why this hurts. Betrayal, kid. Life ain't strictly business.",Speaker="Frank Fontaine",Name="vo_R_7_Ft_Xxx")
	Subtitles[806]=(Text="Go! Go now! Hit him with the needle!",Speaker="Tenenbaum",Name="vo_R_7_Tn_HitWithNeedle")
	Subtitles[807]=(Text="What are you waiting for!? Hit him with the needle!",Speaker="Tenenbaum",Name="vo_R_7_Tn_HitNeedleDelay")
	Subtitles[808]=(Text="Come on now, kid... You wanna get serious?",Speaker="Frank Fontaine",Name="vo_S_7_Ft_PreFightTaunt1a")
	Subtitles[809]=(Text="You got nothing but deuces and threes kid!",Speaker="Frank Fontaine",Name="vo_S_7_Ft_PreFightTaunt2a")
	Subtitles[810]=(Text="You're busto, you hear me!? I'm just getting more jinx and you're spitting nickels!",Speaker="Frank Fontaine",Name="vo_S_7_Ft_PreFightTaunt3a")
	Subtitles[811]=(Text="Come on! Make a move if you're gonna make it...",Speaker="Frank Fontaine",Name="vo_S_7_Ft_PreFightTaunt4a")
	Subtitles[812]=(Text="I've got Adam flowing into me, kid. You think you got power? You're twenty watts and I'm the lights 'a Broadway.",Speaker="Frank Fontaine",Name="vo_S_7_Ft_PreFightTaunt5a")
	Subtitles[813]=(Text="You think you can take me down? Who do you think it was who built you in the first place?",Speaker="Frank Fontaine",Name="vo_S_7_Ft_PreFightTaunt6a")
	Subtitles[814]=(Text="When I'm done with you, I'm coming for Mother Goose and all her little eggs!",Speaker="Frank Fontaine",Name="vo_S_7_Ft_PreFightTaunt7a")
	Subtitles[815]=(Text="You think I'm alone in this world? I've got more than enough mugs to watch my back while I recharge!",Speaker="Frank Fontaine",Name="vo_S_7_Ft_Recharge")
	Subtitles[816]=(Text="I had you built! I sent you top side! I called you back, showed you what you was, what you was capable of! Even that life you thought you",Speaker="Frank Fontaine",Name="vo_S_7_Ft_Final2a")
	Subtitles[817]=(Text="had, that was something I dreamed up and had tattooed inside your head. Now, if you don't call that family, I don't know what is. And now-",Speaker="Frank Fontaine",Name="vo_S_7_Ft_Final2a")
	Subtitles[818]=(Text="They're all dying. For months, they are fine, and then...poof. And from what? Influenza. The goddamned flu. The little things are virtually indestructible. A bullet, they heal. Fire, they heal. But if they catch the bug, boom, they are gone in",Speaker="Tenenbaum",Name="vo_L_99_Tn_GathererFlu")
	Subtitles[819]=(Text="days. Something about the implantation process. Only one of them remains, und she must be resistant to this particular strain. This one little girl. One set of genes. Even if all the others die, it will be enough to save the program from extinction.",Speaker="Tenenbaum",Name="vo_L_99_Tn_GathererFlu")
	Subtitles[820]=(Text="You have shown kindness to my Little Ones...but are you really a friend to us? Regardless, a Little One brings you a gift to demonstrate our appreciation.",Speaker="Tenenbaum",Name="vo_R_99_Tn_Gathererreward1a")
	Subtitles[821]=(Text="Even in the gathering dark, you light a candle. You have saved the Little Ones when you might have shown your cruelty. I'm sending something your way to demonstrate our thanks.",Speaker="Tenenbaum",Name="vo_R_99_Tn_Gathererreward2a")
	Subtitles[822]=(Text="The Little Ones have never had anyone to look to...except for me...and I am not much to speak of. You give them hope. And for this, I am grateful. I'll send something to demonstrate that gratitude.",Speaker="Tenenbaum",Name="vo_R_99_Tn_Gathererreward3a")
	Subtitles[823]=(Text="I've seen such terrible things. And done worse myself. Thank you for reminding me that the light of the world has not yet been snuffed out. I'm sending a Little One to help you on your way.",Speaker="Tenenbaum",Name="vo_R_99_Tn_Gathererreward4a")
	Subtitles[824]=(Text="Adam improved every aspect of man...except his character. Perhaps there is a plasmid that can grow the spirit. Perhaps in your DNA this secret lies. I've sent a Little One with some goodies to help ease your burden.",Speaker="Tenenbaum",Name="vo_R_99_Tn_Gathererreward5a")
	Subtitles[825]=(Text="What can I really do for these Little Ones? I am tainted by sins. But you...perhaps you unlock a future for them that I cannot even imagine. A Little One heads your way with a gift ...please, be careful.",Speaker="Tenenbaum",Name="vo_R_99_Tn_Gathererreward6a")
	Subtitles[826]=(Text="That door just needs some juice and she'll open right up. Hit her with the electro bolt.",Speaker="Atlas",Name="vo_R_99_At_HitWithElectro")
	Subtitles[827]=(Text="Now go on, son. Hit the door with the electro bolt...you wanna live down here?",Speaker="Atlas",Name="vo_R_99_At_HitWithElectroB")
	Subtitles[828]=(Text="It's a wounded world, is it not? How can I thank you for this kindness? I send another Little One with a token of our appreciation.",Speaker="Tenenbaum",Name="vo_R_99_Tn_Gathererreward7a")
	Subtitles[829]=(Text="My daddy's smarter than Einstein, stronger than Hercules, and lights a fire with a snap of his finger! Are you as good as my daddy, mister? Not if you don't visit the Gatherer's Garden, you aren't! Smart daddies get spliced at the Garden!",Speaker="Plasmid Machine",Name="vo_S_99_Pz_GrowthAd")
	Subtitles[830]=(Text="That's the one that saved us.",Speaker="Little Sister",Name="vo_S_99_Ga_GathTenThanks1a")
	Subtitles[831]=(Text="There he is! The one that saved us!",Speaker="Little Sister",Name="vo_S_99_Ga_GathTenThanks2a")
	Subtitles[832]=(Text="It's him! It's him! He's the one who helps us!",Speaker="Little Sister",Name="vo_S_99_Ga_GathTenThanks3a")
	Subtitles[833]=(Text="Thank you, mister! Thanks for saving us!",Speaker="Little Sister",Name="vo_S_99_Ga_GathTenThanks4a")
	Subtitles[834]=(Text="Thank you! Thank you so much!",Speaker="Little Sister",Name="vo_S_99_Ga_GathTenThanks5a")
	Subtitles[835]=(Text="Security Alert in progress. Bulkhead seals inoperative.",Speaker="Announcer",Name="vo_S_99_Fa_NoTransitionF")
	Subtitles[836]=(Text="The Parasite has his eye on Rapture. Keep your eye on the Parasite.",Speaker="Announcer",Name="vo_PA_99_Fa_ResponsibilityPA2F")
	Subtitles[837]=(Text="The smuggler is the friend of the Parasite. It is your duty to report the smuggler.",Speaker="Announcer",Name="vo_PA_99_Fa_ResponsibilityPA6F")
	Subtitles[838]=(Text="Atlas is a friend of the Parasite. Don't be a friend of Atlas.",Speaker="Announcer",Name="vo_PA_99_Fa_ResponsibilityPA3F")
	Subtitles[839]=(Text="Rumor is the tool of the Parasite. Fontaine is dead. Rapture lives.",Speaker="Announcer",Name="vo_PA_99_Fa_ResponsibilityPA4F")
	Subtitles[840]=(Text="Approaching a Little Sister is a criminal offense. Do not approach the Little Sisters.",Speaker="Announcer",Name="vo_PA_99_Fa_ResponsibilityPA5F")
	Subtitles[841]=(Text="Ignore the lies of Atlas and his Parasites. Rapture is on the rise.",Speaker="Announcer",Name="vo_PA_99_Fa_ResponsibilityPA8F")
	Subtitles[842]=(Text="Andrew Ryan reminds us: We all make choices, but in the end...our choices make us.",Speaker="Announcer",Name="vo_PA_99_Fa_ResponsibilityPA9F")
	Subtitles[843]=(Text="The Parasite hates three things: free markets, free will, and free men.",Speaker="Announcer",Name="vo_PA_99_Fa_ResponsibilityPA10F")
	Subtitles[844]=(Text="We all move the Great Chain, and the Great Chain moves us all.",Speaker="Announcer",Name="vo_PA_99_Fa_WinnersPAF")
	Subtitles[845]=(Text="Get right quick, try Plasmi Quick! PlasmiQuik: Your Body, Your Way!",Speaker="Announcer",Name="vo_PA_99_Fa_PlasmiQuickPAF")
	Subtitles[846]=(Text="Andrew Ryan asks you a simple question: are you a man, or a slave?",Speaker="Announcer",Name="vo_PA_99_Fa_ResponsibilityPAF")
	Subtitles[847]=(Text="In the garden we are growin' Many changes will be flowin' If you want to be amazin' See the flowers we are raising",Speaker="Plasmid Machine",Name="vo_S_99_Pz_PlasSong2a")
	Subtitles[848]=(Text="I've sent you a care package with some supplies. You can pick it up at the nearest pneumo.",Speaker="Atlas",Name="vo_R_99_At_GenericSupplies")
	Subtitles[849]=(Text="That poor thing's seen better days",Speaker="Atlas",Name="vo_R_99_At_GenericBroken")
	Subtitles[850]=(Text="You keep your eyes peeled, now.",Speaker="Atlas",Name="vo_R_99_At_GenericTroubleA")
	Subtitles[851]=(Text="That sounded like trouble. You still in one piece, boyo?",Speaker="Atlas",Name="vo_R_99_At_GenericAfterA")
	Subtitles[852]=(Text="That didn't sound good. Everything okay down there?",Speaker="Atlas",Name="vo_R_99_At_GenericAfterB")
	Subtitles[853]=(Text="Sounds like nasty things are stirring. You keep a watch out, now.",Speaker="Atlas",Name="vo_R_99_At_NastyThingsStirring")
	Subtitles[854]=(Text="Everything all right there? Sounds like the whole world's coming apart!",Speaker="Atlas",Name="vo_R_99_At_ComingApart")
	Subtitles[855]=(Text="What is the greatest lie ever created?",Speaker="",Name="vo_S_99_Ry_LongSpeechA")
	Subtitles[856]=(Text="What is the most vicious obscenity ever perpetrated on mankind?",Speaker="",Name="vo_S_99_Ry_LongSpeechA")
	Subtitles[857]=(Text="Slavery? The Holocaust? Dictatorship?",Speaker="",Name="vo_S_99_Ry_LongSpeechA")
	Subtitles[858]=(Text="No. It's the tool with which all that wickedness is built: altruism.",Speaker="",Name="vo_S_99_Ry_LongSpeechA")
	Subtitles[859]=(Text="Whenever anyone wants others to do their work, they call upon their altruism. 'Never mind your own needs,' they say 'think of the needs of... of... whoever.' Of the state, of the poor, of the army, of the king, of God. The list goes on and on.",Speaker="",Name="vo_S_99_Ry_LongSpeechA")
	Subtitles[860]=(Text="How many catastrophes were launched with the words 'think of yourself?' It's the king and country crowd who light the torch of destruction.",Speaker="",Name="vo_S_99_Ry_LongSpeechA")
	Subtitles[861]=(Text="It is this great inversion, this ancient lie, which has chained humanity to an endless cycle of guilt and failure.",Speaker="",Name="vo_S_99_Ry_LongSpeechA")
	Subtitles[862]=(Text="My journey to Rapture was my second exodus.",Speaker="",Name="vo_S_99_Ry_LongSpeechB")
	Subtitles[863]=(Text="In 1919, I fled a country that had been traded in depotism for ...insanity. The Marxist Revolution simply traded one lie for another. Instead of one man, the Tsar, owning the work of all the people, all the people owned the work of all of the people. And so, I came to America, where a man could own his own work. Where a man could benefit from the brilliance of his own mind, the strength of his own muscles, the might of his own will.",Speaker="",Name="vo_S_99_Ry_LongSpeechB")
	Subtitles[864]=(Text="For a time, I thought I had found Paradise.",Speaker="",Name="vo_S_99_Ry_LongSpeechB")
	Subtitles[865]=(Text="I had thought I had left the Parasites of Moscow behind me. I had thought I had left the Marxist altruists to their collective farms and their five year plans. But as the German fools threw themselves on Hitler's sword for the good of the Reich, the Americans drank deeper and deeper of the Bolshevik poison spoonfed to them by Roosevelt and his 'New Dealers.'",Speaker="",Name="vo_S_99_Ry_LongSpeechB")
	Subtitles[866]=(Text="And so, I asked myself, in what country was there a place for men like me? Men who refused to say yes to the Parasites and the Doubters? Men who believed that work was sacred, and property rights inviolate? And then, one day, the happy answer came to me, my friends: there was no country for people like me.",Speaker="",Name="vo_S_99_Ry_LongSpeechB")
	Subtitles[867]=(Text="And that was the moment I decided to build one.",Speaker="",Name="vo_S_99_Ry_LongSpeechB")
	Subtitles[868]=(Text="Freeze your enemies.  Shatter them into a thousand pieces.",Speaker="Announcer",Name="vo_S_99_Fa_CryoA")
	Subtitles[869]=(Text="Enrage your enemies.  Laugh as your enemies fight each other.",Speaker="Announcer",Name="vo_S_99_Fa_EnrageA")
	Subtitles[870]=(Text="Trick the security system.  Set security bots and turrets on your enemies.",Speaker="Announcer",Name="vo_S_99_Fa_SecBeaconA")
	Subtitles[871]=(Text="Distract your enemies.  Buy yourself time in dangerous situations.",Speaker="Announcer",Name="vo_S_99_Fa_DecoyA")
	Subtitles[872]=(Text="Unleash insects against groups of monsters.  Attack lots of enemies at the same time.",Speaker="Announcer",Name="vo_S_99_Fa_InsectA")
	Subtitles[873]=(Text="Set traps for unsuspecting enemies.  Lure your foes into deadly ambushes.",Speaker="Announcer",Name="vo_S_99_Fa_VortexA")
	Subtitles[874]=(Text="Cry out for Big Daddy's help Make him think you're a Little Sister Watch as he fights to protect you",Speaker="Announcer",Name="vo_S_99_Fa_Befriend")
	Subtitles[875]=(Text="What is the greatest lie ever created?",Speaker="",Name="vo_S_99_Ry_ShortSpeechA")
	Subtitles[876]=(Text="What is the most vicious obscenity ever perpetrated on mankind?",Speaker="",Name="vo_S_99_Ry_ShortSpeechA")
	Subtitles[877]=(Text="Slavery? The Holocaust? Dictatorship?",Speaker="",Name="vo_S_99_Ry_ShortSpeechA")
	Subtitles[878]=(Text="No. It's the tool with which all that wickedness is built: altruism.",Speaker="",Name="vo_S_99_Ry_ShortSpeechA")
	Subtitles[879]=(Text="Whenever anyone wants others to do their work, they call upon their altruism. 'Never mind your own needs,' they say 'think of the needs of... of... whoever.' Of the state, of the poor, of the army, of the king, of God. The list goes on and on.",Speaker="",Name="vo_S_99_Ry_ShortSpeechB")
	Subtitles[880]=(Text="How many catastrophes were launched with the words 'think of yourself?' It's the king and country crowd who light the torch of destruction.",Speaker="",Name="vo_S_99_Ry_ShortSpeechB")
	Subtitles[881]=(Text="It is this great inversion, this ancient lie, which has chained humanity to an endless cycle of guilt and failure.",Speaker="",Name="vo_S_99_Ry_ShortSpeechB")
	Subtitles[882]=(Text="My journey to Rapture was my second exodus.",Speaker="",Name="vo_S_99_Ry_ShortSpeechC")
	Subtitles[883]=(Text="In 1919, I fled a country that had been traded in depotism for ...insanity. The Marxist Revolution simply traded one lie for another. Instead of one man, the Tsar, owning the work of all the people, all the people owned the work of all of the people. And so, I came to America, where a man could own his own work. Where a man could benefit from the brilliance of his own mind, the strength of his own muscles, the might of his own will.",Speaker="",Name="vo_S_99_Ry_ShortSpeechC")
	Subtitles[884]=(Text="For a time, I thought I had found Paradise.",Speaker="",Name="vo_S_99_Ry_ShortSpeechC")
	Subtitles[885]=(Text="I had thought I had left the Parasites of Moscow behind me. I had thought I had left the Marxist altruists to their collective farms and their five year plans. But as the German fools threw themselves on Hitler's sword for the good of the Reich, the Americans drank deeper and deeper of the Bolshevik poison spoonfed to them by Roosevelt and his 'New Dealers.'",Speaker="",Name="vo_S_99_Ry_ShortSpeechD")
	Subtitles[886]=(Text="And so, I asked myself, in what country was there a place for men like me? Men who refused to say yes to the Parasites and the Doubters? Men who believed that work was sacred, and property rights inviolate? And then, one day, the happy answer came to me, my friends: there was no country for people like me.",Speaker="",Name="vo_S_99_Ry_ShortSpeechD")
	Subtitles[887]=(Text="And that was the moment I decided to build one.",Speaker="",Name="vo_S_99_Ry_ShortSpeechD")
	Subtitles[888]=(Text="It won't go well...it won't go well at all.",Speaker="Fortune Teller",Name="vo_S_99_Fn_GoWell")
	Subtitles[889]=(Text="So, you think you're getting out of here?",Speaker="Fortune Teller",Name="vo_S_99_Fn_GettingOut")
	Subtitles[890]=(Text="I wouldn't bet on you.",Speaker="Fortune Teller",Name="vo_S_99_Fn_BetOnYou")
	Subtitles[891]=(Text="Hmmm...no.",Speaker="Fortune Teller",Name="vo_S_99_Fn_HmmNo")
	Subtitles[892]=(Text="Ah...better luck next time.",Speaker="Fortune Teller",Name="vo_S_99_Fn_BetterLuck")
	Subtitles[893]=(Text="Maybe you should ask somebody else.",Speaker="Fortune Teller",Name="vo_S_99_Fn_SomebodyElse")
	Subtitles[894]=(Text="Ah...you must have done something to somebody.",Speaker="Fortune Teller",Name="vo_S_99_Fn_DoneSomething")
	Subtitles[895]=(Text="Hmmm...I wouldn't want to be in your shoes.",Speaker="Fortune Teller",Name="vo_S_99_Fn_InYourShoes")
	Subtitles[896]=(Text="Well...I hope you have somebody to carry on your family name.",Speaker="Fortune Teller",Name="vo_S_99_Fn_FamilyName")
	Subtitles[897]=(Text="Well...maybe it will be quick and painless.",Speaker="Fortune Teller",Name="vo_S_99_Fn_Painless")
	Subtitles[898]=(Text="So, do you have plot picked out yet?",Speaker="Fortune Teller",Name="vo_S_99_Fn_PlotPickedOut")
	Subtitles[899]=(Text="Just close your eyes and hope it's over quickly...",Speaker="Fortune Teller",Name="vo_S_99_Fn_OverQuickly")
	Subtitles[900]=(Text="THIEF! Kill him!",Speaker="Male Splicer",Name="vo_S_99_Pi_ThiefA")
	Subtitles[901]=(Text="Filthy little thief!",Speaker="Male Splicer",Name="vo_S_99_Pi_ThiefB")
	Subtitles[902]=(Text="THIEF! Kill him!",Speaker="Male Splicer",Name="vo_S_99_Wa_ThiefA")
	Subtitles[903]=(Text="Filthy little thief!",Speaker="Male Splicer",Name="vo_S_99_Wa_ThiefB")
	Subtitles[904]=(Text="(disembodied, whispered) Mooore? You want some more, greedy little piglet?",Speaker="Male Splicer",Name="vo_S_99_Wa_More")
	Subtitles[905]=(Text="You got greedy, didn't you!",Speaker="Male Splicer",Name="vo_S_99_Wa_Greedy")
	Subtitles[906]=(Text="Amazing Grace verse 1",Speaker="Female Splicer",Name="vo_S_99_Rb_SongA")
	Subtitles[907]=(Text="Amazing Grace verse 2",Speaker="Female Splicer",Name="vo_S_99_Rb_SongB")
	Subtitles[908]=(Text="Amazing Grace verse 3",Speaker="Female Splicer",Name="vo_S_99_Rb_SongC")
	Subtitles[909]=(Text="Amazing Grace verse 4",Speaker="Female Splicer",Name="vo_S_99_Rb_SongD")
	Subtitles[910]=(Text="Knock foes back with hurricane force, laugh as they bounce off the walls.",Speaker="Announcer",Name="vo_S_99_Fa_AirBlast")
	Subtitles[911]=(Text="Stun your foes with a thousand bolts. Shock them in water to deal damage.",Speaker="Announcer",Name="vo_S_99_Fa_ElectroBolt")
	Subtitles[912]=(Text="Light up foes to a thousand degrees. Warning: fire spreads.",Speaker="Announcer",Name="vo_S_99_Fa_Incinerate")
	Subtitles[913]=(Text="Throw objects at foes. Even catch grenades and throw them back.",Speaker="Announcer",Name="vo_S_99_Fa_Telekinesis")
	Subtitles[914]=(Text="THIEF! Kill him!",Speaker="Female Splicer",Name="vo_S_99_Bj_ThiefA")
	Subtitles[915]=(Text="Filthy little thief!",Speaker="Female Splicer",Name="vo_S_99_Bj_ThiefB")
	Subtitles[916]=(Text="Dance with me.",Speaker="Female Splicer",Name="vo_S_99_Bj_Dance")
	Subtitles[917]=(Text="(Quarter to Nine song)The stars are gonna twinkle and shine. This evening, about a quarter to nine. My loving arms, are gonna tenderly twine - tw-tw-twine. Around you, around a quarter to nine.",Speaker="Female Splicer",Name="vo_S_99_Bj_Song_4")
	Subtitles[918]=(Text="Here is Suchong's problem- Little Ones are repulsed by the look and the smell of corpses. Must find a way to make gathering task more",Speaker="Suchong",Name="vo_L_99_Sg_GathCorpses")
	Subtitles[919]=(Text="attractive...maybe if we programmed them to see bodies as something more appealing - kitties, chocolate bar...some other stupid thing these children enjoy.",Speaker="Suchong",Name="vo_L_99_Sg_GathCorpses")
	Subtitles[920]=(Text="Come back when you get some money, buddy!",Speaker="Plasmid Machine",Name="vo_S_99_Pz_MoneyBuddy")
	Subtitles[921]=(Text="(laughter) Kill your cravings at the Circus of Values!",Speaker="Plasmid Machine",Name="vo_S_99_Pz_KillCravings")
	Subtitles[922]=(Text="Bienvenido al Ammo Vandido!",Speaker="Plasmid Machine",Name="vo_S_99_Pz_AmmoBand")
	Subtitles[923]=(Text="Bienvenido al Vandido de amunicion",Speaker="Plasmid Machine",Name="vo_S_99_Pz_MuniBand")
	Subtitles[924]=(Text="No dinero, no ammo!",Speaker="Plasmid Machine",Name="vo_S_99_Pz_NoDinero")
	Subtitles[925]=(Text="Muchas gracias, senor!",Speaker="Plasmid Machine",Name="vo_S_99_Pz_MuchasGracias")
	Subtitles[926]=(Text="(Bandito) Hey, I have a family to feed!",Speaker="Plasmid Machine",Name="vo_S_99_Pz_BandFamily")
	Subtitles[927]=(Text="Hey... Yo tengo que dar de comer a mi familia!",Speaker="Plasmid Machine",Name="vo_S_99_Pz_BandFamEsp")
	Subtitles[928]=(Text="(Bandito laugh)",Speaker="Plasmid Machine",Name="vo_S_99_Pz_BandLaugh")
	Subtitles[929]=(Text="Hey, I've gotta family to feed!",Speaker="Plasmid Machine",Name="vo_S_99_Pz_FamilyFeed")
	Subtitles[930]=(Text="No refunds, no returns!",Speaker="Plasmid Machine",Name="vo_S_99_Pz_NoRefunds")
	Subtitles[931]=(Text="Choose wisely, and you may get a treat",Speaker="Announcer",Name="vo_S_99_Ad_PavlovTreat")
	Subtitles[932]=(Text="A man has a choice. I chose the impossible. I built a city where the artist would not fear censor, where the great would not be constrained by the small, where the scientist would not be bound by petty morality. I chose to",Speaker="Andrew Ryan",Name="vo_S_99_Ry_AManHasAChoice")
	Subtitles[933]=(Text="build Rapture! But my city was betrayed by the weak. So I ask you my friend, if your life was the prize, would you kill the innocent? Would you sacrifice your humanity? We all make choices, but in the end our choices make us.",Speaker="Andrew Ryan",Name="vo_S_99_Ry_AManHasAChoice")
	Subtitles[934]=(Text="Jim: Hey, Mary. Everything okay?   Mary: Did you hear that Andrew Ryan took control of Fontaine Futuristics?! I'm hopping mad!   Jim: Slow down there, little lady.   Mary: Sorry, Jim, but I'm real upset. We came to Rapture to get",Speaker="Jim",Name="vo_PA_99_Jp_PropaFontaineSeq")
	Subtitles[935]=(Text="away from government muscling in on private business people.   Jim: Sure thing, Mary. But Andrew Ryan didn't 'take control' of anything. The government council just assumed stewardship of Fontaine Futuristics until all of Frank Fontaine's",Speaker="Jim",Name="vo_PA_99_Jp_PropaFontaineSeq")
	Subtitles[936]=(Text="crimes and betrayals against the people of Rapture are sorted out. Pretty soon, everything will be back to normal!   Mary: Really? Well, that's a weight off my shoulders!   Jim: Remember, Mary- doubting the council only emboldens the bandits!",Speaker="Jim",Name="vo_PA_99_Jp_PropaFontaineSeq")
	Subtitles[937]=(Text="Jim: Hey Mary, why so down in the mouth?   Mary: I don't know, Jim. I guess I just don't know how I feel about those Little Sisters.   Jim: The Little Sisters? Gee! Don't you know they're the glue that holds Rapture together?",Speaker="Jim",Name="vo_PA_99_Jp_PropaLilSisSeq")
	Subtitles[938]=(Text="Mary: Really?   Jim: You betcha! Ryan Industries has seen to it that they're bred to be as happy as clams while they do the work that keeps us safe from the bandits and terrorists! We all need Adam...and we all need the Little Sisters!",Speaker="Jim",Name="vo_PA_99_Jp_PropaLilSisSeq")
	Subtitles[939]=(Text="Jim: Hey Mary! Going to the big game tonight? I heard Ryan's Raiders are playing.   Mary: No way, Jim. It's not safe. Haven't you heard? Atlas' bandits are everywhere!   Jim:",Speaker="Jim",Name="vo_PA_99_Jp_PropaGameSeq")
	Subtitles[940]=(Text="Hold on a second there! Remember what Andrew Ryan says! If you do that, the bandits win! Take your family to Fort Frolic and Arcadia! Go out and shop! It's the Rapture way of life!",Speaker="Jim",Name="vo_PA_99_Jp_PropaGameSeq")
	Subtitles[941]=(Text="Jim: What's wrong, Mary? You look like you just heard some terrible news!   Mary: Capital punishment! In Rapture! This isn't what I signed up for!   Jim: Now hold on there, pretty",Speaker="Jim",Name="vo_PA_99_Jp_PropaCapitalSeq")
	Subtitles[942]=(Text="lady. The only people who face capital punishment in Rapture are smugglers, and that's because they put everything we work for at risk. Imagine if the Soviets found out about our wonderful",Speaker="Jim",Name="vo_PA_99_Jp_PropaCapitalSeq")
	Subtitles[943]=(Text="city! Or even the US government. Our secrecy is our shield!   Mary: A little capital punishment is a small price to pay to protect all of our freedoms!   Jim: Now you're talking, Mary!",Speaker="Jim",Name="vo_PA_99_Jp_PropaCapitalSeq")
	Subtitles[944]=(Text="Jim: What's the matter, Mary? You look like you could use a boost!   Mary: I don't feel so great. I'm dizzy, I'm nauseous, and sometimes I'm even seeing things that aren't there.",Speaker="Jim",Name="vo_PA_99_Jp_PropaPlasmidsSeq")
	Subtitles[945]=(Text="Jim: That's just the plasmid blues, Mary. You just need to slow down a bit on the splicing. Before you know it, you'll be as right as rain. Remember, a smart splicer is a happy splicer.",Speaker="Jim",Name="vo_PA_99_Jp_PropaPlasmidsSeq")
	Subtitles[946]=(Text="Jim: Hey Mary! What's with the sour puss?   Mary: Have you heard what's going on down in Apollo Square? I hear they're putting people in cages.   Jim: There you go again, Mary,",Speaker="Jim",Name="vo_PA_99_Jp_PropaSquareSeq")
	Subtitles[947]=(Text="listening to the rumor bug! Rapture security is just rounding up the worst of the worst until the council can try them in a proper forum.   Mary: People say there have been",Speaker="Jim",Name="vo_PA_99_Jp_PropaSquareSeq")
	Subtitles[948]=(Text="executions!   Jim: People say lots of irresponsible things. That doesn't mean you have to embolden Atlas and his bandits by repeating them. Remember, Mary. Rapture's security is our security...",Speaker="Jim",Name="vo_PA_99_Jp_PropaSquareSeq")
	Subtitles[949]=(Text="Mr. Bubbles, Mr. Bubbles. Are you there? Are you there? Come and give me lollies, come and bring me toffees. Teddy Bears, Teddy Bears.",Speaker="Little Sister",Name="vo_S_99_Ga_SongOne")
	Subtitles[950]=(Text="(singing) It's so good for, so new for you, to see someone in such a stew for you, and when I say I'd do all I could for you, it's so good for you",Speaker="Female Splicer",Name="vo_S_1_La_BadForMe")
	Subtitles[951]=(Text="(Lyrics) If I didn't care more than words can say... If I didn't care would I feel this way? If this isn't love then why do I thrill?",Speaker="Female Splicer",Name="vo_S_1_Lf_Xxx")
	Subtitles[952]=(Text="Sounds like another tunnel collapse. Welcome to Rapture, the world's fastest growing pile of junk.",Speaker="Atlas",Name="vo_R_1_At_CollapsingHeadRight")
	Subtitles[953]=(Text="Tenenbaum: Bitte, do not hurt her! Have you no heart?",Speaker="",Name="vo_R_1_At_GathSaveSequence")
	Subtitles[954]=(Text="Atlas: Aye, that's a pretty sermon coming from the ghoul who cooked up them creatures in the first place. Took fine little girls and turned them into that, didn't you? Listen to me, boyo: you won't survive without the Adam those...things...are carrying. Are you prepared to trade your life, the lives of my wife and child for Tenenbaum's little Frankensteins?",Speaker="",Name="vo_R_1_At_GathSaveSequence")
	Subtitles[955]=(Text="Tenenbaum: Here! There is another way...use this, free them from their torment...I will make it to be worth your while...somehow.",Speaker="",Name="vo_R_1_At_GathSaveSequence")
	Subtitles[956]=(Text="Why do we have two eyes? Is there some law that says we must? Two arms, two legs, two ears, two breasts.",Speaker="Doctor Steinman",Name="vo_S_1_St_WhyTwo")
	Subtitles[957]=(Text="Andrew Ryan: 'Ryan Corp maintains EXCLUSIVE rights to the creation, use, and exploitation of the Lazarus Vector.' Ownership is civilization, Julie. Without it, we're back in the swamp...",Speaker="",Name="vo_S_3_Ry_LangDieSequence")
	Subtitles[958]=(Text="Langford: Mr. Ryan...Wait...No! Please! ...Mr. Ryan! ....",Speaker="",Name="vo_S_3_Ry_LangDieSequence")
	Subtitles[959]=(Text="I'm Sander FUCKING Cohen!",Speaker="Sander Cohen",Name="vo_R_4_Co_SanderFuckingCohen")
	Subtitles[960]=(Text="Allow me to draw back the curtain...",Speaker="Sander Cohen",Name="vo_R_4_Co_DoorOpenB")
	Subtitles[961]=(Text="Suchong: Is that your puppy? She's very pretty...   Little Boy: Thank you, Papa Suchong   Suchong: Break her neck for me.   Little Boy: What?   Suchong:",Speaker="Suchong",Name="vo_L_5_Sg_PuppyScene")
	Subtitles[962]=(Text="Break that sweet puppy's neck.   Little Boy: No...please...   Suchong: Break that puppy's neck- would you kindly...   Little Boy: No...no...   Suchong: Very good",Speaker="Suchong",Name="vo_L_5_Sg_PuppyScene")
	Subtitles[963]=(Text="Watch out, mister!",Speaker="Little Sister",Name="vo_S_5_Ga_SavePlayerA")
	Subtitles[964]=(Text="Come with me!",Speaker="Little Sister",Name="vo_S_5_Ga_SavePlayerB")
	Subtitles[965]=(Text="Follow me.",Speaker="Little Sister",Name="vo_S_5_Ga_SavePlayerC")
	Subtitles[966]=(Text="Mama Tenenbaum said he'll help us",Speaker="Little Sister",Name="vo_S_6_Ga_GathColor")
	Subtitles[967]=(Text="Who's he?",Speaker="Little Sister",Name="vo_S_6_Ga_SafeHouseA")
	Subtitles[968]=(Text="That's mine!",Speaker="Little Sister",Name="vo_S_6_Ga_SafeHouseB")
	Subtitles[969]=(Text="Hey!",Speaker="Little Sister",Name="vo_S_6_Ga_SafeHouseC")
	Subtitles[970]=(Text="Why do you help us?",Speaker="Little Sister",Name="vo_S_6_Ga_SafeHouseGoodA")
	Subtitles[971]=(Text="There he is... the one who will save us all!",Speaker="Little Sister",Name="vo_S_6_Ga_SafeHouseGoodB")
	Subtitles[972]=(Text="I like him!",Speaker="Little Sister",Name="vo_S_6_Ga_SafeHouseGoodC")
	Subtitles[973]=(Text="He's the one who saved me.",Speaker="Little Sister",Name="vo_S_6_Ga_SafeHouseGoodD")
	Subtitles[974]=(Text="He's here to help us!",Speaker="Little Sister",Name="vo_S_6_Ga_SafeHouseGoodE")
	Subtitles[975]=(Text="Mama Tenenbaum says stay away from him!",Speaker="Little Sister",Name="vo_S_6_Ga_SafeHouseBadA")
	Subtitles[976]=(Text="He's mean!",Speaker="Little Sister",Name="vo_S_6_Ga_SafeHouseBadB")
	Subtitles[977]=(Text="He's the one who hurts us.",Speaker="Little Sister",Name="vo_S_6_Ga_SafeHouseBadC")
	Subtitles[978]=(Text="Stay away from him!",Speaker="Little Sister",Name="vo_S_6_Ga_SafeHouseBadD")
	Subtitles[979]=(Text="Get him!",Speaker="Little Sister",Name="vo_S_7_Ga_BossFightEndA")
	Subtitles[980]=(Text="Come on! Come on!",Speaker="Little Sister",Name="vo_S_7_Ga_BossFightEndB")
	Subtitles[981]=(Text="Let's go!",Speaker="Little Sister",Name="vo_S_7_Ga_BossFightEndC")
	Subtitles[982]=(Text="This way!",Speaker="Little Sister",Name="vo_S_7_Ga_BossFightEndD")
	Subtitles[983]=(Text="They offered you everything, yes? And in return, you gave them what you always did: brutality.    You took what you wanted: all the Adam, all the power. And Rapture trembled. But in the end,",Speaker="Tenenbaum",Name="vo_S_7_Tn_BadEnding")
	Subtitles[984]=(Text="even Rapture was not enough for you.    Your father was terrified the world would try to steal the secrets of his city. But not you...for you now have stolen the terrible secrets of the world...",Speaker="Tenenbaum",Name="vo_S_7_Tn_BadEnding")
	Subtitles[985]=(Text="They offered you the city. And you refused it.    And what did you do instead? What you always did.    You saved them.    You gave them the one thing that was stolen from them: A chance.    A",Speaker="Tenenbaum",Name="vo_S_7_Tn_GoodEnding")
	Subtitles[986]=(Text="chance to learn.    To find love.    To live.    And in the end, what was your reward?    You never said. But I think I know.    (alt) They were.    (alt) Them.    (possible) and they know, too.",Speaker="Tenenbaum",Name="vo_S_7_Tn_GoodEnding")
	Subtitles[987]=(Text="They offered you everything, yes? And in return you gave them what I have come to expect of you: brutality. You took what you wanted: all the Adam, all the power...and Rapture trembled. But in",Speaker="Tenenbaum",Name="vo_S_7_Tn_EndMediocre")
	Subtitles[988]=(Text="the end even Rapture was not enough for you. Your father was terrified the world would try to steal the secrets of his city. But not you, for now you have stolen the terrible secrets of the world.",Speaker="Tenenbaum",Name="vo_S_7_Tn_EndMediocre")
	Subtitles[989]=(Text="Rise, Rapture Rise. We turn our hopes up to the skies. Rise Rapture, Rise! Upon your wings our dreams will fly. A city in the ocean's deep. A promise that we'll always keep. To boldly turn our eyes upon the prize. So, Rise! Rise!",Speaker="Announcer",Name="vo_S_99_Ad_RiseRaptureRise")
	Subtitles[990]=(Text="Rise! O Rise, Rapture, rise! We merrily sing this reprise! O Rise Rapture rise! To help us crush parasites: despised. A city on Poseidon's floor. A set of ideals we adore. A philosophy we all can emphasize. So rise! Rise! Riiiise!",Speaker="Announcer",Name="vo_S_99_Ad_RiseRaptureRise")
	Subtitles[991]=(Text="Thank you...thank you...",Speaker="Little Sister",Name="vo_S_99_Ga_GathOnSave1a")
	Subtitles[992]=(Text="Thank you, mister...thank you...",Speaker="Little Sister",Name="vo_S_99_Ga_GathOnSave2b")
	Subtitles[993]=(Text="You saved me...",Speaker="Little Sister",Name="vo_S_99_Ga_GathOnSave3c")
	Subtitles[994]=(Text="Thank you...thank you for helping me...",Speaker="Little Sister",Name="vo_S_99_Ga_GathOnSave4d")
	Subtitles[995]=(Text="Where...where am I?",Speaker="Little Sister",Name="vo_S_99_Ga_GathOnSave5e")
	Subtitles[996]=(Text="What...I'm...better?",Speaker="Little Sister",Name="vo_S_99_Ga_GathOnSave6f")
	Subtitles[997]=(Text="Thank you for helping me...",Speaker="Little Sister",Name="vo_S_99_Ga_GathOnSave7g")
	Subtitles[998]=(Text="(Medical voice) Could the doctor please report to surgery?",Speaker="Announcer",Name="vo_S_99_Ad_ReportSurgery")
	Subtitles[999]=(Text="(Medical voice) Nurse needed in viewing room three...",Speaker="Announcer",Name="vo_S_99_Ad_NurseNeeded")
	Subtitles[1000]=(Text="Viewing room three... (echo)",Speaker="Announcer",Name="vo_S_99_Ad_RoomThree")
	Subtitles[1001]=(Text="(Medical voice broken) Nurse . . . nurse . . . nurse . . . doctor . . .",Speaker="Announcer",Name="vo_S_99_Ad_NurseDoctor")
	Subtitles[1002]=(Text="7, 9, 7, 7, 7, 9, 3...",Speaker="Announcer",Name="vo_S_99_Ad_NumberStationA")
	Subtitles[1003]=(Text="4, 4, 7, 7, 3, 3, 7, 4, 4, 7, 7...",Speaker="Announcer",Name="vo_S_99_Ad_NumberStationB")
	Subtitles[1004]=(Text="A Rapture Reminder: wanting an item from the surface is forgivable, buying or smuggling one into Rapture is not. Stay on the level, and out of trouble.",Speaker="Announcer",Name="vo_S_99_Ad_ItemSurface")
	Subtitles[1005]=(Text="Who do you like better?",Speaker="Announcer",Name="vo_S_99_Ad_PavlovBetter")
	Subtitles[1006]=(Text="Which one can take the best care of you?",Speaker="Announcer",Name="vo_S_99_Ad_PavlovWhich")
	Subtitles[1007]=(Text="Welcome to the Circus of Values!",Speaker="Plasmid Machine",Name="vo_S_99_Pz_CircusValues")
	Subtitles[1008]=(Text="A Rapture Reminder: we all have bills to pay, and the temptation to break curfew to make a little extra Adam is forgivable. Breaking curfew is not. Stay on the level, and out of trouble!",Speaker="Announcer",Name="vo_S_99_Ad_BillPayAd")
	Subtitles[1009]=(Text="Wallet a little light? At Surgical Savings we'll happily work out an affordable payment plan for any major procedure. Potentially terminal illnesses won't wait until payday. Should you?",Speaker="Announcer",Name="vo_S_99_Ad_SurgicalSavingsAd")
	Subtitles[1010]=(Text="Hey there fellas. You know that nine out of ten ladies prefer the athletic men? Why stay on the sidelines? When the new SportsBoost line of plasmids can turn",Speaker="Announcer",Name="vo_S_99_Ad_SportsBoostAd")
	Subtitles[1011]=(Text="you into the jock you've always wanted to be. Come visit us at the Med Pavillion for a free two hour trial. You'll appreciate the difference, and she will too.",Speaker="Announcer",Name="vo_S_99_Ad_SportsBoostAd")
	Subtitles[1012]=(Text="Jim: 'What's the matter, Frank?' Frank: 'It's this thinning hair, Jim! Every day there's less and less.' Jim: 'You know the problem's not in your hair, it's in your genes.'",Speaker="Announcer",Name="vo_S_99_Ad_FreshHair")
	Subtitles[1013]=(Text="Frank: 'Hey, I don't go in for all that splicing stuff, my buddy says it's not safe.' Jim: 'Shows you what your buddy knows. Come to Genetic Horizons for a trial of Fresh",Speaker="Announcer",Name="vo_S_99_Ad_FreshHair")
	Subtitles[1014]=(Text="Hair. Fresh Hair not only gives you a full head of thick hair, but it's 100% safe.' Frank: 'Full head of hair? And 100% safe? Maybe it's time for me to get a little Fresh Hair!'",Speaker="Announcer",Name="vo_S_99_Ad_FreshHair")
	Subtitles[1015]=(Text="Can anyone ever make you feel like Sander Cohen can? Rapture's most beloved musical artist returns with 'Why Even Ask', his",Speaker="Announcer",Name="vo_S_99_Ad_WhyEvenAskAd")
	Subtitles[1016]=(Text="greatest album yet. Songs of love, songs of joy, songs of passion. Buy 'Why Even Ask' and invite Sander Cohen into your home, today.",Speaker="Announcer",Name="vo_S_99_Ad_WhyEvenAskAd")
	Subtitles[1017]=(Text="A Rapture Reminder: the bottom of the ocean is our home, but it can also be a dangerous place. Any leak is a bad leak. Report any unexplained water promptly to the Central Council.",Speaker="Announcer",Name="vo_S_99_Ad_LeakAd")
}