class BioshockMovementAction extends AI_MovementAction
	abstract
	native
	collapsecategories
	hidecategories(Object,InternalParameters);

function ShockAI ShockAI()
{
	return ShockAI(AI_MovementResource(resource).m_Pawn);
	return;
	@NULL
	CommanderAction
	stop;
	default.@NULL
}

function LevelInfo Level()
{
	return AI_MovementResource(resource).m_Pawn.Level;
	return;
	@NULL
	CommanderAction
	stop;
	default.@NULL
}
