class EscortGoal extends BioshockCharacterGoal
	collapsecategories
	hidecategories(Object,InternalParameters);

function NotifyGathererExitingVent()
{
	// End:0x2F
	if(__NFUN_119__(achievingAction, none))
	{
		EscortAction(achievingAction).NotifyGathererExitingVent();
		return;
		@NULL
		CommanderAction
	}
	CommanderAction
}

