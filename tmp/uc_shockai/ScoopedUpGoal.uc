class ScoopedUpGoal extends BioshockCharacterGoal
	collapsecategories
	hidecategories(Object,InternalParameters);

function NotifyStartScoopUp()
{
	// End:0x2F
	if(__NFUN_119__(achievingAction, none))
	{
		ScoopedUpAction(achievingAction).NotifyStartScoopUp();
		return;
		@NULL
		CommanderAction
	}
	CommanderAction
}

defaultproperties
{
	Priority=77
}