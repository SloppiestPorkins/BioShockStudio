<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:BioShockStudio.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="720"
        x:Class="BioShockStudio.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Width="1100" Height="720"
        Title="BioShock Remastered Model Studio">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <DockPanel Margin="12">

        <!-- Game location -->
        <Border DockPanel.Dock="Top" Padding="12" CornerRadius="6" Background="#20FFFFFF" Margin="0,0,0,10">
            <StackPanel Spacing="8">
                <TextBlock Text="BioShock Remastered installation" FontWeight="SemiBold" />
                <Grid ColumnDefinitions="*,Auto,Auto">
                    <TextBox Grid.Column="0" Text="{Binding GamePath}" Watermark="Path to the game folder" />
                    <Button Grid.Column="1" Content="Use this" Margin="8,0,0,0" Command="{Binding UsePathCommand}" />
                    <Button Grid.Column="2" Content="Detect" Margin="8,0,0,0" Command="{Binding DetectCommand}" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- Status and progress -->
        <Border DockPanel.Dock="Bottom" Padding="12" CornerRadius="6" Background="#20FFFFFF" Margin="0,10,0,0">
            <StackPanel Spacing="8">
                <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />
                <Grid ColumnDefinitions="*,Auto">
                    <ProgressBar Grid.Column="0" Value="{Binding Progress}" Maximum="100" Height="8"
                                 IsVisible="{Binding IsBusy}" />
                    <TextBlock Grid.Column="1" Margin="10,0,0,0" Text="{Binding ProgressText}" IsVisible="{Binding IsBusy}" />
                </Grid>
                <ScrollViewer MaxHeight="80" IsVisible="{Binding Log, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <TextBlock Text="{Binding Log}" FontFamily="Consolas" FontSize="11" Foreground="#FFB86B6B" />
                </ScrollViewer>
            </StackPanel>
        </Border>

        <!-- Packages -->
        <Border DockPanel.Dock="Left" Width="200" Padding="8" CornerRadius="6" Background="#18FFFFFF" Margin="0,0,10,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Packages" FontWeight="SemiBold" Margin="4,0,0,6" />
                <ListBox ItemsSource="{Binding Packages}" SelectedItem="{Binding SelectedPackage}" />
            </DockPanel>
        </Border>

        <!-- Browser -->
        <DockPanel>
            <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,8">
                <ComboBox Grid.Column="0" ItemsSource="{Binding Categories}"
                          SelectedItem="{Binding SelectedCategory}" MinWidth="140" />
                <TextBox Grid.Column="1" Margin="8,0,8,0" Text="{Binding Search}" Watermark="Search by name…" />
                <TextBlock Grid.Column="2" VerticalAlignment="Center"
                           Text="{Binding Assets.Count, StringFormat='{}{0} shown'}" Opacity="0.7" />
            </Grid>

            <Border DockPanel.Dock="Bottom" Padding="10" CornerRadius="6" Background="#18FFFFFF" Margin="0,8,0,0">
                <StackPanel Spacing="8">
                    <TextBlock Text="Output folder" FontWeight="SemiBold" />
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBox Grid.Column="0" Text="{Binding OutputDirectory}" />
                        <Button Grid.Column="1" Content="Open" Margin="8,0,0,0" Command="{Binding OpenOutputCommand}" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Extract selected" Command="{Binding ExtractSelectedCommand}"
                                IsEnabled="{Binding !IsBusy}" />
                        <Button Content="Extract everything shown" Command="{Binding ExtractVisibleCommand}"
                                IsEnabled="{Binding !IsBusy}" />
                        <Button Content="Cancel" Command="{Binding CancelCommand}" IsEnabled="{Binding IsBusy}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <DataGrid ItemsSource="{Binding Assets}" SelectedItem="{Binding SelectedAsset}"
                      IsReadOnly="True" GridLinesVisibility="Horizontal" CanUserSortColumns="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Type" Binding="{Binding Category}" Width="120" />
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="260" />
                    <DataGridTextColumn Header="Details" Binding="{Binding Detail}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </DockPanel>
</Window>
