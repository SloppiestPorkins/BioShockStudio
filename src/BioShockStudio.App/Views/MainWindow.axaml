<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:BioShockStudio.App.ViewModels"
        xmlns:diag="using:BioShockStudio.Core.Diagnostics"
        xmlns:services="using:BioShockStudio.Core.Services"
        xmlns:views="using:BioShockStudio.App.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="820"
        x:Class="BioShockStudio.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Width="1280" Height="820" MinWidth="960" MinHeight="600"
        Title="BioShockHavok">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Window.Resources>
        <!-- Transparency is shown against a checkerboard so an alpha channel is visible as one. -->
        <DrawingBrush x:Key="Checkerboard" TileMode="Tile"
                      SourceRect="0,0,16,16" DestinationRect="0,0,16,16">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#FF6E6E6E" Geometry="M0,0 L16,0 16,16 0,16Z" />
                    <GeometryDrawing Brush="#FF9A9A9A" Geometry="M0,0 L8,0 8,8 0,8Z M8,8 L16,8 16,16 8,16Z" />
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
    </Window.Resources>

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- ============================================ header -->
        <Border Grid.Row="0" Padding="14,10" Background="#22000000">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <TextBlock Text="BioShockHavok" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding InstallSummary}" Opacity="0.75" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" MaxWidth="620" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                    <CheckBox Content="Research mode" IsChecked="{Binding ResearchMode}"
                              ToolTip.Tip="Show export indices, classes and other format detail." />
                    <Button Content="Detect game" Command="{Binding DetectCommand}" />
                    <Button Content="Browse…" Command="{Binding BrowseCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================================ first run -->
        <Border Grid.Row="1" Padding="40" IsVisible="{Binding !HasInstall}">
            <StackPanel Spacing="16" MaxWidth="640" VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="BioShock Remastered" FontSize="24" FontWeight="Light" />
                <TextBlock Text="{Binding InstallSummary}" TextWrapping="Wrap" Opacity="0.8" />

                <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,8,0,0">
                    <TextBox Grid.Column="0" Text="{Binding GamePath}"
                             Watermark="…\steamapps\common\BioShock Remastered" />
                    <Button Grid.Column="1" Content="Use this" Margin="8,0,0,0"
                            Command="{Binding UseTypedPathCommand}" />
                    <Button Grid.Column="2" Content="Browse…" Margin="8,0,0,0" Command="{Binding BrowseCommand}" />
                </Grid>

                <Button Content="Detect installation" HorizontalAlignment="Left"
                        Command="{Binding DetectCommand}" />

                <ItemsControl ItemsSource="{Binding Checks}" Margin="0,8,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:CheckRow">
                            <Grid ColumnDefinitions="Auto,Auto,*" Margin="0,3">
                                <TextBlock Grid.Column="0" Text="{Binding Glyph}" Width="22" FontWeight="Bold" />
                                <TextBlock Grid.Column="1" Text="{Binding Name}" Width="170" />
                                <TextBlock Grid.Column="2" Text="{Binding Detail}" Opacity="0.75" TextWrapping="Wrap" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- ============================================ the three workspaces

             Animated and Static are one browser split by the distinction that actually changes how
             an asset is worked with — whether it carries a rig. A skinned mesh has a skeleton,
             animation sets, sockets and a transport; a static mesh's whole story is geometry and
             materials, and the two used to sit interleaved in one nine-category list.

             Each tab hosts its own AssetBrowserView, but both bind to the SAME MainViewModel, so
             the selection, the details panel and the preview are shared and cannot drift apart.
             The workspace is a filter over one catalogue, not two catalogues. -->
        <TabControl Grid.Row="1" Margin="6,0,6,0" IsVisible="{Binding HasInstall}"
                    SelectedIndex="{Binding SelectedTabIndex}">

        <TabItem Header="Animated">
            <views:AssetBrowserView />
        </TabItem>

        <TabItem Header="Static">
            <views:AssetBrowserView />
        </TabItem>

        <!-- ============================================ level extractor -->
        <TabItem Header="Level">
            <Grid ColumnDefinitions="320,4,*" Margin="0,8,0,0">

                <!-- the maps -->
                <DockPanel Grid.Column="0" Margin="4,0,0,0">
                    <TextBlock DockPanel.Dock="Top" Text="Maps" FontWeight="SemiBold" Margin="4,0,0,6" />
                    <TextBlock DockPanel.Dock="Top" Opacity="0.65" TextWrapping="Wrap" Margin="4,0,0,8"
                               Text="Every .bsm in the install, largest first. Which of them hold a level is decided by what is in them, not by their names." />
                    <ListBox ItemsSource="{Binding Levels}" SelectedItem="{Binding SelectedLevel}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="services:LevelEntry">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="{Binding Name}" />
                                    <TextBlock Grid.Column="1" Text="{Binding SizeDisplay}" Opacity="0.6" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>

                <GridSplitter Grid.Column="1" Background="Transparent" />

                <!-- ===== walk through it =====

                     Separate from selecting a map: preparing a level decodes every mesh, material
                     and texture it uses and takes about five seconds, so doing it on selection
                     would make browsing the list feel broken. -->
                <Grid Grid.Column="2" RowDefinitions="Auto,*,Auto" Margin="6,0,4,0"
                      IsVisible="{Binding HasLevelView}">

                    <Border Grid.Row="0" Background="#14FFFFFF" CornerRadius="4" Padding="10" Margin="0,0,0,6">
                        <StackPanel Orientation="Horizontal" Spacing="14">
                            <TextBlock Text="W A S D  ·  Q E up/down  ·  drag to look  ·  Shift to sprint"
                                       Opacity="0.75" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <TextBlock Text="Speed" Opacity="0.7" VerticalAlignment="Center" />
                                <Slider Width="110" Minimum="0.2" Maximum="8" Value="{Binding LevelCameraSpeed}"
                                        VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <TextBlock Text="Detail" Opacity="0.7" VerticalAlignment="Center"
                                           ToolTip.Tip="How many triangles a frame may draw. Higher looks better and costs more." />
                                <Slider Width="110" Minimum="25000" Maximum="600000"
                                        Value="{Binding LevelTriangleBudget}" VerticalAlignment="Center" />
                            </StackPanel>
                            <Button Content="Close view" Command="{Binding CloseLevelViewCommand}" />
                        </StackPanel>
                    </Border>

                    <!-- Focusable so the movement keys reach it, and the pointer events drive the
                         look. The image is stretched to fill: while the camera moves it is rendered
                         at half size, so the surface and the bitmap are deliberately not the same
                         resolution. -->
                    <Border Grid.Row="1" Name="LevelSurface" Background="#FF202020"
                            Focusable="True" ClipToBounds="True" CornerRadius="4">
                        <Image Source="{Binding LevelImage}" Stretch="Fill" />
                    </Border>

                    <TextBlock Grid.Row="2" Text="{Binding LevelViewStatus}" Opacity="0.75"
                               Margin="2,6,0,0" TextWrapping="Wrap" />
                </Grid>

                <!-- what it holds, and getting it out -->
                <ScrollViewer Grid.Column="2" Margin="6,0,4,0" IsVisible="{Binding !HasLevelView}">
                    <StackPanel Spacing="12">

                        <TextBlock Text="{Binding LevelStatus}" TextWrapping="Wrap" Opacity="0.85" />

                        <ProgressBar IsIndeterminate="True" Height="3" IsVisible="{Binding IsLevelBusy}" />

                        <!-- ObjectConverters.IsNull, not "!SelectedLevel": the ! operator does not
                             negate a non-boolean binding, so the empty-state text rendered on top
                             of a fully-loaded level. Found by looking at the tab, not by a test. -->
                        <TextBlock Opacity="0.6" TextWrapping="Wrap"
                                   IsVisible="{Binding SelectedLevel, Converter={x:Static ObjectConverters.IsNull}}"
                                   Text="A level is its placed actors: static meshes, BSP brushes and lights, each with where it sits in the world. Choose a map on the left." />

                        <!-- counts -->
                        <Border Background="#14FFFFFF" CornerRadius="4" Padding="12"
                                IsVisible="{Binding LevelSummary, Converter={x:Static ObjectConverters.IsNotNull}}">
                            <StackPanel Spacing="4" DataContext="{Binding LevelSummary}"
                                        x:DataType="services:LevelSummary">
                                <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,6" />

                                <Grid ColumnDefinitions="150,*"><TextBlock Grid.Column="0" Text="Actors" Opacity="0.7" /><TextBlock Grid.Column="1" Text="{Binding Actors, StringFormat=\{0:N0\}}" /></Grid>
                                <Grid ColumnDefinitions="150,*"><TextBlock Grid.Column="0" Text="Placed objects" Opacity="0.7" /><TextBlock Grid.Column="1" Text="{Binding Instances, StringFormat=\{0:N0\}}" /></Grid>
                                <Grid ColumnDefinitions="150,*"><TextBlock Grid.Column="0" Text="…static meshes" Opacity="0.7" /><TextBlock Grid.Column="1" Text="{Binding Meshes, StringFormat=\{0:N0\}}" /></Grid>
                                <Grid ColumnDefinitions="150,*"><TextBlock Grid.Column="0" Text="…BSP brushes" Opacity="0.7" /><TextBlock Grid.Column="1" Text="{Binding Brushes, StringFormat=\{0:N0\}}" /></Grid>
                                <Grid ColumnDefinitions="150,*"><TextBlock Grid.Column="0" Text="Lights" Opacity="0.7" /><TextBlock Grid.Column="1" Text="{Binding Lights, StringFormat=\{0:N0\}}" /></Grid>
                                <Grid ColumnDefinitions="150,*"><TextBlock Grid.Column="0" Text="Triangles" Opacity="0.7" /><TextBlock Grid.Column="1" Text="{Binding Triangles, StringFormat=\{0:N0\}}" /></Grid>
                                <Grid ColumnDefinitions="150,*"><TextBlock Grid.Column="0" Text="Extent" Opacity="0.7" /><TextBlock Grid.Column="1" Text="{Binding Bounds}" FontSize="11" TextWrapping="Wrap" /></Grid>

                                <!-- Stated even when zero. "Nothing was skipped" and "nothing ran"
                                     render identically otherwise, which is the mistake the Problems
                                     panel already had to correct once. -->
                                <Grid ColumnDefinitions="150,*" Margin="0,4,0,0">
                                    <TextBlock Grid.Column="0" Text="Skipped" Opacity="0.7" />
                                    <TextBlock Grid.Column="1" Text="{Binding Skipped, StringFormat=\{0:N0\} actors whose geometry did not decode}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- what else is in the map -->
                        <Expander Header="Actors with no geometry" IsVisible="{Binding LevelComposition.Count}">
                            <StackPanel Spacing="2" Margin="0,6,0,0">
                                <TextBlock Opacity="0.65" TextWrapping="Wrap" Margin="0,0,0,6"
                                           Text="Not a fault: a level is mostly triggers, volumes, sounds, spawn points and script. This is what the map holds besides things that draw." />
                                <ItemsControl ItemsSource="{Binding LevelComposition}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:LevelClassRow">
                                            <TextBlock Text="{Binding Display}" Opacity="0.85" Margin="0,1" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Expander>

                        <!-- extraction -->
                        <Border Background="#14FFFFFF" CornerRadius="4" Padding="12"
                                IsVisible="{Binding SelectedLevel, Converter={x:Static ObjectConverters.IsNotNull}}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Extract" FontWeight="SemiBold" />

                                <CheckBox Content="Scene JSON — every object, its place in the world, its materials and the lights"
                                          IsChecked="{Binding LevelExportSceneJson}" />
                                <CheckBox Content="Wavefront OBJ — geometry only, opens in anything"
                                          IsChecked="{Binding LevelExportObj}" />
                                <CheckBox Content="Indent the JSON (much larger; for reading by eye)"
                                          IsChecked="{Binding LevelReadableJson}" Margin="18,0,0,0" />

                                <TextBlock Text="{Binding LevelSizeWarning}" Opacity="0.8" TextWrapping="Wrap"
                                           IsVisible="{Binding LevelSizeWarning, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="Extract this level…"
                                            Command="{Binding ExtractLevelCommand}"
                                            IsEnabled="{Binding CanExtractLevel}" />
                                    <Button Content="Walk through it…"
                                            Command="{Binding OpenLevelViewCommand}"
                                            IsEnabled="{Binding !IsLevelViewLoading}"
                                            ToolTip.Tip="Loads the level's geometry and textures — about five seconds — and lets you fly through it." />
                                </StackPanel>

                                <ProgressBar IsIndeterminate="True" Height="3"
                                             IsVisible="{Binding IsLevelViewLoading}" />
                                <TextBlock Text="{Binding LevelViewStatus}" Opacity="0.8" TextWrapping="Wrap"
                                           IsVisible="{Binding IsLevelViewLoading}" />

                                <ItemsControl ItemsSource="{Binding LevelOutputs}" Margin="0,4,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <TextBlock Text="{Binding}" Opacity="0.85" Margin="0,1" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </TabItem>

        </TabControl>

        <!-- ============================================ extraction

             The ASSET extraction bar, and it is hidden on the Level tab. Rendering the tab showed
             it sitting under the level panel with its own "Extract selected" / "Extract all shown"
             buttons, which reads as though those buttons extract the level — they do not, and the
             level has its own. A control that is merely irrelevant still makes a claim. -->
        <Border Grid.Row="2" Padding="14,10" Background="#22000000" IsVisible="{Binding IsAssetsTab}">
            <StackPanel Spacing="8">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                    <TextBlock Grid.Column="0" Text="Export to" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBox Grid.Column="1" Text="{Binding OutputDirectory}" />
                    <Button Grid.Column="2" Content="Change…" Margin="8,0,0,0" Command="{Binding ChooseOutputCommand}" />
                    <Button Grid.Column="3" Content="Open" Margin="8,0,0,0" Command="{Binding OpenOutputCommand}" />
                </Grid>

                <Grid ColumnDefinitions="*,Auto">
                    <WrapPanel Grid.Column="0" Orientation="Horizontal">
                        <CheckBox Content="Scene JSON (Blender)" IsChecked="{Binding ExportSceneJson}" Margin="0,0,12,0" />
                        <CheckBox Content="FBX" IsChecked="{Binding ExportFbx}" Margin="0,0,12,0" />
                        <CheckBox Content="PNG" IsChecked="{Binding ExportPng}" Margin="0,0,12,0" />
                        <CheckBox Content="DDS" IsChecked="{Binding ExportDds}" Margin="0,0,20,0" />
                        <CheckBox Content="Keep package folders" IsChecked="{Binding PreservePackageStructure}"
                                  Margin="0,0,12,0" />
                        <CheckBox Content="Skip existing" IsChecked="{Binding SkipExisting}" />
                    </WrapPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <Button Content="Extract selected" Command="{Binding ExtractSelectedCommand}"
                                IsEnabled="{Binding !IsBusy}" />
                        <Button Content="Extract all shown" Command="{Binding ExtractShownCommand}"
                                IsEnabled="{Binding !IsBusy}" />
                        <Button Content="Cancel" Command="{Binding CancelCommand}" IsEnabled="{Binding IsBusy}" />
                    </StackPanel>
                </Grid>

                <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding IsBusy}">
                    <ProgressBar Grid.Column="0" Value="{Binding Progress}" Maximum="100" Height="6"
                                 VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Margin="12,0,0,0" Text="{Binding ProgressText}" FontSize="12" />
                </Grid>

                <TextBlock Text="{Binding Status}" Opacity="0.8" TextWrapping="Wrap" />

                <!-- ==================================== problems

                     Everything this tool knows is wrong, from one service in Core. Every fault found
                     in the two sessions before this panel existed was found by a human looking at
                     the viewport, while the evidence sat unread in the tool.

                     It opens itself once a check has run: a user who asked for the check should not
                     then have to find where the answer went. -->
                <Expander MaxHeight="230" IsExpanded="{Binding HasScanned, Mode=OneWay}">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="Problems" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Problems.Count, StringFormat='{}{0:N0} found'}"
                                       Opacity="0.6" VerticalAlignment="Center"
                                       IsVisible="{Binding HasScanned}" />
                        </StackPanel>
                    </Expander.Header>

                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                            <Button Content="Check this package" Command="{Binding ScanPackageCommand}"
                                    IsEnabled="{Binding !IsScanning}"
                                    ToolTip.Tip="Check every mesh, material and texture in the package the browser is filtered to." />
                            <Button Content="Check everything" Command="{Binding ScanEverythingCommand}"
                                    IsEnabled="{Binding !IsScanning}"
                                    ToolTip.Tip="The whole install. Minutes, not seconds." />
                            <Button Content="Stop" Command="{Binding CancelScanCommand}"
                                    IsEnabled="{Binding IsScanning}" />
                            <Button Content="Copy diagnostic" Command="{Binding CopyProblemCommand}"
                                    ToolTip.Tip="The selected problem with its asset, package and evidence." />
                            <Button Content="Copy all" Command="{Binding CopyAllProblemsCommand}" />
                            <TextBlock Text="{Binding ProblemsSummary}" Opacity="0.75"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                       IsVisible="{Binding !IsScanning}" />
                            <!-- A multi-minute check with no sign of life reads as a hang. -->
                            <TextBlock Text="{Binding ProgressText}" Opacity="0.75"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                       IsVisible="{Binding IsScanning}" />
                        </StackPanel>

                        <!-- Empty and unscanned must not look the same: a blank Problems panel reads
                             as a clean bill of health, and this project has been wrong that way
                             before. -->
                        <TextBlock DockPanel.Dock="Top" Opacity="0.6" TextWrapping="Wrap"
                                   IsVisible="{Binding !HasScanned}"
                                   Text="Nothing has been checked yet. Nothing here means nothing has run, not that nothing is wrong." />

                        <DataGrid ItemsSource="{Binding Problems}" SelectedItem="{Binding SelectedProblem}"
                                  IsReadOnly="True" GridLinesVisibility="Horizontal"
                                  CanUserSortColumns="True" IsVisible="{Binding Problems.Count}">
                            <DataGrid.Columns>
                                <!-- Wide enough for its own header: rendering this at 76 cut it to
                                     "Severi", which is the column-squeezed-to-nothing fault this
                                     project has shipped before. -->
                                <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="90" />
                                <DataGridTextColumn Header="Asset" Binding="{Binding Asset}" Width="170" MinWidth="120" />
                                <DataGridTextColumn Header="Package" Binding="{Binding Package}" Width="104" />
                                <DataGridTextColumn Header="Problem" Binding="{Binding Code}" Width="172" />
                                <!-- The evidence gets whatever is left, and the fixed columns above
                                     are kept narrow to leave it something. Rendering this the first
                                     time showed the evidence clipped at the window edge, which is
                                     the one column a user cannot do without: a code alone says
                                     nothing, "20 of 20 triangles; slot 0 names nothing" says where
                                     to look. -->
                                <DataGridTextColumn Header="Evidence" Binding="{Binding Evidence}" Width="*" MinWidth="220" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Expander>

                <Expander Header="Extraction failures" IsVisible="{Binding Failures.Count}" MaxHeight="150">
                    <ScrollViewer>
                        <ItemsControl ItemsSource="{Binding Failures}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:FailureRow">
                                    <Grid ColumnDefinitions="200,110,*" Margin="0,2">
                                        <TextBlock Grid.Column="0" Text="{Binding Name}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Package}" Opacity="0.6" />
                                        <TextBlock Grid.Column="2" Text="{Binding Reason}" Opacity="0.85"
                                                   TextWrapping="Wrap" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Expander>
            </StackPanel>
        </Border>
    </Grid>
</Window>
