<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:BioShockStudio.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="820"
        x:Class="BioShockStudio.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Width="1280" Height="820" MinWidth="960" MinHeight="600"
        Title="BioShockHavok">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Window.Resources>
        <!-- Transparency is shown against a checkerboard so an alpha channel is visible as one. -->
        <DrawingBrush x:Key="Checkerboard" TileMode="Tile"
                      SourceRect="0,0,16,16" DestinationRect="0,0,16,16">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#FF6E6E6E" Geometry="M0,0 L16,0 16,16 0,16Z" />
                    <GeometryDrawing Brush="#FF9A9A9A" Geometry="M0,0 L8,0 8,8 0,8Z M8,8 L16,8 16,16 8,16Z" />
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
    </Window.Resources>

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- ============================================ header -->
        <Border Grid.Row="0" Padding="14,10" Background="#22000000">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <TextBlock Text="BioShockHavok" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding InstallSummary}" Opacity="0.75" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" MaxWidth="620" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                    <CheckBox Content="Research mode" IsChecked="{Binding ResearchMode}"
                              ToolTip.Tip="Show export indices, classes and other format detail." />
                    <Button Content="Detect game" Command="{Binding DetectCommand}" />
                    <Button Content="Browse…" Command="{Binding BrowseCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================================ first run -->
        <Border Grid.Row="1" Padding="40" IsVisible="{Binding !HasInstall}">
            <StackPanel Spacing="16" MaxWidth="640" VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="BioShock Remastered" FontSize="24" FontWeight="Light" />
                <TextBlock Text="{Binding InstallSummary}" TextWrapping="Wrap" Opacity="0.8" />

                <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,8,0,0">
                    <TextBox Grid.Column="0" Text="{Binding GamePath}"
                             Watermark="…\steamapps\common\BioShock Remastered" />
                    <Button Grid.Column="1" Content="Use this" Margin="8,0,0,0"
                            Command="{Binding UseTypedPathCommand}" />
                    <Button Grid.Column="2" Content="Browse…" Margin="8,0,0,0" Command="{Binding BrowseCommand}" />
                </Grid>

                <Button Content="Detect installation" HorizontalAlignment="Left"
                        Command="{Binding DetectCommand}" />

                <ItemsControl ItemsSource="{Binding Checks}" Margin="0,8,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:CheckRow">
                            <Grid ColumnDefinitions="Auto,Auto,*" Margin="0,3">
                                <TextBlock Grid.Column="0" Text="{Binding Glyph}" Width="22" FontWeight="Bold" />
                                <TextBlock Grid.Column="1" Text="{Binding Name}" Width="170" />
                                <TextBlock Grid.Column="2" Text="{Binding Detail}" Opacity="0.75" TextWrapping="Wrap" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- ============================================ browser -->
        <Grid Grid.Row="1" ColumnDefinitions="220,4,*,4,470" IsVisible="{Binding HasInstall}">

            <!-- categories -->
            <DockPanel Grid.Column="0" Margin="10">
                <TextBlock DockPanel.Dock="Top" Text="Browse" FontWeight="SemiBold" Margin="4,0,0,8" />
                <ComboBox DockPanel.Dock="Bottom" Margin="0,8,0,0" HorizontalAlignment="Stretch"
                          ItemsSource="{Binding Packages}" SelectedItem="{Binding SelectedPackage}" />
                <ListBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:CategoryRow">
                            <TextBlock Text="{Binding Display}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <GridSplitter Grid.Column="1" Background="Transparent" />

            <!-- asset list -->
            <DockPanel Grid.Column="2" Margin="0,10,0,10">
                <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                    <TextBox Grid.Column="0" Name="SearchBox" Text="{Binding Search}"
                             Watermark="Search (Ctrl+F) — try Pistol, BigDaddy, Hand_DIFF, FastReload" />
                    <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="10,0,4,0" Opacity="0.7"
                               Text="{Binding ResultSummary}" />
                </Grid>

                <DataGrid ItemsSource="{Binding Assets}" SelectedItem="{Binding SelectedAsset}"
                          IsReadOnly="True" GridLinesVisibility="Horizontal" CanUserSortColumns="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="190" />
                        <DataGridTextColumn Header="Kind" Binding="{Binding Category}" Width="95" />
                        <!-- Details carries what the asset actually is — a texture's format and size,
                             a shader's type and how many maps it binds — so it gets the room. The
                             group and the Unreal class are in the details panel; repeating them here
                             squeezed this column to nothing. -->
                        <DataGridTextColumn Header="Details" Binding="{Binding Detail}" Width="*" MinWidth="150" />
                        <DataGridTextColumn Header="Package" Binding="{Binding Package}" Width="100" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>

            <GridSplitter Grid.Column="3" Background="Transparent" />

            <!-- details -->
            <Border Grid.Column="4" Margin="0,10,10,10" Padding="14" CornerRadius="6" Background="#18FFFFFF">
                <ScrollViewer>
                    <StackPanel Spacing="10">
                        <TextBlock Text="Select an asset to see its skeleton, animations, materials and textures."
                                   Opacity="0.6" TextWrapping="Wrap"
                                   IsVisible="{Binding DetailsTitle, Converter={x:Static StringConverters.IsNullOrEmpty}}" />
                        <TextBlock Text="{Binding DetailsTitle}" FontSize="18" FontWeight="SemiBold"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding DetailsSubtitle}" Opacity="0.7" />

                        <Border Background="#33B86B6B" CornerRadius="4" Padding="10"
                                IsVisible="{Binding DetailsProblem, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <TextBlock Text="{Binding DetailsProblem}" TextWrapping="Wrap" />
                        </Border>


                        <!-- 3D preview -->
                        <StackPanel Spacing="6" IsVisible="{Binding HasViewport}">
                            <Border Name="ViewportHost" Background="#FF202020" CornerRadius="4"
                                    Height="300" ClipToBounds="True" Cursor="Hand"
                                    ToolTip.Tip="Drag to orbit · Shift-drag or middle-drag to pan · Wheel to zoom · Space plays">
                                <Panel>
                                    <Image Source="{Binding Viewport}" Stretch="Uniform" />
                                    <!-- A blank panel while a heavy mesh loads reads as a failure. -->
                                    <TextBlock Text="Loading…" Foreground="#FFBBBBBB" FontSize="13"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               IsVisible="{Binding IsPreviewLoading}" />
                                </Panel>
                            </Border>

                            <WrapPanel>
                                <CheckBox Content="Textured" IsChecked="{Binding ShowTextures}" Margin="0,0,10,0" />
                                <CheckBox Content="Normal + spec" IsChecked="{Binding ShowShading}" Margin="0,0,10,0"
                                          ToolTip.Tip="Apply the material's normal and specular maps, not just its base colour." />
                                <CheckBox Content="Wireframe" IsChecked="{Binding ShowWireframe}" Margin="0,0,10,0" />
                                <CheckBox Content="Skeleton" IsChecked="{Binding ShowSkeleton}" Margin="0,0,10,0" />
                                <CheckBox Content="Sockets" IsChecked="{Binding ShowSockets}" Margin="0,0,10,0" />
                                <Button Content="−" Command="{Binding ZoomOutCommand}" Padding="10,2"
                                        ToolTip.Tip="Zoom out" />
                                <Button Content="+" Command="{Binding ZoomInCommand}" Padding="10,2" Margin="4,0"
                                        ToolTip.Tip="Zoom in" />
                                <Button Content="Reset view" Command="{Binding ResetCameraCommand}" Padding="8,2" />
                            </WrapPanel>

                            <!-- a group is often several meshes on one skeleton -->
                            <ComboBox ItemsSource="{Binding PreviewMeshes}"
                                      SelectedItem="{Binding SelectedPreviewMesh}"
                                      HorizontalAlignment="Stretch"
                                      IsVisible="{Binding HasMeshVariants}"
                                      ToolTip.Tip="This asset has more than one mesh on the same skeleton." />

                            <!-- attachments: what hangs off this asset's sockets -->
                            <StackPanel Spacing="4" IsVisible="{Binding HasAttachments}">
                                <ComboBox ItemsSource="{Binding Attachments}"
                                          SelectedItem="{Binding SelectedAttachment}"
                                          HorizontalAlignment="Stretch"
                                          PlaceholderText="Attach a weapon to a socket" />
                                <TextBlock Text="{Binding AttachmentEvidence}" Opacity="0.65" FontSize="11"
                                           TextWrapping="Wrap"
                                           IsVisible="{Binding AttachmentEvidence, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                            </StackPanel>

                            <!-- animation transport -->
                            <StackPanel Spacing="6" IsVisible="{Binding PreviewAnimations.Count}">
                                <ComboBox ItemsSource="{Binding AnimationSets}"
                                          SelectedItem="{Binding SelectedAnimationSet}"
                                          HorizontalAlignment="Stretch"
                                          IsVisible="{Binding HasAnimationSets}"
                                          ToolTip.Tip="Animation sets, as the game groups them" />

                                <TextBlock Text="{Binding AnimationSetSummary}"
                                           Opacity="0.7" FontSize="11"
                                           IsVisible="{Binding HasAnimationSets}" />

                                <ComboBox ItemsSource="{Binding PreviewAnimations}"
                                          SelectedItem="{Binding SelectedAnimation}"
                                          HorizontalAlignment="Stretch"
                                          PlaceholderText="Choose an animation to play" />

                                <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto"
                                      IsVisible="{Binding SelectedAnimation, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                    <Button Grid.Column="0" Content="⏮" Command="{Binding PreviousFrameCommand}"
                                            Padding="8,2" ToolTip.Tip="Previous frame" />
                                    <Button Grid.Column="1" Content="▶" Command="{Binding TogglePlayCommand}"
                                            Padding="8,2" Margin="4,0" ToolTip.Tip="Play or pause" />
                                    <Button Grid.Column="2" Content="⏭" Command="{Binding NextFrameCommand}"
                                            Padding="8,2" ToolTip.Tip="Next frame" />
                                    <Slider Grid.Column="3" Margin="10,0" Minimum="0" Maximum="{Binding LastFrame}"
                                            Value="{Binding Frame}" VerticalAlignment="Center" />
                                    <ComboBox Grid.Column="4" ItemsSource="{Binding PlaybackSpeeds}"
                                              SelectedItem="{Binding PlaybackSpeed}" MinWidth="76" />
                                </Grid>

                                <TextBlock Opacity="0.7" FontSize="12"
                                           IsVisible="{Binding AnimationSummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                    <Run Text="Frame" />
                                    <Run Text="{Binding Frame}" />
                                    <Run Text="·" />
                                    <Run Text="{Binding AnimationSummary}" />
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>

                        <Border Background="#33B86B6B" CornerRadius="4" Padding="10"
                                IsVisible="{Binding ViewportProblem, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <TextBlock Text="{Binding ViewportProblem}" TextWrapping="Wrap" FontSize="12" />
                        </Border>

                        <!-- texture preview -->
                        <StackPanel Spacing="6" IsVisible="{Binding TexturePreview, Converter={x:Static ObjectConverters.IsNotNull}}">
                            <Border Background="{StaticResource Checkerboard}" CornerRadius="4"
                                    Padding="0" MaxHeight="340">
                                <Image Source="{Binding TexturePreview}" Stretch="Uniform"
                                       RenderOptions.BitmapInterpolationMode="HighQuality" />
                            </Border>
                            <TextBlock Text="{Binding TexturePreviewCaption}" Opacity="0.7" FontSize="12"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <ItemsControl ItemsSource="{Binding DetailFields}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="130,*" Margin="0,3">
                                        <TextBlock Grid.Column="0" Text="{Binding Label}" Opacity="0.7" />
                                        <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <ItemsControl ItemsSource="{Binding DetailSections}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Expander Header="{Binding Title}" Margin="0,6,0,0" IsExpanded="False">
                                        <ItemsControl ItemsSource="{Binding Items}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock Text="{Binding Name}" />
                                                            <TextBlock Text="{Binding Detail}" Opacity="0.6" FontSize="11" />
                                                        </StackPanel>
                                                        <!-- How the link was established, never left implied. -->
                                                        <TextBlock Grid.Column="1" Text="{Binding Confidence}"
                                                                   Opacity="0.5" FontSize="10" VerticalAlignment="Center" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Expander>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Expander Header="Format detail" IsVisible="{Binding ResearchMode}" Margin="0,6,0,0">
                            <ItemsControl ItemsSource="{Binding ResearchFields}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="150,*" Margin="0,2">
                                            <TextBlock Grid.Column="0" Text="{Binding Label}" Opacity="0.7" FontSize="12" />
                                            <TextBlock Grid.Column="1" Text="{Binding Value}" FontFamily="Consolas"
                                                       FontSize="12" TextWrapping="Wrap" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ============================================ extraction -->
        <Border Grid.Row="2" Padding="14,10" Background="#22000000" IsVisible="{Binding HasInstall}">
            <StackPanel Spacing="8">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                    <TextBlock Grid.Column="0" Text="Export to" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBox Grid.Column="1" Text="{Binding OutputDirectory}" />
                    <Button Grid.Column="2" Content="Change…" Margin="8,0,0,0" Command="{Binding ChooseOutputCommand}" />
                    <Button Grid.Column="3" Content="Open" Margin="8,0,0,0" Command="{Binding OpenOutputCommand}" />
                </Grid>

                <Grid ColumnDefinitions="*,Auto">
                    <WrapPanel Grid.Column="0" Orientation="Horizontal">
                        <CheckBox Content="Scene JSON (Blender)" IsChecked="{Binding ExportSceneJson}" Margin="0,0,12,0" />
                        <CheckBox Content="FBX" IsChecked="{Binding ExportFbx}" Margin="0,0,12,0" />
                        <CheckBox Content="PNG" IsChecked="{Binding ExportPng}" Margin="0,0,12,0" />
                        <CheckBox Content="DDS" IsChecked="{Binding ExportDds}" Margin="0,0,20,0" />
                        <CheckBox Content="Keep package folders" IsChecked="{Binding PreservePackageStructure}"
                                  Margin="0,0,12,0" />
                        <CheckBox Content="Skip existing" IsChecked="{Binding SkipExisting}" />
                    </WrapPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <Button Content="Extract selected" Command="{Binding ExtractSelectedCommand}"
                                IsEnabled="{Binding !IsBusy}" />
                        <Button Content="Extract all shown" Command="{Binding ExtractShownCommand}"
                                IsEnabled="{Binding !IsBusy}" />
                        <Button Content="Cancel" Command="{Binding CancelCommand}" IsEnabled="{Binding IsBusy}" />
                    </StackPanel>
                </Grid>

                <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding IsBusy}">
                    <ProgressBar Grid.Column="0" Value="{Binding Progress}" Maximum="100" Height="6"
                                 VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Margin="12,0,0,0" Text="{Binding ProgressText}" FontSize="12" />
                </Grid>

                <TextBlock Text="{Binding Status}" Opacity="0.8" TextWrapping="Wrap" />

                <Expander Header="Problems" IsVisible="{Binding Failures.Count}" MaxHeight="150">
                    <ScrollViewer>
                        <ItemsControl ItemsSource="{Binding Failures}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:FailureRow">
                                    <Grid ColumnDefinitions="200,110,*" Margin="0,2">
                                        <TextBlock Grid.Column="0" Text="{Binding Name}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Package}" Opacity="0.6" />
                                        <TextBlock Grid.Column="2" Text="{Binding Reason}" Opacity="0.85"
                                                   TextWrapping="Wrap" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Expander>
            </StackPanel>
        </Border>
    </Grid>
</Window>
